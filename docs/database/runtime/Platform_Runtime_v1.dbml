Project Platform_Runtime_v1 {
  database_type: 'PostgreSQL'
  Note: 'Migration 016. Local installation identity and signed entitlement snapshots. Separate from core.* (24 tables) and from the Commercial database.'
}

Enum platform_runtime_deployment_mode {
  shared
  dedicated
  on_prem
}

Enum platform_runtime_environment {
  development
  test
  staging
  production
}

Enum platform_runtime_release_channel {
  stable
  beta
  canary
}

Enum platform_runtime_installation_status {
  provisioned
  active
  suspended
  decommissioned
}

Enum platform_runtime_entitlement_status {
  pending
  applied
  rejected
}

Table platform_runtime.installations {
  id uuid [pk, not null, default: `uuidv7()`]
  singleton_key smallint [not null, unique, default: 1, note: 'CHECK = 1: at most one installation identity per database. Trigger prevents delete or identity update.']
  deployment_mode platform_runtime_deployment_mode [not null]
  environment platform_runtime_environment [not null]
  application_version varchar(120) [not null, note: 'Nonblank; no control characters']
  release_id varchar(160) [not null, note: 'Nonblank; no control characters']
  release_channel platform_runtime_release_channel [not null]
  status platform_runtime_installation_status [not null, default: 'provisioned', note: 'Active requires activated_at']
  current_entitlement_sequence bigint [not null, default: 0, note: 'Nonnegative high water mark; cannot decrease. Applying a signed document advances it under a row lock.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  activated_at timestamptz
}

Table platform_runtime.entitlement_documents {
  id uuid [pk, not null, default: `uuidv7()`]
  installation_id uuid [not null, ref: > platform_runtime.installations.id, note: 'ON DELETE RESTRICT']
  document_version integer [not null, note: 'Positive signed document format version']
  sequence bigint [not null, note: 'Positive; unique per installation']
  issued_at timestamptz [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz [note: 'NULL or later than valid_from']
  payload jsonb [not null, note: 'JSON object with canonicalDocumentBase64, preserving the exact verified v1 bytes']
  signature bytea [not null, note: 'Exactly 64 Ed25519 signature bytes; private key is external']
  signing_key_id varchar(160) [not null, note: 'Canonical lowercase machine identifier']
  status platform_runtime_entitlement_status [not null, default: 'pending', note: 'New snapshots must be pending; only pending may transition to applied/rejected']
  applied_at timestamptz [note: 'Present exactly when status = applied']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (installation_id, sequence) [unique, name: 'uq_entitlement_documents_installation_sequence']
    (installation_id, status, sequence) [name: 'idx_entitlement_documents_status_sequence', note: 'sequence DESC']
    valid_until [name: 'idx_entitlement_documents_valid_until', note: 'Partial: valid_until IS NOT NULL']
  }

  Note: 'Signed fields are immutable. Phase 4.6 verifies trusted Ed25519 keys, installation, format and validity before pending-to-applied transition. The trigger serializes application and advances current_entitlement_sequence; exact replay is idempotent.'
}
