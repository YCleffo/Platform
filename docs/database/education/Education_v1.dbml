  Note: 'lesson_results_comment_check: CHECK (comment IS NULL OR length(comment) >= 1 AND length(comment) <= 1000)\nlesson_results_id_not_null: NOT NULL id\nlesson_results_lesson_id_not_null: NOT NULL lesson_id\nlesson_results_lesson_id_organization_id_owner_account_id_fkey: FOREIGN KEY (lesson_id, organization_id, owner_account_id) REFERENCES education.lessons(id, organization_id, owner_account_id)\nlesson_results_lesson_id_student_id_key: UNIQUE (lesson_id, student_id)\nlesson_results_organization_id_not_null: NOT NULL organization_id\nlesson_results_owner_account_id_not_null: NOT NULL owner_account_id\nlesson_results_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'mastered\'::character varying, \'developing\'::character varying, \'needs_support\'::character varying]::text[]))\nlesson_results_status_not_null: NOT NULL status\nlesson_results_student_id_not_null: NOT NULL student_id\nlesson_results_student_id_organization_id_owner_account_id_fkey: FOREIGN KEY (student_id, organization_id, owner_account_id) REFERENCES education.students(id, organization_id, owner_account_id)\nlesson_results_updated_at_not_null: NOT NULL updated_at\nCREATE UNIQUE INDEX lesson_results_lesson_id_student_id_key ON education.lesson_results USING btree (lesson_id, student_id)\nCREATE INDEX lesson_results_student ON education.lesson_results USING btree (student_id, lesson_id)'
}

Table education.lessons {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  owner_person_id uuid [not null]
  group_id uuid [not null]
  title "character varying(160)" [not null]
  starts_at "timestamp with time zone" [not null]
  ends_at "timestamp with time zone" [not null]
  location "character varying(240)" [not null, default: `''::character varying`]
  status "character varying(20)" [not null, default: `'scheduled'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  completed_at "timestamp with time zone" [null]
  cancelled_at "timestamp with time zone" [null]
  group_program_id uuid [null]
  curriculum_lesson_id uuid [null]
  curriculum_snapshot jsonb [null]
  indexes {
    (group_program_id, curriculum_lesson_id, status) [name: 'lessons_curriculum', type: btree]
    (group_id, status, starts_at, id) [name: 'lessons_group_status_time', type: btree]
    (id, organization_id) [name: 'lessons_homework_tenant', type: btree, unique]
    (id, organization_id, owner_account_id) [name: 'lessons_id_organization_id_owner_account_id_key', type: btree, unique]
    (organization_id, owner_account_id, starts_at, id) [name: 'lessons_owner_time', type: btree]
  }
  Note: 'lesson_curriculum_binding: CHECK (group_program_id IS NULL AND curriculum_lesson_id IS NULL AND curriculum_snapshot IS NULL OR group_program_id IS NOT NULL AND curriculum_lesson_id IS NOT NULL AND curriculum_snapshot IS NOT NULL)\nlesson_curriculum_lesson_fk: FOREIGN KEY (curriculum_lesson_id, organization_id) REFERENCES education.curriculum_lessons(id, organization_id)\nlesson_group_program_fk: FOREIGN KEY (group_program_id, organization_id) REFERENCES education.group_programs(id, organization_id)\nlessons_check: CHECK (ends_at > starts_at AND ends_at <= (starts_at + \'24:00:00\'::interval))\nlessons_created_at_not_null: NOT NULL created_at\nlessons_ends_at_not_null: NOT NULL ends_at\nlessons_group_id_not_null: NOT NULL group_id\nlessons_group_id_organization_id_owner_account_id_fkey: FOREIGN KEY (group_id, organization_id, owner_account_id) REFERENCES education.groups(id, organization_id, owner_account_id)\nlessons_homework_tenant: UNIQUE (id, organization_id)\nlessons_id_not_null: NOT NULL id\nlessons_id_organization_id_owner_account_id_key: UNIQUE (id, organization_id, owner_account_id)\nlessons_location_not_null: NOT NULL location\nlessons_organization_id_not_null: NOT NULL organization_id\nlessons_owner_account_id_not_null: NOT NULL owner_account_id\nlessons_owner_person_id_not_null: NOT NULL owner_person_id\nlessons_starts_at_not_null: NOT NULL starts_at\nlessons_status_check: CHECK (status::text = ANY (ARRAY[\'scheduled\'::character varying, \'completed\'::character varying, \'cancelled\'::character varying]::text[]))\nlessons_status_not_null: NOT NULL status\nlessons_title_check: CHECK (btrim(title::text) <> \'\'::text)\nlessons_title_not_null: NOT NULL title\nCREATE INDEX lessons_curriculum ON education.lessons USING btree (group_program_id, curriculum_lesson_id, status)\nCREATE INDEX lessons_group_status_time ON education.lessons USING btree (group_id, status, starts_at, id)\nCREATE UNIQUE INDEX lessons_homework_tenant ON education.lessons USING btree (id, organization_id)\nCREATE UNIQUE INDEX lessons_id_organization_id_owner_account_id_key ON education.lessons USING btree (id, organization_id, owner_account_id)\nCREATE INDEX lessons_owner_time ON education.lessons USING btree (organization_id, owner_account_id, starts_at, id)\nCREATE TRIGGER lesson_curriculum_binding_guard BEFORE INSERT OR UPDATE OF group_id, organization_id, group_program_id, curriculum_lesson_id ON education.lessons FOR EACH ROW EXECUTE FUNCTION education.check_lesson_curriculum_binding()'
}

Table education.logic_results {
  attempt_id uuid [pk, not null]
  organization_id uuid [not null]
  student_id uuid [not null]
  correct_answers integer [not null]
  total_rounds integer [not null]
  score integer [not null]
  accuracy numeric(5,2) [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (organization_id, student_id, created_at, attempt_id) [name: 'logic_results_student', type: btree]
  }
  Note: 'logic_results_accuracy_check: CHECK (accuracy >= 0::numeric AND accuracy <= 100::numeric)\nlogic_results_accuracy_not_null: NOT NULL accuracy\nlogic_results_attempt_id_fkey: FOREIGN KEY (attempt_id) REFERENCES education.activity_results(attempt_id)\nlogic_results_attempt_id_not_null: NOT NULL attempt_id\nlogic_results_check: CHECK (correct_answers <= total_rounds)\nlogic_results_correct_answers_check: CHECK (correct_answers >= 0)\nlogic_results_correct_answers_not_null: NOT NULL correct_answers\nlogic_results_created_at_not_null: NOT NULL created_at\nlogic_results_organization_id_not_null: NOT NULL organization_id\nlogic_results_score_check: CHECK (score >= 0 AND score <= 1000)\nlogic_results_score_not_null: NOT NULL score\nlogic_results_student_id_not_null: NOT NULL student_id\nlogic_results_total_rounds_check: CHECK (total_rounds = ANY (ARRAY[5, 10]))\nlogic_results_total_rounds_not_null: NOT NULL total_rounds\nCREATE INDEX logic_results_student ON education.logic_results USING btree (organization_id, student_id, created_at DESC, attempt_id)'
}

Table education.message_reactions {
  id uuid [pk, not null, default: `uuidv7()`]
