s_organization_id_not_null: NOT NULL organization_id\nhomework_assignments_status_check: CHECK (status::text = ANY (ARRAY[\'DRAFT\'::character varying, \'PUBLISHED\'::character varying, \'CLOSED\'::character varying, \'ARCHIVED\'::character varying]::text[]))\nhomework_assignments_status_not_null: NOT NULL status\nhomework_assignments_title_check: CHECK (btrim(title::text) <> \'\'::text)\nhomework_assignments_title_not_null: NOT NULL title\nhomework_assignments_type_check: CHECK (type::text = ANY (ARRAY[\'text\'::character varying, \'files\'::character varying, \'typing\'::character varying, \'activity\'::character varying]::text[]))\nhomework_assignments_type_not_null: NOT NULL type\nhomework_assignments_version_check: CHECK (version > 0)\nhomework_assignments_version_not_null: NOT NULL version\nCREATE INDEX homework_assignment_author ON education.homework_assignments USING btree (organization_id, author_account_id, created_at DESC, id)\nCREATE INDEX homework_assignment_lists ON education.homework_assignments USING btree (organization_id, status, due_at, id)\nCREATE UNIQUE INDEX homework_assignments_id_organization_id_key ON education.homework_assignments USING btree (id, organization_id)'
}

