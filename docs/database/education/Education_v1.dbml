  reply_to_id uuid [null]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  indexes {
    (thread_id, created_at, id) [name: 'messages_thread_time', type: btree]
  }
  Note: 'messages_body_or_media_check: CHECK (body IS NOT NULL AND length(body) >= 1 AND length(body) <= 5000 OR media_asset_id IS NOT NULL)\nmessages_created_at_not_null: NOT NULL created_at\nmessages_id_not_null: NOT NULL id\nmessages_kind_not_null: NOT NULL kind\nmessages_metadata_not_null: NOT NULL metadata\nmessages_organization_id_not_null: NOT NULL organization_id\nmessages_sender_person_id_not_null: NOT NULL sender_person_id\nmessages_thread_id_not_null: NOT NULL thread_id\nmessages_thread_id_organization_id_fkey: FOREIGN KEY (thread_id, organization_id) REFERENCES education.threads(id, organization_id)\nCREATE UNIQUE INDEX messages_idempotency ON education.messages USING btree (thread_id, sender_person_id, client_key) WHERE (client_key IS NOT NULL)\nCREATE INDEX messages_media_asset_idx ON education.messages USING btree (media_asset_id) WHERE (media_asset_id IS NOT NULL)\nCREATE INDEX messages_reply_to_idx ON education.messages USING btree (reply_to_id) WHERE (reply_to_id IS NOT NULL)\nCREATE INDEX messages_thread_time ON education.messages USING btree (thread_id, created_at, id)'
}

