Table education.notifications {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  person_id uuid [not null]
  thread_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  read_at "timestamp with time zone" [null]
  message_id uuid [null]
  kind "character varying(40)" [not null, default: `'message'::character varying`]
  resource_id uuid [null]
  resource_path "character varying(240)" [null]
  subject "character varying(160)" [null]
  body text [null]
  event_key "character varying(240)" [null]
  parent_student_id uuid [null]
  indexes {
    message_id [name: 'notifications_message', type: btree]
    (organization_id, person_id, created_at, id) [name: 'notifications_recipient', type: btree]
  }
  Note: 'education_notification_target: CHECK (kind::text = \'message\'::text AND thread_id IS NOT NULL AND parent_student_id IS NULL OR (kind::text = ANY (ARRAY[\'homework_published\'::character varying, \'homework_deadline_changed\'::character varying, \'homework_submitted\'::character varying, \'homework_returned\'::character varying, \'homework_reviewed\'::character varying, \'achievement_unlocked\'::character varying]::text[])) AND resource_id IS NOT NULL AND resource_path IS NOT NULL AND subject IS NOT NULL AND parent_student_id IS NULL OR (kind::text = ANY (ARRAY[\'parent_homework_published\'::character varying, \'parent_homework_reviewed\'::character varying, \'parent_homework_returned\'::character varying, \'parent_homework_deadline_changed\'::character varying, \'parent_schedule_changed\'::character varying, \'parent_family_confirmed\'::character varying, \'parent_family_revoked\'::character varying, \'parent_family_invited\'::character varying, \'parent_family_invitation_revoked\'::character varying, \'parent_family_relationship_changed\'::character varying, \'parent_family_added\'::character varying, \'parent_family_updated\'::character varying, \'parent_activity_finished\'::character varying, \'parent_achievement_unlocked\'::character varying]::text[])) AND parent_student_id IS NOT NULL AND resource_id IS NOT NULL AND resource_path IS NOT NULL AND subject IS NOT NULL AND thread_id IS NULL)\nnotifications_created_at_not_null: NOT NULL created_at\nnotifications_id_not_null: NOT NULL id\nnotifications_kind_not_null: NOT NULL kind\nnotifications_message_id_fkey: FOREIGN KEY (message_id) REFERENCES education.messages(id)\nnotifications_organization_id_not_null: NOT NULL organization_id\nnotifications_person_id_not_null: NOT NULL person_id\nnotifications_thread_id_fkey: FOREIGN KEY (thread_id) REFERENCES education.threads(id)\nparent_notification_student: FOREIGN KEY (parent_student_id, organization_id) REFERENCES education.students(id, organization_id)\nCREATE UNIQUE INDEX education_notification_event ON education.notifications USING btree (organization_id, person_id, event_key) WHERE (event_key IS NOT NULL)\nCREATE INDEX notifications_message ON education.notifications USING btree (message_id)\nCREATE INDEX notifications_recipient ON education.notifications USING btree (organization_id, person_id, created_at, id)\nCREATE INDEX parent_notification_list ON education.notifications USING btree (organization_id, person_id, parent_student_id, created_at DESC, id) WHERE (parent_student_id IS NOT NULL)'
}

