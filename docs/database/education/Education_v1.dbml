// СФОРМИРОВАНО scripts/database/export_schema.py; не редактировать вручную.
// Только реальные объекты PostgreSQL. Полное определение SQL: schema.catalog.json.
Project education {
  database_type: 'PostgreSQL'
  Note: 'Каталог PostgreSQL после миграций. Межбазовые идентификаторы не являются внешними ключами.'
}

// External reference: only the actual FK target columns are shown.
Table core.accounts {
  id uuid [not null]
  Note: 'External FK target; full definition belongs to its own schema catalog.'
}

// External reference: only the actual FK target columns are shown.
Table core.organizations {
  id uuid [not null]
  Note: 'External FK target; full definition belongs to its own schema catalog.'
}

// External reference: only the actual FK target columns are shown.
Table core.persons {
  id uuid [not null]
  Note: 'External FK target; full definition belongs to its own schema catalog.'
}

Table education.achievement_definitions {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(80)" [not null]
  rule_version integer [not null]
  name "character varying(160)" [not null]
  description text [not null]
  rule jsonb [not null]
  enabled boolean [not null, default: `true`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (code, rule_version) [name: 'achievement_definitions_code_rule_version_key', type: btree, unique]
  }
  Note: 'achievement_definitions_code_not_null: NOT NULL code\nachievement_definitions_code_rule_version_key: UNIQUE (code, rule_version)\nachievement_definitions_created_at_not_null: NOT NULL created_at\nachievement_definitions_description_not_null: NOT NULL description\nachievement_definitions_enabled_not_null: NOT NULL enabled\nachievement_definitions_id_not_null: NOT NULL id\nachievement_definitions_name_not_null: NOT NULL name\nachievement_definitions_rule_check: CHECK (jsonb_typeof(rule) = \'object\'::text)\nachievement_definitions_rule_not_null: NOT NULL rule\nachievement_definitions_rule_version_check: CHECK (rule_version > 0)\nachievement_definitions_rule_version_not_null: NOT NULL rule_version\nCREATE UNIQUE INDEX achievement_definitions_code_rule_version_key ON education.achievement_definitions USING btree (code, rule_version)'
}

Table education.achievement_events {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  student_id uuid [not null]
  source_type "character varying(20)" [not null]
  source_id uuid [not null]
  occurred_at "timestamp with time zone" [not null]
  payload jsonb [not null]
  revoked_at "timestamp with time zone" [null]
  indexes {
    (id, organization_id, student_id) [name: 'achievement_events_id_organization_id_student_id_key', type: btree, unique]
    (organization_id, student_id, source_type, source_id) [name: 'achievement_events_organization_id_student_id_source_type_s_key', type: btree, unique]
    (organization_id, student_id, occurred_at, id) [name: 'achievement_events_student', type: btree]
  }
  Note: 'achievement_events_id_not_null: NOT NULL id\nachievement_events_id_organization_id_student_id_key: UNIQUE (id, organization_id, student_id)\nachievement_events_occurred_at_not_null: NOT NULL occurred_at\nachievement_events_organization_id_not_null: NOT NULL organization_id\nachievement_events_organization_id_student_id_source_type_s_key: UNIQUE (organization_id, student_id, source_type, source_id)\nachievement_events_payload_check: CHECK (jsonb_typeof(payload) = \'object\'::text)\nachievement_events_payload_not_null: NOT NULL payload\nachievement_events_source_id_not_null: NOT NULL source_id\nachievement_events_source_type_check: CHECK (source_type::text = ANY (ARRAY[\'attempt\'::character varying, \'homework\'::character varying]::text[]))\nachievement_events_source_type_not_null: NOT NULL source_type\nachievement_events_student_id_not_null: NOT NULL student_id\nachievement_events_student_id_organization_id_fkey: FOREIGN KEY (student_id, organization_id) REFERENCES education.students(id, organization_id)\nCREATE UNIQUE INDEX achievement_events_id_organization_id_student_id_key ON education.achievement_events USING btree (id, organization_id, student_id)\nCREATE UNIQUE INDEX achievement_events_organization_id_student_id_source_type_s_key ON education.achievement_events USING btree (organization_id, student_id, source_type, source_id)\nCREATE INDEX achievement_events_student ON education.achievement_events USING btree (organization_id, student_id, occurred_at, id)'
}

Table education.achievement_unlocks {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  student_id uuid [not null]
  definition_id uuid [not null]
  source_event_id uuid [not null]
  unlocked_at "timestamp with time zone" [not null, default: `now()`]
  revoked_at "timestamp with time zone" [null]
  indexes {
    (organization_id, student_id, definition_id) [name: 'achievement_unlocks_organization_id_student_id_definition_i_key', type: btree, unique]
  }
  Note: 'achievement_unlocks_definition_id_fkey: FOREIGN KEY (definition_id) REFERENCES education.achievement_definitions(id)\nachievement_unlocks_definition_id_not_null: NOT NULL definition_id\nachievement_unlocks_id_not_null: NOT NULL id\nachievement_unlocks_organization_id_not_null: NOT NULL organization_id\nachievement_unlocks_organization_id_student_id_definition_i_key: UNIQUE (organization_id, student_id, definition_id)\nachievement_unlocks_source_event_id_not_null: NOT NULL source_event_id\nachievement_unlocks_source_event_id_organization_id_studen_fkey: FOREIGN KEY (source_event_id, organization_id, student_id) REFERENCES education.achievement_events(id, organization_id, student_id)\nachievement_unlocks_student_id_not_null: NOT NULL student_id\nachievement_unlocks_student_id_organization_id_fkey: FOREIGN KEY (student_id, organization_id) REFERENCES education.students(id, organization_id)\nachievement_unlocks_unlocked_at_not_null: NOT NULL unlocked_at\nCREATE UNIQUE INDEX achievement_unlocks_organization_id_student_id_definition_i_key ON education.achievement_unlocks USING btree (organization_id, student_id, definition_id)'
}

Table education.activity_assignments {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  activity_id uuid [not null]
  group_id uuid [null]
  student_id uuid [null]
  config jsonb [not null, default: `'{}'::jsonb`]
  opens_at "timestamp with time zone" [null]
  due_at "timestamp with time zone" [null]
  completion jsonb [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (organization_id, owner_account_id, group_id) [name: 'activity_assignments_group', type: btree]
  }
  Note: 'activity_assignments_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES education.activity_definitions(id)\nactivity_assignments_activity_id_not_null: NOT NULL activity_id\nactivity_assignments_check: CHECK (group_id IS NOT NULL OR student_id IS NOT NULL)\nactivity_assignments_config_not_null: NOT NULL config\nactivity_assignments_created_at_not_null: NOT NULL created_at\nactivity_assignments_group_id_organization_id_owner_accoun_fkey: FOREIGN KEY (group_id, organization_id, owner_account_id) REFERENCES education.groups(id, organization_id, owner_account_id)\nactivity_assignments_id_not_null: NOT NULL id\nactivity_assignments_organization_id_not_null: NOT NULL organization_id\nactivity_assignments_owner_account_id_not_null: NOT NULL owner_account_id\nactivity_assignments_student_id_organization_id_owner_acco_fkey: FOREIGN KEY (student_id, organization_id, owner_account_id) REFERENCES education.students(id, organization_id, owner_account_id)\nCREATE INDEX activity_assignments_group ON education.activity_assignments USING btree (organization_id, owner_account_id, group_id)'
}

Table education.activity_attempts {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  student_id uuid [not null]
  account_id uuid [not null]
  activity_id uuid [not null]
  assignment_id uuid [null]
  status "character varying(20)" [not null, default: `'running'::character varying`]
  source "character varying(20)" [not null, default: `'browser'::character varying`]
  contract_version integer [not null, default: `1`]
  exercise_text text [null]
  started_at "timestamp with time zone" [not null, default: `now()`]
  finished_at "timestamp with time zone" [null]
  result_payload jsonb [null]
  result_version integer [null]
  config jsonb [not null, default: `'{}'::jsonb`]
  exercise_payload jsonb [not null, default: `'{}'::jsonb`]
  client_state jsonb [not null, default: `'{}'::jsonb`]
  state_version integer [not null, default: `0`]
  revoked_at "timestamp with time zone" [null]
  indexes {
    (id, organization_id, student_id) [name: 'activity_attempt_tenant', type: btree, unique]
    (organization_id, student_id, started_at, id) [name: 'activity_attempts_student', type: btree]
  }
  Note: 'activity_attempt_tenant: UNIQUE (id, organization_id, student_id)\nactivity_attempts_account_id_not_null: NOT NULL account_id\nactivity_attempts_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES education.activity_definitions(id)\nactivity_attempts_activity_id_not_null: NOT NULL activity_id\nactivity_attempts_assignment_id_fkey: FOREIGN KEY (assignment_id) REFERENCES education.activity_assignments(id)\nactivity_attempts_check: CHECK (finished_at IS NULL OR finished_at >= started_at)\nactivity_attempts_client_state_not_null: NOT NULL client_state\nactivity_attempts_config_not_null: NOT NULL config\nactivity_attempts_contract_version_not_null: NOT NULL contract_version\nactivity_attempts_exercise_payload_not_null: NOT NULL exercise_payload\nactivity_attempts_id_not_null: NOT NULL id\nactivity_attempts_organization_id_not_null: NOT NULL organization_id\nactivity_attempts_source_check: CHECK (source::text = ANY (ARRAY[\'browser\'::character varying, \'managed-device\'::character varying, \'native-app\'::character varying]::text[]))\nactivity_attempts_source_not_null: NOT NULL source\nactivity_attempts_started_at_not_null: NOT NULL started_at\nactivity_attempts_state_version_check: CHECK (state_version >= 0)\nactivity_attempts_state_version_not_null: NOT NULL state_version\nactivity_attempts_status_check: CHECK (status::text = ANY (ARRAY[\'running\'::character varying, \'finished\'::character varying, \'expired\'::character varying, \'failed\'::character varying]::text[]))\nactivity_attempts_status_not_null: NOT NULL status\nactivity_attempts_student_id_fkey: FOREIGN KEY (student_id) REFERENCES education.students(id)\nactivity_attempts_student_id_not_null: NOT NULL student_id\nCREATE UNIQUE INDEX activity_attempt_tenant ON education.activity_attempts USING btree (id, organization_id, student_id)\nCREATE INDEX activity_attempts_student ON education.activity_attempts USING btree (organization_id, student_id, started_at DESC, id)'
}

Table education.activity_definitions {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(60)" [not null]
  name "character varying(160)" [not null]
  kind "character varying(40)" [not null]
  contract_version integer [not null, default: `1`]
  enabled boolean [not null, default: `true`]
  config jsonb [not null, default: `'{}'::jsonb`]
  metrics jsonb [not null, default: `'[]'::jsonb`]
  required_permission "character varying(180)" [not null, default: `'education.activities.use'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    code [name: 'activity_definitions_code_key', type: btree, unique]
  }
  Note: 'activity_definitions_code_key: UNIQUE (code)\nactivity_definitions_code_not_null: NOT NULL code\nactivity_definitions_config_not_null: NOT NULL config\nactivity_definitions_contract_version_check: CHECK (contract_version > 0)\nactivity_definitions_contract_version_not_null: NOT NULL contract_version\nactivity_definitions_created_at_not_null: NOT NULL created_at\nactivity_definitions_enabled_not_null: NOT NULL enabled\nactivity_definitions_id_not_null: NOT NULL id\nactivity_definitions_kind_check: CHECK (kind::text = ANY (ARRAY[\'typing\'::character varying, \'web-game\'::character varying, \'test\'::character varying, \'programming\'::character varying, \'native-app\'::character varying]::text[]))\nactivity_definitions_kind_not_null: NOT NULL kind\nactivity_definitions_metrics_not_null: NOT NULL metrics\nactivity_definitions_name_check: CHECK (btrim(name::text) <> \'\'::text)\nactivity_definitions_name_not_null: NOT NULL name\nactivity_definitions_required_permission_not_null: NOT NULL required_permission\nCREATE UNIQUE INDEX activity_definitions_code_key ON education.activity_definitions USING btree (code)'
}

Table education.activity_exercise_sets {
  code "character varying(80)" [not null]
  version integer [not null]
  activity_code "character varying(60)" [not null]
  language "character varying(2)" [not null]
  mode "character varying(20)" [not null]
  difficulty integer [not null]
  content jsonb [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (code, version) [pk]
    (activity_code, version, language, mode, difficulty) [name: 'activity_exercise_sets_activity_code_version_language_mode__key', type: btree, unique]
  }
  Note: 'activity_exercise_sets_activity_code_fkey: FOREIGN KEY (activity_code) REFERENCES education.activity_definitions(code)\nactivity_exercise_sets_activity_code_not_null: NOT NULL activity_code\nactivity_exercise_sets_activity_code_version_language_mode__key: UNIQUE (activity_code, version, language, mode, difficulty)\nactivity_exercise_sets_code_not_null: NOT NULL code\nactivity_exercise_sets_content_check: CHECK (jsonb_typeof(content) = \'array\'::text)\nactivity_exercise_sets_content_not_null: NOT NULL content\nactivity_exercise_sets_created_at_not_null: NOT NULL created_at\nactivity_exercise_sets_difficulty_check: CHECK (difficulty >= 1 AND difficulty <= 3)\nactivity_exercise_sets_difficulty_not_null: NOT NULL difficulty\nactivity_exercise_sets_language_check: CHECK (language::text = ANY (ARRAY[\'ru\'::character varying, \'en\'::character varying]::text[]))\nactivity_exercise_sets_language_not_null: NOT NULL language\nactivity_exercise_sets_mode_not_null: NOT NULL mode\nactivity_exercise_sets_version_check: CHECK (version > 0)\nactivity_exercise_sets_version_not_null: NOT NULL version\nCREATE UNIQUE INDEX activity_exercise_sets_activity_code_version_language_mode__key ON education.activity_exercise_sets USING btree (activity_code, version, language, mode, difficulty)'
}

Table education.activity_results {
  attempt_id uuid [pk, not null]
  organization_id uuid [not null]
  student_id uuid [not null]
  type "character varying(20)" [not null]
  version integer [not null]
  request_hash character(64) [not null]
  metrics jsonb [not null]
  passed boolean [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (organization_id, student_id, created_at, attempt_id) [name: 'activity_results_student', type: btree]
  }
  Note: 'activity_results_attempt_id_not_null: NOT NULL attempt_id\nactivity_results_attempt_id_organization_id_student_id_fkey: FOREIGN KEY (attempt_id, organization_id, student_id) REFERENCES education.activity_attempts(id, organization_id, student_id)\nactivity_results_created_at_not_null: NOT NULL created_at\nactivity_results_metrics_check: CHECK (jsonb_typeof(metrics) = \'object\'::text)\nactivity_results_metrics_not_null: NOT NULL metrics\nactivity_results_organization_id_not_null: NOT NULL organization_id\nactivity_results_passed_not_null: NOT NULL passed\nactivity_results_request_hash_not_null: NOT NULL request_hash\nactivity_results_student_id_not_null: NOT NULL student_id\nactivity_results_type_check: CHECK (type::text = ANY (ARRAY[\'typing\'::character varying, \'logic\'::character varying]::text[]))\nactivity_results_type_not_null: NOT NULL type\nactivity_results_version_check: CHECK (version > 0)\nactivity_results_version_not_null: NOT NULL version\nCREATE INDEX activity_results_student ON education.activity_results USING btree (organization_id, student_id, created_at DESC, attempt_id)'
}

Table education.assessment_attempts {
  id uuid [pk, not null, default: `uuidv7()`]
  version_id uuid [not null]
  student_id uuid [not null]
  organization_id uuid [not null]
  assignment_id uuid [null]
  state "character varying(30)" [not null, default: `'IN_PROGRESS'::character varying`]
  seed bigint [not null, default: `0`]
  started_at "timestamp with time zone" [not null, default: `now()`]
  submitted_at "timestamp with time zone" [null]
  answers jsonb [not null, default: `'{}'::jsonb`]
  result jsonb [not null, default: `'{}'::jsonb`]
  score integer [null]
  max_score integer [null]
  percentage numeric(5,2) [null]
  passed boolean [null]
  manual_review_notes text [null]
  reviewed_by_person_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  revision integer [not null, default: `1`]
  question_order jsonb [not null, default: `'[]'::jsonb`]
  option_order jsonb [not null, default: `'{}'::jsonb`]
  review_history jsonb [not null, default: `'[]'::jsonb`]
  indexes {
    (organization_id, student_id, version_id, state) [name: 'assessment_attempts_student_active_idx', type: btree]
    (organization_id, student_id, version_id, started_at) [name: 'assessment_attempts_student_idx', type: btree]
  }
  Note: 'assessment_attempts_answers_check: CHECK (jsonb_typeof(answers) = \'object\'::text)\nassessment_attempts_answers_not_null: NOT NULL answers\nassessment_attempts_assignment_id_fkey: FOREIGN KEY (assignment_id) REFERENCES education.activity_assignments(id) ON DELETE SET NULL\nassessment_attempts_created_at_not_null: NOT NULL created_at\nassessment_attempts_id_not_null: NOT NULL id\nassessment_attempts_max_score_check: CHECK (max_score IS NULL OR max_score >= 0)\nassessment_attempts_option_order_not_null: NOT NULL option_order\nassessment_attempts_organization_id_not_null: NOT NULL organization_id\nassessment_attempts_percentage_check: CHECK (percentage IS NULL OR percentage >= 0::numeric AND percentage <= 100::numeric)\nassessment_attempts_question_order_not_null: NOT NULL question_order\nassessment_attempts_result_check: CHECK (jsonb_typeof(result) = \'object\'::text)\nassessment_attempts_result_not_null: NOT NULL result\nassessment_attempts_review_history_not_null: NOT NULL review_history\nassessment_attempts_revision_not_null: NOT NULL revision\nassessment_attempts_score_check: CHECK (score IS NULL OR score >= 0)\nassessment_attempts_seed_not_null: NOT NULL seed\nassessment_attempts_started_at_not_null: NOT NULL started_at\nassessment_attempts_state_check: CHECK (state::text = ANY (ARRAY[\'IN_PROGRESS\'::character varying, \'SUBMITTED\'::character varying, \'EVALUATED\'::character varying, \'AWAITING_MANUAL_REVIEW\'::character varying]::text[]))\nassessment_attempts_state_not_null: NOT NULL state\nassessment_attempts_student_id_fkey: FOREIGN KEY (student_id) REFERENCES education.students(id) ON DELETE CASCADE\nassessment_attempts_student_id_not_null: NOT NULL student_id\nassessment_attempts_version_id_fkey: FOREIGN KEY (version_id) REFERENCES education.assessment_versions(id) ON DELETE CASCADE\nassessment_attempts_version_id_not_null: NOT NULL version_id\nCREATE INDEX assessment_attempts_student_active_idx ON education.assessment_attempts USING btree (organization_id, student_id, version_id, state)\nCREATE INDEX assessment_attempts_student_idx ON education.assessment_attempts USING btree (organization_id, student_id, version_id, started_at DESC)'
}

Table education.assessment_versions {
  id uuid [pk, not null, default: `uuidv7()`]
  assessment_id uuid [not null]
  version_number integer [not null]
  title "character varying(200)" [not null]
  instructions text [not null, default: `''::text`]
  time_limit_seconds integer [null]
  passing_score_percent integer [not null, default: `60`]
  max_attempts integer [not null, default: `1`]
  shuffle_questions boolean [not null, default: `false`]
  shuffle_options boolean [not null, default: `false`]
  reveal_answers_policy "character varying(30)" [not null, default: `'after_grading'::character varying`]
  grading_policy "character varying(30)" [not null, default: `'highest'::character varying`]
  questions_snapshot jsonb [not null, default: `'[]'::jsonb`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (assessment_id, version_number) [name: 'assessment_versions_assessment_idx', type: btree]
    (assessment_id, version_number) [name: 'uq_assessment_version', type: btree, unique]
  }
  Note: 'assessment_versions_assessment_id_fkey: FOREIGN KEY (assessment_id) REFERENCES education.assessments(id) ON DELETE CASCADE\nassessment_versions_assessment_id_not_null: NOT NULL assessment_id\nassessment_versions_created_at_not_null: NOT NULL created_at\nassessment_versions_grading_policy_check: CHECK (grading_policy::text = ANY (ARRAY[\'highest\'::character varying, \'latest\'::character varying, \'average\'::character varying]::text[]))\nassessment_versions_grading_policy_not_null: NOT NULL grading_policy\nassessment_versions_id_not_null: NOT NULL id\nassessment_versions_instructions_not_null: NOT NULL instructions\nassessment_versions_max_attempts_check: CHECK (max_attempts >= 1 AND max_attempts <= 20)\nassessment_versions_max_attempts_not_null: NOT NULL max_attempts\nassessment_versions_passing_score_percent_check: CHECK (passing_score_percent >= 0 AND passing_score_percent <= 100)\nassessment_versions_passing_score_percent_not_null: NOT NULL passing_score_percent\nassessment_versions_questions_snapshot_check: CHECK (jsonb_typeof(questions_snapshot) = \'array\'::text)\nassessment_versions_questions_snapshot_not_null: NOT NULL questions_snapshot\nassessment_versions_reveal_answers_policy_check: CHECK (reveal_answers_policy::text = ANY (ARRAY[\'never\'::character varying, \'immediate\'::character varying, \'after_grading\'::character varying, \'deadline\'::character varying]::text[]))\nassessment_versions_reveal_answers_policy_not_null: NOT NULL reveal_answers_policy\nassessment_versions_shuffle_options_not_null: NOT NULL shuffle_options\nassessment_versions_shuffle_questions_not_null: NOT NULL shuffle_questions\nassessment_versions_time_limit_seconds_check: CHECK (time_limit_seconds IS NULL OR time_limit_seconds >= 30 AND time_limit_seconds <= 14400)\nassessment_versions_title_check: CHECK (btrim(title::text) <> \'\'::text)\nassessment_versions_title_not_null: NOT NULL title\nassessment_versions_version_number_check: CHECK (version_number > 0)\nassessment_versions_version_number_not_null: NOT NULL version_number\nuq_assessment_version: UNIQUE (assessment_id, version_number)\nCREATE INDEX assessment_versions_assessment_idx ON education.assessment_versions USING btree (assessment_id, version_number DESC)\nCREATE UNIQUE INDEX uq_assessment_version ON education.assessment_versions USING btree (assessment_id, version_number)'
}

Table education.assessments {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  author_person_id uuid [not null]
  title "character varying(200)" [not null]
  description text [not null, default: `''::text`]
  status "character varying(20)" [not null, default: `'DRAFT'::character varying`]
  latest_version_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  open_practice boolean [not null, default: `false`]
  indexes {
    (organization_id, status, updated_at) [name: 'assessments_org_status_idx', type: btree]
  }
  Note: 'assessments_author_person_id_not_null: NOT NULL author_person_id\nassessments_created_at_not_null: NOT NULL created_at\nassessments_description_not_null: NOT NULL description\nassessments_id_not_null: NOT NULL id\nassessments_latest_version_fkey: FOREIGN KEY (latest_version_id) REFERENCES education.assessment_versions(id) ON DELETE SET NULL\nassessments_open_practice_not_null: NOT NULL open_practice\nassessments_organization_id_not_null: NOT NULL organization_id\nassessments_status_check: CHECK (status::text = ANY (ARRAY[\'DRAFT\'::character varying, \'PUBLISHED\'::character varying, \'CLOSED\'::character varying, \'ARCHIVED\'::character varying]::text[]))\nassessments_status_not_null: NOT NULL status\nassessments_title_check: CHECK (btrim(title::text) <> \'\'::text)\nassessments_title_not_null: NOT NULL title\nassessments_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX assessments_org_status_idx ON education.assessments USING btree (organization_id, status, updated_at DESC)'
}

Table education.attendance {
  lesson_id uuid [not null]
  student_id uuid [not null]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  status "character varying(12)" [not null, default: `'pending'::character varying`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (lesson_id, student_id) [pk]
