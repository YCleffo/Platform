    lesson_id [name: 'lesson_reports_lesson', type: btree]
    (lesson_id, organization_id, owner_account_id) [name: 'lesson_reports_lesson_id_organization_id_owner_account_id_key', type: btree, unique]
  }
  Note: 'lesson_reports_id_not_null: NOT NULL id\nlesson_reports_id_organization_id_owner_account_id_key: UNIQUE (id, organization_id, owner_account_id)\nlesson_reports_lesson_id_not_null: NOT NULL lesson_id\nlesson_reports_lesson_id_organization_id_owner_account_id_fkey: FOREIGN KEY (lesson_id, organization_id, owner_account_id) REFERENCES education.lessons(id, organization_id, owner_account_id)\nlesson_reports_lesson_id_organization_id_owner_account_id_key: UNIQUE (lesson_id, organization_id, owner_account_id)\nlesson_reports_organization_id_not_null: NOT NULL organization_id\nlesson_reports_owner_account_id_not_null: NOT NULL owner_account_id\nlesson_reports_owner_person_id_not_null: NOT NULL owner_person_id\nlesson_reports_summary_check: CHECK (length(summary) >= 1 AND length(summary) <= 4000)\nlesson_reports_summary_not_null: NOT NULL summary\nlesson_reports_teacher_comment_check: CHECK (teacher_comment IS NULL OR length(teacher_comment) >= 1 AND length(teacher_comment) <= 4000)\nlesson_reports_topic_check: CHECK (btrim(topic::text) <> \'\'::text)\nlesson_reports_topic_not_null: NOT NULL topic\nlesson_reports_updated_at_not_null: NOT NULL updated_at\nCREATE UNIQUE INDEX lesson_reports_id_organization_id_owner_account_id_key ON education.lesson_reports USING btree (id, organization_id, owner_account_id)\nCREATE INDEX lesson_reports_lesson ON education.lesson_reports USING btree (lesson_id)\nCREATE UNIQUE INDEX lesson_reports_lesson_id_organization_id_owner_account_id_key ON education.lesson_reports USING btree (lesson_id, organization_id, owner_account_id)'
}

Table education.lesson_results {
  id uuid [pk, not null, default: `uuidv7()`]
