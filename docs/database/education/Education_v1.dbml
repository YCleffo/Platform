Table education.typing_results {
  attempt_id uuid [pk, not null]
  organization_id uuid [not null]
  student_id uuid [not null]
  duration_seconds integer [not null]
  language "character varying(2)" [not null]
  keystrokes integer [not null]
  correct_chars integer [not null]
  errors integer [not null]
  wpm numeric(6,1) [not null]
  accuracy numeric(5,2) [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (organization_id, student_id, wpm) [name: 'typing_results_student', type: btree]
  }
  Note: 'typing_results_accuracy_check: CHECK (accuracy >= 0::numeric AND accuracy <= 100::numeric)\ntyping_results_accuracy_not_null: NOT NULL accuracy\ntyping_results_attempt_id_fkey: FOREIGN KEY (attempt_id) REFERENCES education.activity_attempts(id)\ntyping_results_attempt_id_not_null: NOT NULL attempt_id\ntyping_results_check: CHECK (correct_chars >= 0 AND correct_chars <= keystrokes)\ntyping_results_check1: CHECK (errors >= 0 AND errors <= keystrokes)\ntyping_results_correct_chars_not_null: NOT NULL correct_chars\ntyping_results_created_at_not_null: NOT NULL created_at\ntyping_results_duration_seconds_check: CHECK (duration_seconds = ANY (ARRAY[15, 30, 60]))\ntyping_results_duration_seconds_not_null: NOT NULL duration_seconds\ntyping_results_errors_not_null: NOT NULL errors\ntyping_results_keystrokes_check: CHECK (keystrokes >= 0 AND keystrokes <= 10000)\ntyping_results_keystrokes_not_null: NOT NULL keystrokes\ntyping_results_language_check: CHECK (language::text = ANY (ARRAY[\'ru\'::character varying, \'en\'::character varying]::text[]))\ntyping_results_language_not_null: NOT NULL language\ntyping_results_organization_id_not_null: NOT NULL organization_id\ntyping_results_student_id_fkey: FOREIGN KEY (student_id) REFERENCES education.students(id)\ntyping_results_student_id_not_null: NOT NULL student_id\ntyping_results_wpm_check: CHECK (wpm >= 0::numeric AND wpm <= 500::numeric)\ntyping_results_wpm_not_null: NOT NULL wpm\nCREATE INDEX typing_results_student ON education.typing_results USING btree (organization_id, student_id, wpm DESC)'
}

