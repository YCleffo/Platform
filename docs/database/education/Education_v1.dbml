anization_id, account_id, created_at)\nCREATE UNIQUE INDEX file_transfers_final_key_key ON education.file_transfers USING btree (final_key)\nCREATE UNIQUE INDEX file_transfers_staging_key_key ON education.file_transfers USING btree (staging_key)'
}

