  Note: 'parent_invites_check: CHECK (expires_at > created_at)\nparent_invites_check1: CHECK ((used_at IS NULL) = (used_account_id IS NULL))\nparent_invites_check2: CHECK (used_at IS NULL OR revoked_at IS NULL)\nparent_invites_code_hash_key: UNIQUE (code_hash)\nparent_invites_code_hash_not_null: NOT NULL code_hash\nparent_invites_created_at_not_null: NOT NULL created_at\nparent_invites_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id)\nparent_invites_created_by_account_id_not_null: NOT NULL created_by_account_id\nparent_invites_expires_at_not_null: NOT NULL expires_at\nparent_invites_guardian_person_id_fkey: FOREIGN KEY (guardian_person_id) REFERENCES core.persons(id)\nparent_invites_guardian_person_id_not_null: NOT NULL guardian_person_id\nparent_invites_id_not_null: NOT NULL id\nparent_invites_organization_id_not_null: NOT NULL organization_id\nparent_invites_student_id_guardian_person_id_fkey: FOREIGN KEY (student_id, guardian_person_id) REFERENCES education.student_guardians(student_id, guardian_person_id)\nparent_invites_student_id_not_null: NOT NULL student_id\nparent_invites_student_id_organization_id_fkey: FOREIGN KEY (student_id, organization_id) REFERENCES education.students(id, organization_id)\nparent_invites_used_account_id_fkey: FOREIGN KEY (used_account_id) REFERENCES core.accounts(id)\nCREATE UNIQUE INDEX parent_invite_pending ON education.parent_invites USING btree (student_id, guardian_person_id) WHERE ((used_at IS NULL) AND (revoked_at IS NULL))\nCREATE INDEX parent_invite_retention ON education.parent_invites USING btree (expires_at, id)\nCREATE UNIQUE INDEX parent_invites_code_hash_key ON education.parent_invites USING btree (code_hash)'
}

