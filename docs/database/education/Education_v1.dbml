Table education.messages {
  id uuid [pk, not null, default: `uuidv7()`]
  thread_id uuid [not null]
  organization_id uuid [not null]
  sender_person_id uuid [not null]
  body text [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  client_key "character varying(128)" [null, default: `NULL::character varying`]
  kind "character varying(20)" [not null, default: `'text'::character varying`]
