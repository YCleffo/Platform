// СФОРМИРОВАНО scripts/database/export_schema.py; не редактировать вручную.
// Только реальные объекты PostgreSQL. Полное определение SQL: schema.catalog.json.
Project education {
  database_type: 'PostgreSQL'
  Note: 'Каталог PostgreSQL после миграций. Межбазовые идентификаторы не являются внешними ключами.'
}

Table education.activity_assignments {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  activity_id uuid [not null]
  group_id uuid [null]
  student_id uuid [null]
  config jsonb [not null, default: `'{}'::jsonb`]
  opens_at "timestamp with time zone" [null]
  due_at "timestamp with time zone" [null]
  completion jsonb [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (organization_id, owner_account_id, group_id) [name: 'activity_assignments_group', type: btree]
  }
  Note: 'activity_assignments_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES education.activity_definitions(id)\nactivity_assignments_activity_id_not_null: NOT NULL activity_id\nactivity_assignments_check: CHECK (group_id IS NOT NULL OR student_id IS NOT NULL)\nactivity_assignments_config_not_null: NOT NULL config\nactivity_assignments_created_at_not_null: NOT NULL created_at\nactivity_assignments_group_id_organization_id_owner_accoun_fkey: FOREIGN KEY (group_id, organization_id, owner_account_id) REFERENCES education.groups(id, organization_id, owner_account_id)\nactivity_assignments_id_not_null: NOT NULL id\nactivity_assignments_organization_id_not_null: NOT NULL organization_id\nactivity_assignments_owner_account_id_not_null: NOT NULL owner_account_id\nactivity_assignments_student_id_organization_id_owner_acco_fkey: FOREIGN KEY (student_id, organization_id, owner_account_id) REFERENCES education.students(id, organization_id, owner_account_id)\nCREATE INDEX activity_assignments_group ON education.activity_assignments USING btree (organization_id, owner_account_id, group_id)'
}

Table education.activity_attempts {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  student_id uuid [not null]
  account_id uuid [not null]
  activity_id uuid [not null]
  assignment_id uuid [null]
  status "character varying(20)" [not null, default: `'running'::character varying`]
  source "character varying(20)" [not null, default: `'browser'::character varying`]
  contract_version integer [not null, default: `1`]
  exercise_text text [null]
  started_at "timestamp with time zone" [not null, default: `now()`]
  finished_at "timestamp with time zone" [null]
  result_payload jsonb [null]
  result_version integer [null]
  config jsonb [not null, default: `'{}'::jsonb`]
  indexes {
    (organization_id, student_id, started_at, id) [name: 'activity_attempts_student', type: btree]
  }
  Note: 'activity_attempts_account_id_not_null: NOT NULL account_id\nactivity_attempts_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES education.activity_definitions(id)\nactivity_attempts_activity_id_not_null: NOT NULL activity_id\nactivity_attempts_assignment_id_fkey: FOREIGN KEY (assignment_id) REFERENCES education.activity_assignments(id)\nactivity_attempts_check: CHECK (finished_at IS NULL OR finished_at >= started_at)\nactivity_attempts_config_not_null: NOT NULL config\nactivity_attempts_contract_version_not_null: NOT NULL contract_version\nactivity_attempts_id_not_null: NOT NULL id\nactivity_attempts_organization_id_not_null: NOT NULL organization_id\nactivity_attempts_source_check: CHECK (source::text = ANY (ARRAY[\'browser\'::character varying, \'managed-device\'::character varying, \'native-app\'::character varying]::text[]))\nactivity_attempts_source_not_null: NOT NULL source\nactivity_attempts_started_at_not_null: NOT NULL started_at\nactivity_attempts_status_check: CHECK (status::text = ANY (ARRAY[\'running\'::character varying, \'finished\'::character varying, \'expired\'::character varying, \'failed\'::character varying]::text[]))\nactivity_attempts_status_not_null: NOT NULL status\nactivity_attempts_student_id_fkey: FOREIGN KEY (student_id) REFERENCES education.students(id)\nactivity_attempts_student_id_not_null: NOT NULL student_id\nCREATE INDEX activity_attempts_student ON education.activity_attempts USING btree (organization_id, student_id, started_at DESC, id)'
}

Table education.activity_definitions {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(60)" [not null]
  name "character varying(160)" [not null]
  kind "character varying(40)" [not null]
  contract_version integer [not null, default: `1`]
  enabled boolean [not null, default: `true`]
  config jsonb [not null, default: `'{}'::jsonb`]
  metrics jsonb [not null, default: `'[]'::jsonb`]
  required_permission "character varying(180)" [not null, default: `'education.activities.use'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    code [name: 'activity_definitions_code_key', type: btree, unique]
  }
  Note: 'activity_definitions_code_key: UNIQUE (code)\nactivity_definitions_code_not_null: NOT NULL code\nactivity_definitions_config_not_null: NOT NULL config\nactivity_definitions_contract_version_check: CHECK (contract_version > 0)\nactivity_definitions_contract_version_not_null: NOT NULL contract_version\nactivity_definitions_created_at_not_null: NOT NULL created_at\nactivity_definitions_enabled_not_null: NOT NULL enabled\nactivity_definitions_id_not_null: NOT NULL id\nactivity_definitions_kind_check: CHECK (kind::text = ANY (ARRAY[\'typing\'::character varying, \'web-game\'::character varying, \'test\'::character varying, \'programming\'::character varying, \'native-app\'::character varying]::text[]))\nactivity_definitions_kind_not_null: NOT NULL kind\nactivity_definitions_metrics_not_null: NOT NULL metrics\nactivity_definitions_name_check: CHECK (btrim(name::text) <> \'\'::text)\nactivity_definitions_name_not_null: NOT NULL name\nactivity_definitions_required_permission_not_null: NOT NULL required_permission\nCREATE UNIQUE INDEX activity_definitions_code_key ON education.activity_definitions USING btree (code)'
}

Table education.attendance {
  lesson_id uuid [not null]
  student_id uuid [not null]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  status "character varying(12)" [not null, default: `'pending'::character varying`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (lesson_id, student_id) [pk]
  }
  Note: 'attendance_lesson_id_not_null: NOT NULL lesson_id\nattendance_lesson_id_organization_id_owner_account_id_fkey: FOREIGN KEY (lesson_id, organization_id, owner_account_id) REFERENCES education.lessons(id, organization_id, owner_account_id)\nattendance_organization_id_not_null: NOT NULL organization_id\nattendance_owner_account_id_not_null: NOT NULL owner_account_id\nattendance_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'present\'::character varying, \'absent\'::character varying]::text[]))\nattendance_status_not_null: NOT NULL status\nattendance_student_id_not_null: NOT NULL student_id\nattendance_student_id_organization_id_owner_account_id_fkey: FOREIGN KEY (student_id, organization_id, owner_account_id) REFERENCES education.students(id, organization_id, owner_account_id)\nattendance_updated_at_not_null: NOT NULL updated_at'
}

Table education.events {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  owner_person_id uuid [not null]
  title "character varying(160)" [not null]
  kind "character varying(20)" [not null]
  starts_at "timestamp with time zone" [not null]
  ends_at "timestamp with time zone" [not null]
  location "character varying(240)" [not null, default: `''::character varying`]
  indexes {
    (organization_id, owner_account_id, starts_at, id) [name: 'events_owner_time', type: btree]
  }
  Note: 'events_check: CHECK (ends_at > starts_at AND ends_at <= (starts_at + \'24:00:00\'::interval))\nevents_ends_at_not_null: NOT NULL ends_at\nevents_id_not_null: NOT NULL id\nevents_kind_check: CHECK (kind::text = ANY (ARRAY[\'meeting\'::character varying, \'birthday\'::character varying, \'other\'::character varying]::text[]))\nevents_kind_not_null: NOT NULL kind\nevents_location_not_null: NOT NULL location\nevents_organization_id_not_null: NOT NULL organization_id\nevents_owner_account_id_not_null: NOT NULL owner_account_id\nevents_owner_person_id_not_null: NOT NULL owner_person_id\nevents_starts_at_not_null: NOT NULL starts_at\nevents_title_check: CHECK (btrim(title::text) <> \'\'::text)\nevents_title_not_null: NOT NULL title\nCREATE INDEX events_owner_time ON education.events USING btree (organization_id, owner_account_id, starts_at, id)'
}

Table education.files {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  owner_person_id uuid [not null]
  lesson_id uuid [null]
  name "character varying(240)" [not null]
  mime "character varying(100)" [not null]
  purpose "character varying(12)" [not null, default: `'material'::character varying`]
  size_bytes integer [not null]
  sha256 character(64) [not null]
  storage_key uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (id, owner_account_id) [name: 'files_id_owner_account_id_key', type: btree, unique]
    storage_key [name: 'files_storage_key_key', type: btree, unique]
  }
  Note: 'files_created_at_not_null: NOT NULL created_at\nfiles_id_not_null: NOT NULL id\nfiles_id_owner_account_id_key: UNIQUE (id, owner_account_id)\nfiles_lesson_id_organization_id_owner_account_id_fkey: FOREIGN KEY (lesson_id, organization_id, owner_account_id) REFERENCES education.lessons(id, organization_id, owner_account_id)\nfiles_mime_not_null: NOT NULL mime\nfiles_name_not_null: NOT NULL name\nfiles_organization_id_not_null: NOT NULL organization_id\nfiles_owner_account_id_not_null: NOT NULL owner_account_id\nfiles_owner_person_id_not_null: NOT NULL owner_person_id\nfiles_purpose_check: CHECK (purpose::text = ANY (ARRAY[\'avatar\'::character varying, \'material\'::character varying]::text[]))\nfiles_purpose_not_null: NOT NULL purpose\nfiles_sha256_not_null: NOT NULL sha256\nfiles_size_bytes_check: CHECK (size_bytes > 0 AND size_bytes <= 10485760)\nfiles_size_bytes_not_null: NOT NULL size_bytes\nfiles_storage_key_key: UNIQUE (storage_key)\nfiles_storage_key_not_null: NOT NULL storage_key\nCREATE UNIQUE INDEX files_id_owner_account_id_key ON education.files USING btree (id, owner_account_id)\nCREATE UNIQUE INDEX files_storage_key_key ON education.files USING btree (storage_key)'
}

Table education.group_students {
