NG btree (submission_id, idempotency_key)\nCREATE UNIQUE INDEX homework_submission_versions_submission_id_sequence_key ON education.homework_submission_versions USING btree (submission_id, sequence)\nCREATE UNIQUE INDEX homework_version_activity_unique ON education.homework_submission_versions USING btree (activity_attempt_id) WHERE (activity_attempt_id IS NOT NULL)\nCREATE TRIGGER homework_version_immutable BEFORE DELETE OR UPDATE ON education.homework_submission_versions FOR EACH ROW EXECUTE FUNCTION education.homework_immutable()'
