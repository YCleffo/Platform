egal_destruction_packages_retain_until_not_null: NOT NULL retain_until\nprivacy_legal_destruction_packages_subject_name_not_null: NOT NULL subject_name\nprivacy_legal_destruction_packages_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_legal_destruction_packages_subject_person_id_not_null: NOT NULL subject_person_id\nCREATE INDEX privacy_legal_destruction_case_idx ON core.privacy_legal_destruction_packages USING btree (case_id, destroyed_at, id)\nCREATE UNIQUE INDEX privacy_legal_destruction_packages_evidence_id_key ON core.privacy_legal_destruction_packages USING btree (evidence_id)\nCREATE TRIGGER privacy_legal_destruction_immutable BEFORE DELETE OR UPDATE ON core.privacy_legal_destruction_packages FOR EACH ROW EXECUTE FUNCTION core.protect_privacy_legal_destruction_package()'
}

