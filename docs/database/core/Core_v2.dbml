Table core.privacy_incidents {
  id uuid [pk, not null, default: `uuidv7()`]
  incident_type "character varying(120)" [not null]
  status "character varying(24)" [not null]
  containment_status "character varying(24)" [not null]
  detected_at "timestamp with time zone" [not null]
  initial_notification_due_at "timestamp with time zone" [not null]
  initial_notification_at "timestamp with time zone" [null]
  initial_notification_reference "character varying(120)" [null]
  investigation_notification_due_at "timestamp with time zone" [not null]
  investigation_notification_at "timestamp with time zone" [null]
  investigation_notification_reference "character varying(120)" [null]
  estimated_subjects integer [null]
  safe_reason_code "character varying(120)" [not null]
  created_by_account_id uuid [not null]
  created_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null]
  indexes {
    (status, detected_at) [name: 'idx_privacy_incidents_status', type: btree]
  }
  Note: 'chk_privacy_incident_deadlines: CHECK (initial_notification_due_at = (detected_at + \'24:00:00\'::interval) AND investigation_notification_due_at = (detected_at + \'72:00:00\'::interval))\nchk_privacy_incident_notifications: CHECK ((initial_notification_at IS NULL) = (initial_notification_reference IS NULL) AND (investigation_notification_at IS NULL) = (investigation_notification_reference IS NULL))\nprivacy_incidents_containment_status_check: CHECK (containment_status::text = ANY (ARRAY[\'unknown\'::character varying, \'in_progress\'::character varying, \'contained\'::character varying]::text[]))\nprivacy_incidents_containment_status_not_null: NOT NULL containment_status\nprivacy_incidents_created_at_not_null: NOT NULL created_at\nprivacy_incidents_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_incidents_created_by_account_id_not_null: NOT NULL created_by_account_id\nprivacy_incidents_detected_at_not_null: NOT NULL detected_at\nprivacy_incidents_estimated_subjects_check: CHECK (estimated_subjects >= 0)\nprivacy_incidents_id_not_null: NOT NULL id\nprivacy_incidents_incident_type_check: CHECK (incident_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_incidents_incident_type_not_null: NOT NULL incident_type\nprivacy_incidents_initial_notification_due_at_not_null: NOT NULL initial_notification_due_at\nprivacy_incidents_investigation_notification_due_at_not_null: NOT NULL investigation_notification_due_at\nprivacy_incidents_safe_reason_code_check: CHECK (safe_reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_incidents_safe_reason_code_not_null: NOT NULL safe_reason_code\nprivacy_incidents_status_check: CHECK (status::text = ANY (ARRAY[\'detected\'::character varying, \'investigating\'::character varying, \'contained\'::character varying, \'resolved\'::character varying]::text[]))\nprivacy_incidents_status_not_null: NOT NULL status\nprivacy_incidents_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_privacy_incidents_status ON core.privacy_incidents USING btree (status, detected_at)'
}

