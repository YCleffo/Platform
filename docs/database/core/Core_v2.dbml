Project Platform_Core_v2 {
  database_type: 'PostgreSQL'
  Note: '''
  Universal Platform — Core v2 (Phase 4.0).
  One deployment = one organization.
  Core contains only generic platform concepts: Person, Account/Auth, RBAC,
  module registry/settings, audit, transactional outbox/inbox.
  Domain entities such as Student/Teacher/Parent/Lesson/Device/File/Message
  are NOT part of Core.
  Synchronized with PostgreSQL migrations 001-018. Migration 018 adds
  immutable authenticated consent evidence and expands Core to 25 tables.
  SQL migrations remain the
  executable source of truth; PostgreSQL partial-index predicates and selected
  CHECK constraints are documented in table notes to preserve their exact semantics.
  '''
}

/* ========================= ENUMS ========================= */

Enum core_person_status {
  active
  inactive
  archived
}

Enum core_contact_type {
  email
  phone
}

Enum core_account_type {
  human
  service
  system
}

Enum core_account_status {
  pending_verification
  pending_approval
  active
  disabled
  archived
}

Enum core_auth_identifier_type {
  username
  email
  phone
}

Enum core_totp_algorithm {
  sha1
  sha256
  sha512
}

Enum core_audit_actor_type {
  anonymous
  account
  system
  service
}

Enum core_outbox_status {
  pending
  processing
  published
  failed
  dead
}

Enum core_inbox_status {
  received
  processing
  processed
  failed
  dead
}

/* ========================= PEOPLE ========================= */

Table core.persons {
  id uuid [pk, not null, default: `uuidv7()`, note: 'ID физического человека']
  status core_person_status [not null, default: 'active', note: 'Состояние Person']

  given_name varchar(120) [not null, note: 'Имя']
  family_name varchar(120) [not null, note: 'Фамилия']
  middle_name varchar(120) [note: 'Отчество/среднее имя, если есть']
  display_name varchar(255) [note: 'Готовое отображаемое имя для UI, если нужно']
  birth_date date [note: 'Дата рождения без времени']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz [note: 'NULL пока Person не архивирован']

  indexes {
    status [name: 'idx_persons_status']
    (family_name, given_name) [name: 'idx_persons_name']
    birth_date [name: 'idx_persons_birth_date']
  }

  Note: '''
  Физический человек.
  Person может существовать без Account и без единого контакта.
  Например ребёнок в детском саду может иметь 0 строк в person_contacts.
  '''
}

Table core.person_contacts {
  id uuid [pk, not null, default: `uuidv7()`]
  person_id uuid [not null, note: 'FK -> core.persons.id']

  contact_type core_contact_type [not null, note: 'email / phone']
  value varchar(320) [not null, note: 'Значение для отображения']
  normalized_value varchar(320) [not null, note: 'Нормализованное значение для поиска/сравнения']

  label varchar(80) [note: 'Например: Личный, Рабочий']
  is_primary boolean [not null, default: false]
  verified_at timestamptz [note: 'NULL если контакт не подтверждён']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (person_id, contact_type, normalized_value) [unique, name: 'uq_person_contacts_value']
    (person_id, contact_type) [name: 'idx_person_contacts_person_type']
    normalized_value [name: 'idx_person_contacts_normalized']
  }

  Note: '''
  Контакт именно физического человека, НЕ логин Account.
  У Person может быть 0..N контактов.
  Если строка контакта существует, value и normalized_value обязательны.
  Телефон родителя принадлежит Person родителя, а связь родитель-ребёнок
  будет находиться в доменном модуле Education.
  В БД есть partial UNIQUE uq_person_contacts_primary_per_type:
  один is_primary=true на (person_id, contact_type), WHERE is_primary = true.
  '''
}

/* ========================= ACCOUNTS / AUTH ========================= */

Table core.accounts {
  id uuid [pk, not null, default: `uuidv7()`]
  person_id uuid [note: 'FK -> persons.id. Для human логически обязателен; для service/system допустим NULL']

  account_type core_account_type [not null, default: 'human']
  status core_account_status [not null, default: 'pending_verification']

  label varchar(160) [note: 'Служебное имя Account, особенно для service/system']
  security_stamp uuid [not null, default: `uuidv4()`, note: 'Случайная метка безопасности, не timestamp']

  locked_until timestamptz [note: 'Временная блокировка входа']
  last_login_at timestamptz [note: 'NULL если ни разу не входил']

  created_by_account_id uuid [note: 'FK -> accounts.id']
  approved_by_account_id uuid [note: 'FK -> accounts.id']
  approved_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  disabled_at timestamptz
  archived_at timestamptz

  locale varchar(35) [note: 'Сохранённая canonical BCP 47 locale; NULL = использовать значение по умолчанию']
  timezone varchar(64) [note: 'Сохранённая IANA timezone; NULL = использовать значение по умолчанию']

  indexes {
    person_id [unique, name: 'uq_accounts_person']
    status [name: 'idx_accounts_status']
    account_type [name: 'idx_accounts_type']
    approved_by_account_id [name: 'idx_accounts_approved_by']
  }

  Note: '''
  Account = системная учётная запись. Person != Account.
  Один Person сейчас имеет максимум один Account.
  При "выйти со всех устройств", смене пароля после компрометации и подобных
  security-событиях security_stamp меняется; старые сессии с прежним stamp
  считаются недействительными.
  В БД действует CHECK chk_accounts_human_has_person: account_type='human' -> person_id IS NOT NULL.
  Migration 010 также добавляет CHECK canonical BCP 47 для locale и запрет blank timezone.
  '''
}

Table core.account_settings {
  account_id uuid [pk, not null, note: 'FK -> core.accounts.id; одна строка overrides на Account']
  settings jsonb [not null, default: `'{}'::jsonb`, note: 'Только sparse overrides из whitelist registry; без секретов и security state']
  schema_version integer [not null, default: 1, note: 'Версия схемы настроек; CHECK >= 1']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Migration 017. Эффективные значения вычисляются приложением как versioned defaults + overrides.
  JSON обязан быть object и не превышать 32768 байт; updated_at >= created_at.
  Строка создаётся лениво, удаляется при полном reset, GIN-индекс намеренно отсутствует.
  '''
}

Table core.legal_representations {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  representative_person_id uuid [not null]
  authority_type varchar(120) [not null]
  status varchar(32) [not null, default: 'declared']
  valid_from timestamptz [not null]
  valid_until timestamptz
  verified_at timestamptz
  verified_by_account_id uuid
  evidence_type varchar(120)
  evidence_reference varchar(512)
  evidence_sha256 bytea
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  revoked_by_account_id uuid
  revocation_reason_code varchar(120)

  indexes {
    (subject_person_id, status, valid_until) [name: 'idx_legal_rep_subject']
    (representative_person_id, status) [name: 'idx_legal_rep_representative']
  }

  Note: 'Migrations 019-020. Verified generic authority, no document scan stored in Core. Revocation preserves evidence.'
}

Table core.privacy_consents {
  id uuid [pk, not null, default: `uuidv7()`]
  granted_by_account_id uuid [not null, note: 'FK -> core.accounts.id ON DELETE RESTRICT']
  subject_person_id uuid
  granted_by_person_id uuid
  legal_representation_id uuid
  purpose_code varchar(120)
  consent_code varchar(120) [not null]
  document_version varchar(80) [not null]
  document_sha256 bytea [not null, note: 'Exactly 32 bytes']
  locale varchar(35) [not null]
  source varchar(80) [not null]
  granted_at timestamptz [not null, default: `now()`]
  withdrawn_at timestamptz
  request_id uuid
  created_at timestamptz [not null, default: `now()`]
  retention_until timestamptz
  legacy_record boolean [not null, default: false]

  indexes {
    (subject_person_id, consent_code, purpose_code) [unique, name: 'uq_privacy_consents_one_active', note: 'Partial: WHERE withdrawn_at IS NULL AND legacy_record = false']
    (granted_by_account_id, consent_code, granted_at, id) [name: 'idx_account_consents_history']
    (subject_person_id, granted_at, id) [name: 'idx_privacy_consents_subject_history']
    (granted_by_account_id, granted_at, id) [name: 'idx_privacy_consents_actor_history']
  }

  Note: '''
  Migration 018 table evolved by 019-020. New evidence records subject, actor,
  purpose, and verified representative authority. Historical rows without purpose
  remain legacy_record and are not current consent. Triggers prevent ordinary deletion
  and evidence mutation; an active subject/code/purpose is unique.
  '''
}

Table core.auth_identifiers {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']

  identifier_type core_auth_identifier_type [not null]
  value varchar(320) [not null, note: 'Исходное/отображаемое значение']
  normalized_value varchar(320) [not null, note: 'Нормализованное значение']

  is_primary boolean [not null, default: false]
  can_login boolean [not null, default: true]
  can_recover boolean [not null, default: false]
  verified_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (identifier_type, normalized_value) [unique, name: 'uq_auth_identifiers_type_value']
    account_id [name: 'idx_auth_identifiers_account']
    (account_id, identifier_type) [name: 'idx_auth_identifiers_account_type']
  }

  Note: '''
  Идентификаторы безопасности Account: username/email/phone.
  Отдельны от person_contacts намеренно.
  В БД есть partial UNIQUE uq_auth_identifiers_primary_per_type:
  один is_primary=true на (account_id, identifier_type), WHERE is_primary = true.
  Application policy: can_recover фактически использовать только для подтверждённых recovery-идентификаторов.
  '''
}

Table core.auth_password_credentials {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']

  password_hash text [not null, note: 'Только password hash; сырой пароль никогда не хранится']
  password_algorithm varchar(32) [not null, note: 'Информационно, например argon2id']

  must_change_password boolean [not null, default: false]
  password_changed_at timestamptz [not null, default: `now()`]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    account_id [unique, name: 'uq_auth_password_credentials_account']
  }

  Note: '0..1 пароль на Account. Если Account использует только внешний вход/Passkey — строки может не быть.'
}

Table core.auth_providers {
  id uuid [pk, not null, default: `uuidv7()`]

  code varchar(50) [not null, note: 'google / telegram / microsoft / ...']
  protocol varchar(50) [not null, note: 'oidc / oauth2 / custom / ...']
  display_name varchar(120) [not null]

  enabled boolean [not null, default: false]
  allow_login boolean [not null, default: true]
  allow_registration boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique, name: 'uq_auth_providers_code']
    enabled [name: 'idx_auth_providers_enabled']
  }

  Note: '''
  Справочник внешних провайдеров авторизации.
  Client secrets/private keys здесь НЕ хранятся — только env/secrets.
  protocol специально varchar, чтобы добавлять новые варианты без изменения ENUM.
  '''
}

Table core.auth_external_identities {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']
  provider_id uuid [not null, note: 'FK -> auth_providers.id']

  provider_subject varchar(255) [not null, note: 'Стабильный ID пользователя у Provider (например OIDC sub)']

  email varchar(320)
  email_verified boolean [not null, default: false]

  display_name varchar(255)
  avatar_url text

  claims jsonb [not null, default: `'{}'::jsonb`, note: 'Дополнительные claims провайдера']

  linked_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz

  indexes {
    (provider_id, provider_subject) [unique, name: 'uq_external_identity_provider_subject']
    (account_id, provider_id) [unique, name: 'uq_external_identity_account_provider']
    account_id [name: 'idx_external_identities_account']
    provider_id [name: 'idx_external_identities_provider']
    email [name: 'idx_external_identities_email']
  }

  Note: '''
  Привязанный внешний аккаунт.
  Один конкретный provider_subject нельзя привязать к двум нашим Account.
  Текущее правило: один Account -> максимум одна identity на конкретный Provider.
  Никогда не auto-merge Account только по совпавшему email провайдера.
  '''
}

Table core.auth_passkeys {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']

  credential_id bytea [not null, note: 'Бинарный WebAuthn credential ID']
  public_key bytea [not null, note: 'Публичный ключ; приватный ключ сервер не хранит']
  sign_count bigint [not null, default: 0]

  backup_eligible boolean [not null, default: false, note: 'WebAuthn L3: credential может быть синхронизирован через cloud keychain']
  backup_state boolean [not null, default: false, note: 'WebAuthn L3: credential сейчас находится в backed-up/synced состоянии']

  aaguid uuid
  transports text[] [not null, default: `'{}'::text[]`, note: 'internal / usb / nfc / ble / ...']
  label varchar(160)

  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  revoked_at timestamptz

  indexes {
    credential_id [unique, name: 'uq_auth_passkeys_credential']
    account_id [name: 'idx_auth_passkeys_account']
    revoked_at [name: 'idx_auth_passkeys_revoked']
  }

  Note: 'Passkey/WebAuthn. Один Account может иметь несколько Passkey. backup_eligible и backup_state добавлены migration 014 для WebAuthn Level 3.'
}

Table core.auth_totp_factors {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']

  label varchar(160)
  secret_encrypted bytea [not null, note: 'TOTP secret зашифрован; ключ шифрования находится вне БД']
  algorithm core_totp_algorithm [not null, default: 'sha1']
  digits smallint [not null, default: 6]
  period_seconds smallint [not null, default: 30]

  verified_at timestamptz [note: 'NULL пока настройка TOTP не подтверждена']
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  revoked_at timestamptz

  last_used_counter bigint [note: 'Последний принятый RFC 6238 time-step counter; защита от replay']
  secret_key_version smallint [not null, default: 1, note: 'Версия внешнего ключа шифрования для secret_encrypted']
  setup_expires_at timestamptz [note: 'Срок жизни pending/unverified TOTP setup']

  indexes {
    account_id [name: 'idx_auth_totp_account']
    revoked_at [name: 'idx_auth_totp_revoked']
  }

  Note: '''
  TOTP/MFA для Google Authenticator, 2FAS, Microsoft Authenticator и т.п.
  Обязательность MFA задаётся политикой конкретной установки/приложения.
  В БД действуют CHECK digits BETWEEN 6 AND 8 и period_seconds > 0.
  Migration 013 добавляет CHECK last_used_counter >= 0, secret_key_version > 0 и setup_expires_at > created_at.
  Partial indexes migration 013: uq_auth_totp_active_verified_account на account_id
  WHERE verified_at IS NOT NULL AND revoked_at IS NULL; idx_auth_totp_pending_expiry
  на setup_expires_at WHERE verified_at IS NULL AND revoked_at IS NULL.
  '''
}

Table core.auth_recovery_codes {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']

  code_hash bytea [not null, note: 'Хэш recovery code; сырой код не хранится']

  created_at timestamptz [not null, default: `now()`]
  used_at timestamptz [note: 'NULL пока код не использован']
  revoked_at timestamptz [note: 'Инвалидация при regeneration, MFA disable или recovery reset']

  indexes {
    code_hash [unique, name: 'uq_auth_recovery_codes_hash']
    account_id [name: 'idx_auth_recovery_codes_account']
    used_at [name: 'idx_auth_recovery_codes_used']
  }

  Note: '''
  Одноразовые резервные MFA-коды.
  Migration 013 добавляет partial index idx_auth_recovery_codes_available на account_id
  WHERE used_at IS NULL AND revoked_at IS NULL.
  '''
}

Table core.auth_sessions {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null, note: 'FK -> accounts.id']

  session_token_hash bytea [not null, note: 'Hash случайного opaque session token']
  refresh_token_hash bytea [note: 'Опционально для клиентов, где refresh token реально нужен']

  security_stamp uuid [not null, note: 'Snapshot accounts.security_stamp на момент создания сессии']

  authentication_method varchar(80) [not null, note: 'password / google / telegram / passkey / ...']
  mfa_verified_at timestamptz

  client_type varchar(40) [not null, note: 'web / mobile / agent / ...']
  device_name varchar(160)

  ip_address inet
  user_agent text

  created_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  revoked_at timestamptz
  revoke_reason varchar(255)

  browser_name varchar(120)
  browser_version varchar(60)
  os_name varchar(120)
  os_version varchar(60)
  device_type varchar(40)
  device_model varchar(160)
  client_locale varchar(35) [note: 'Canonical BCP 47 locale snapshot клиента']
  client_timezone varchar(64) [note: 'IANA timezone snapshot клиента']
  client_instance_id uuid [note: 'Случайный UUID установки frontend; не фактор аутентификации']
  device_fingerprint_hash bytea [note: 'HMAC-SHA-256 risk signal, ровно 32 bytes; не фактор аутентификации']
  geo_country_code char(2) [note: 'Approximate ISO 3166-1 alpha-2 country from IP']
  geo_region varchar(160)
  geo_city varchar(160) [note: 'Approximate city from IP; не точная геолокация']
  geo_timezone varchar(64)
  access_expires_at timestamptz [not null, note: 'Expiry текущего short-lived opaque access token; <= expires_at']

  indexes {
    session_token_hash [unique, name: 'uq_auth_sessions_token']
    refresh_token_hash [unique, name: 'uq_auth_sessions_refresh']
    account_id [name: 'idx_auth_sessions_account']
    expires_at [name: 'idx_auth_sessions_expires']
    (account_id, expires_at) [name: 'idx_auth_sessions_account_expires']
  }

  Note: '''
  Основная browser-auth модель: opaque token в HttpOnly Secure cookie,
  в БД хранится только hash.
  Позволяет показывать активные устройства и отзывать одну/все сессии.
  В БД действует CHECK expires_at > created_at и CHECK access_expires_at <= expires_at.
  Migration 010 добавляет CHECK для canonical client_locale, non-blank timezone/device fields,
  32-byte device_fingerprint_hash и ISO alpha-2 geo_country_code.
  Partial index idx_auth_sessions_account_active: (account_id, last_seen_at DESC)
  WHERE revoked_at IS NULL.
  '''
}

Table core.auth_challenges {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [note: 'FK -> accounts.id; может быть NULL, если Account ещё не определён']

  challenge_type varchar(80) [not null, note: 'email_verification / password_reset / invitation / magic_login / ...']

  secret_hash bytea [not null, note: 'Hash одноразового секрета']
  target_normalized varchar(320)

  payload jsonb [not null, default: `'{}'::jsonb`]

  attempts smallint [not null, default: 0]
  max_attempts smallint [not null, default: 5]

  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  cancelled_at timestamptz

  indexes {
    secret_hash [unique, name: 'uq_auth_challenges_secret']
    account_id [name: 'idx_auth_challenges_account']
    (challenge_type, expires_at) [name: 'idx_auth_challenges_type_expires']
  }

  Note: '''
  Одноразовые security/auth операции.
  challenge_type специально varchar — набор сценариев расширяемый.
  В БД действуют CHECK attempts >= 0, max_attempts > 0, expires_at > created_at.
  '''
}

/* ========================= RBAC ========================= */

Table core.roles {
  id uuid [pk, not null, default: `uuidv7()`]

  code varchar(120) [not null, note: 'Например core.superadmin / core.admin']
  name varchar(160) [not null]
  description text

  is_system boolean [not null, default: false]
  is_protected boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique, name: 'uq_roles_code']
    is_system [name: 'idx_roles_system']
  }

  Note: '''
  Role = набор полномочий, НЕ отдельная сущность Admin.
  Seed: core.superadmin и core.admin.
  core.superadmin имеет bypass в PermissionService.
  '''
}

Table core.modules {
  id uuid [pk, not null, default: `uuidv7()`]

  code varchar(100) [not null, note: 'education / devices / storage / chat / ...']
  name varchar(160) [not null]
  description text

  version varchar(40) [not null]
  settings_schema_version integer [not null, default: 1]

  enabled boolean [not null, default: false]

  installed_at timestamptz [not null, default: `now()`]
  enabled_at timestamptz
  disabled_at timestamptz

  indexes {
    code [unique, name: 'uq_modules_code']
    enabled [name: 'idx_modules_enabled']
  }

  Note: '''
  Реестр модулей. Core хранит только метаданные модуля и не знает
  внутренние таблицы Education/Devices/Storage/Chat.
  '''
}

Table core.permissions {
  id uuid [pk, not null, default: `uuidv7()`]
  module_id uuid [note: 'FK -> modules.id; NULL для permission самого Core']

  code varchar(180) [not null, note: 'Например core.accounts.manage / education.lessons.read']
  name varchar(180) [not null]
  description text

  is_system boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique, name: 'uq_permissions_code']
    module_id [name: 'idx_permissions_module']
  }
}

Table core.role_permissions {
  role_id uuid [not null, note: 'FK -> roles.id']
  permission_id uuid [not null, note: 'FK -> permissions.id']

  granted_at timestamptz [not null, default: `now()`]
  granted_by_account_id uuid [note: 'FK -> accounts.id; NULL для seed/system операции']

  indexes {
    (role_id, permission_id) [pk, name: 'pk_role_permissions']
    permission_id [name: 'idx_role_permissions_permission']
  }

  Note: 'Many-to-many: Role <-> Permission.'
}

Table core.account_roles {
  account_id uuid [not null, note: 'FK -> accounts.id']
  role_id uuid [not null, note: 'FK -> roles.id']

  assigned_at timestamptz [not null, default: `now()`]
  assigned_by_account_id uuid [note: 'FK -> accounts.id; NULL для seed/system операции']
  expires_at timestamptz [note: 'NULL = бессрочно']

  indexes {
    (account_id, role_id) [pk, name: 'pk_account_roles']
    role_id [name: 'idx_account_roles_role']
    expires_at [name: 'idx_account_roles_expires']
  }

  Note: 'Текущее назначение ролей. Полная история назначений хранится через Audit.'
}

/* ========================= SETTINGS ========================= */

Table core.module_settings {
  id uuid [pk, not null, default: `uuidv7()`]
  module_id uuid [not null, note: 'FK -> modules.id']

  setting_key varchar(160) [not null]
  value jsonb [not null]
  description text

  updated_by_account_id uuid [note: 'FK -> accounts.id']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (module_id, setting_key) [unique, name: 'uq_module_settings_module_key']
  }

  Note: 'Настройки конкретного модуля. Секреты здесь не хранить.'
}

Table core.feature_flags {
  id uuid [pk, not null, default: `uuidv7()`]
  module_id uuid [note: 'FK -> modules.id; NULL = глобальный feature flag']

  code varchar(160) [not null]
  enabled boolean [not null, default: false]
  rollout_percent smallint [not null, default: 100, note: '0..100']

  config jsonb [not null, default: `'{}'::jsonb`]
  description text

  updated_by_account_id uuid [note: 'FK -> accounts.id']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique, name: 'uq_feature_flags_code']
    module_id [name: 'idx_feature_flags_module']
  }

  Note: 'В БД действует CHECK rollout_percent BETWEEN 0 AND 100.'
}

Table core.system_settings {
  id uuid [pk, not null, default: `uuidv7()`]

  setting_key varchar(160) [not null]
  value jsonb [not null]

  is_public boolean [not null, default: false]
  description text

  updated_by_account_id uuid [note: 'FK -> accounts.id']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    setting_key [unique, name: 'uq_system_settings_key']
  }

  Note: 'Глобальные настройки одной установки. Секреты здесь не хранить.'
}

/* ========================= AUDIT / EVENTS ========================= */

Table core.audit_events {
  id bigint [pk, not null, increment, note: 'Последовательный внутренний ID']
  event_id uuid [not null, default: `uuidv7()`, note: 'Глобальный ID audit-события']

  occurred_at timestamptz [not null, default: `now()`]

  actor_type core_audit_actor_type [not null]
  actor_account_id uuid [note: 'FK -> accounts.id, если actor = account']

  action varchar(180) [not null]

  resource_type varchar(180) [note: 'Полиморфная ссылка, например education.lesson']
  resource_id varchar(160) [note: 'ID ресурса в строковом виде']

  request_id uuid
  correlation_id uuid

  ip_address inet
  user_agent text

  success boolean [not null, default: true]
  error_code varchar(120)

  before_data jsonb
  after_data jsonb
  metadata jsonb [not null, default: `'{}'::jsonb`]

  indexes {
    event_id [unique, name: 'uq_audit_events_event']
    occurred_at [name: 'idx_audit_events_time']
    actor_account_id [name: 'idx_audit_events_actor']
    (resource_type, resource_id) [name: 'idx_audit_events_resource']
    correlation_id [name: 'idx_audit_events_correlation']
    action [name: 'idx_audit_events_action']
  }

  Note: '''
  Append-only аудит.
  Пароли, токены, TOTP secrets и прочие секреты никогда не писать
  в before_data/after_data/metadata.
  '''
}

Table core.outbox_events {
  id bigint [pk, not null, increment]
  event_id uuid [not null, default: `uuidv7()`]

  producer_module varchar(100) [not null]
  event_type varchar(220) [not null]
  aggregate_type varchar(160)
  aggregate_id varchar(160)

  payload jsonb [not null]
  headers jsonb [not null, default: `'{}'::jsonb`]

  correlation_id uuid
  causation_id uuid

  status core_outbox_status [not null, default: 'pending']
  attempts integer [not null, default: 0]

  occurred_at timestamptz [not null, default: `now()`]
  available_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  locked_by varchar(160)
  locked_until timestamptz
  last_error text

  indexes {
    event_id [unique, name: 'uq_outbox_events_event']
    (status, available_at) [name: 'idx_outbox_events_dispatch']
    (aggregate_type, aggregate_id) [name: 'idx_outbox_events_aggregate']
    correlation_id [name: 'idx_outbox_events_correlation']
  }

  Note: '''
  Transactional Outbox.
  Бизнес-изменение и outbox event записываются в одной PostgreSQL-транзакции.
  Worker публикует событие позже.
  Успешно published записи можно чистить retention-job, например после 30 дней.
  pending/failed/dead преждевременно не удалять.
  В БД действует CHECK attempts >= 0.
  '''
}

Table core.inbox_events {
  id bigint [pk, not null, increment]

  event_id uuid [not null]
  consumer varchar(180) [not null]

  status core_inbox_status [not null, default: 'received']
  attempts integer [not null, default: 0]

  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz

  locked_by varchar(160)
  locked_until timestamptz
  last_error text

  indexes {
    (event_id, consumer) [unique, name: 'uq_inbox_events_event_consumer']
    (consumer, status) [name: 'idx_inbox_events_consumer_status']
    (status, received_at) [name: 'idx_inbox_events_status_received']
  }

  Note: '''
  Idempotency для consumers: один event_id конкретный consumer обрабатывает один раз.
  processed записи можно чистить retention-job, например после 30 дней.
  failed/dead хранить дольше для диагностики.
  В БД действует CHECK attempts >= 0.
  '''
}

/* ========================= FOREIGN KEYS ========================= */

Ref: core.person_contacts.person_id > core.persons.id [delete: cascade]

Ref: core.accounts.person_id > core.persons.id [delete: restrict]
Ref: core.accounts.created_by_account_id > core.accounts.id [delete: set null]
Ref: core.accounts.approved_by_account_id > core.accounts.id [delete: set null]
Ref: core.account_settings.account_id > core.accounts.id [delete: cascade]
Ref: core.legal_representations.subject_person_id > core.persons.id [delete: restrict]
Ref: core.legal_representations.representative_person_id > core.persons.id [delete: restrict]
Ref: core.legal_representations.verified_by_account_id > core.accounts.id [delete: restrict]
Ref: core.legal_representations.revoked_by_account_id > core.accounts.id [delete: restrict]
Ref: core.privacy_consents.granted_by_account_id > core.accounts.id [delete: restrict]
Ref: core.privacy_consents.subject_person_id > core.persons.id [delete: restrict]
Ref: core.privacy_consents.granted_by_person_id > core.persons.id [delete: restrict]
Ref: core.privacy_consents.legal_representation_id > core.legal_representations.id [delete: restrict]

Ref: core.auth_identifiers.account_id > core.accounts.id [delete: cascade]
Ref: core.auth_password_credentials.account_id > core.accounts.id [delete: cascade]

Ref: core.auth_external_identities.account_id > core.accounts.id [delete: cascade]
Ref: core.auth_external_identities.provider_id > core.auth_providers.id [delete: restrict]

Ref: core.auth_passkeys.account_id > core.accounts.id [delete: cascade]
Ref: core.auth_totp_factors.account_id > core.accounts.id [delete: cascade]
Ref: core.auth_recovery_codes.account_id > core.accounts.id [delete: cascade]

Ref: core.auth_sessions.account_id > core.accounts.id [delete: cascade]
Ref: core.auth_challenges.account_id > core.accounts.id [delete: cascade]

Ref: core.account_roles.account_id > core.accounts.id [delete: cascade]
Ref: core.account_roles.role_id > core.roles.id [delete: cascade]
Ref: core.account_roles.assigned_by_account_id > core.accounts.id [delete: set null]

Ref: core.role_permissions.role_id > core.roles.id [delete: cascade]
Ref: core.role_permissions.permission_id > core.permissions.id [delete: cascade]
Ref: core.role_permissions.granted_by_account_id > core.accounts.id [delete: set null]

Ref: core.permissions.module_id > core.modules.id [delete: set null]

Ref: core.module_settings.module_id > core.modules.id [delete: cascade]
Ref: core.module_settings.updated_by_account_id > core.accounts.id [delete: set null]

Ref: core.feature_flags.module_id > core.modules.id [delete: cascade]
Ref: core.feature_flags.updated_by_account_id > core.accounts.id [delete: set null]

Ref: core.system_settings.updated_by_account_id > core.accounts.id [delete: set null]

Ref: core.audit_events.actor_account_id > core.accounts.id [delete: set null]
