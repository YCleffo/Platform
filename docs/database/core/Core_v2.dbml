    code [name: 'uq_auth_providers_code', type: btree, unique]
  }
  Note: 'Registry of external authentication providers such as OIDC/OAuth/custom providers.\nauth_providers_allow_login_not_null: NOT NULL allow_login\nauth_providers_allow_registration_not_null: NOT NULL allow_registration\nauth_providers_code_not_null: NOT NULL code\nauth_providers_created_at_not_null: NOT NULL created_at\nauth_providers_display_name_not_null: NOT NULL display_name\nauth_providers_enabled_not_null: NOT NULL enabled\nauth_providers_id_not_null: NOT NULL id\nauth_providers_protocol_not_null: NOT NULL protocol\nauth_providers_updated_at_not_null: NOT NULL updated_at\nchk_auth_providers_code_not_blank: CHECK (btrim(code::text) <> \'\'::text)\nchk_auth_providers_name_not_blank: CHECK (btrim(display_name::text) <> \'\'::text)\nchk_auth_providers_protocol_not_blank: CHECK (btrim(protocol::text) <> \'\'::text)\nCREATE INDEX idx_auth_providers_enabled ON core.auth_providers USING btree (enabled)\nCREATE UNIQUE INDEX uq_auth_providers_code ON core.auth_providers USING btree (code)'
}

Table core.auth_recovery_codes {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null]
  code_hash bytea [not null, note: 'Hash of a recovery code; raw code is never stored.']
  created_at "timestamp with time zone" [not null, default: `now()`]
  used_at "timestamp with time zone" [null, note: 'NULL until consumed.']
  revoked_at "timestamp with time zone" [null, note: 'Invalidation timestamp used by regeneration, MFA disable, and recovery reset.']
  indexes {
    account_id [name: 'idx_auth_recovery_codes_account', type: btree]
    used_at [name: 'idx_auth_recovery_codes_used', type: btree]
    code_hash [name: 'uq_auth_recovery_codes_hash', type: btree, unique]
  }
  Note: 'Single-use MFA recovery codes stored only as cryptographic hashes.\nauth_recovery_codes_account_id_not_null: NOT NULL account_id\nauth_recovery_codes_code_hash_not_null: NOT NULL code_hash\nauth_recovery_codes_created_at_not_null: NOT NULL created_at\nauth_recovery_codes_id_not_null: NOT NULL id\nchk_auth_recovery_code_hash_not_empty: CHECK (octet_length(code_hash) > 0)\nfk_auth_recovery_codes_account: FOREIGN KEY (account_id) REFERENCES core.accounts(id) ON DELETE CASCADE\nCREATE INDEX idx_auth_recovery_codes_account ON core.auth_recovery_codes USING btree (account_id)\nCREATE INDEX idx_auth_recovery_codes_available ON core.auth_recovery_codes USING btree (account_id) WHERE ((used_at IS NULL) AND (revoked_at IS NULL))\nCREATE INDEX idx_auth_recovery_codes_used ON core.auth_recovery_codes USING btree (used_at)\nCREATE UNIQUE INDEX uq_auth_recovery_codes_hash ON core.auth_recovery_codes USING btree (code_hash)'
}

Table core.auth_sessions {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null]
  session_token_hash bytea [not null, note: 'Hash of the opaque session token.']
  refresh_token_hash bytea [null, note: 'Optional refresh-token hash for clients that need refresh semantics.']
  security_stamp uuid [not null, note: 'Snapshot of accounts.security_stamp when the session was created.']
  authentication_method "character varying(80)" [not null, note: 'Extensible authentication method: password, passkey, provider code, etc.']
  mfa_verified_at "timestamp with time zone" [null]
  client_type "character varying(40)" [not null, note: 'Extensible client type: web, mobile, agent, etc.']
  device_name "character varying(160)" [null]
  ip_address inet [null]
  user_agent text [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  last_seen_at "timestamp with time zone" [not null, default: `now()`]
  expires_at "timestamp with time zone" [not null]
  revoked_at "timestamp with time zone" [null]
  revoke_reason "character varying(255)" [null]
  browser_name "character varying(120)" [null]
  browser_version "character varying(60)" [null]
  os_name "character varying(120)" [null]
  os_version "character varying(60)" [null]
  device_type "character varying(40)" [null]
  device_model "character varying(160)" [null]
  client_locale "character varying(35)" [null]
  client_timezone "character varying(64)" [null]
  client_instance_id uuid [null, note: 'Optional random frontend installation UUID; not an authentication factor.']
  device_fingerprint_hash bytea [null, note: 'HMAC-SHA-256 risk signal; never an authentication factor.']
  geo_country_code character(2) [null, note: 'Approximate ISO 3166-1 alpha-2 country inferred from IP.']
  geo_region "character varying(160)" [null]
  geo_city "character varying(160)" [null, note: 'Approximate city inferred from IP; never exact location.']
  geo_timezone "character varying(64)" [null]
  access_expires_at "timestamp with time zone" [not null, note: 'Expiry of the current short-lived opaque access token; expires_at is absolute session expiry.']
  indexes {
    account_id [name: 'idx_auth_sessions_account', type: btree]
    (account_id, expires_at) [name: 'idx_auth_sessions_account_expires', type: btree]
    expires_at [name: 'idx_auth_sessions_expires', type: btree]
    refresh_token_hash [name: 'uq_auth_sessions_refresh', type: btree, unique]
    session_token_hash [name: 'uq_auth_sessions_token', type: btree, unique]
  }
  Note: 'Active/historical sessions. Opaque session tokens are stored only as hashes.\nauth_sessions_access_expires_at_not_null: NOT NULL access_expires_at\nauth_sessions_account_id_not_null: NOT NULL account_id\nauth_sessions_authentication_method_not_null: NOT NULL authentication_method\nauth_sessions_client_type_not_null: NOT NULL client_type\nauth_sessions_created_at_not_null: NOT NULL created_at\nauth_sessions_expires_at_not_null: NOT NULL expires_at\nauth_sessions_id_not_null: NOT NULL id\nauth_sessions_last_seen_at_not_null: NOT NULL last_seen_at\nauth_sessions_security_stamp_not_null: NOT NULL security_stamp\nauth_sessions_session_token_hash_not_null: NOT NULL session_token_hash\nchk_auth_sessions_access_expiry: CHECK (access_expires_at <= expires_at)\nchk_auth_sessions_auth_method_not_blank: CHECK (btrim(authentication_method::text) <> \'\'::text)\nchk_auth_sessions_browser_name_not_blank: CHECK (browser_name IS NULL OR btrim(browser_name::text) <> \'\'::text)\nchk_auth_sessions_client_locale_canonical: CHECK (client_locale IS NULL OR client_locale::text ~ \'^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$\'::text)\nchk_auth_sessions_client_timezone_not_blank: CHECK (client_timezone IS NULL OR btrim(client_timezone::text) <> \'\'::text)\nchk_auth_sessions_client_type_not_blank: CHECK (btrim(client_type::text) <> \'\'::text)\nchk_auth_sessions_device_type_not_blank: CHECK (device_type IS NULL OR btrim(device_type::text) <> \'\'::text)\nchk_auth_sessions_expiry: CHECK (expires_at > created_at)\nchk_auth_sessions_fingerprint_hash_length: CHECK (device_fingerprint_hash IS NULL OR octet_length(device_fingerprint_hash) = 32)\nchk_auth_sessions_geo_country_code: CHECK (geo_country_code IS NULL OR geo_country_code ~ \'^[A-Z]{2}$\'::text)\nchk_auth_sessions_geo_timezone_not_blank: CHECK (geo_timezone IS NULL OR btrim(geo_timezone::text) <> \'\'::text)\nchk_auth_sessions_os_name_not_blank: CHECK (os_name IS NULL OR btrim(os_name::text) <> \'\'::text)\nchk_auth_sessions_token_not_empty: CHECK (octet_length(session_token_hash) > 0)\nfk_auth_sessions_account: FOREIGN KEY (account_id) REFERENCES core.accounts(id) ON DELETE CASCADE\nCREATE INDEX idx_auth_sessions_account ON core.auth_sessions USING btree (account_id)\nCREATE INDEX idx_auth_sessions_account_active ON core.auth_sessions USING btree (account_id, last_seen_at DESC) WHERE (revoked_at IS NULL)\nCREATE INDEX idx_auth_sessions_account_expires ON core.auth_sessions USING btree (account_id, expires_at)\nCREATE INDEX idx_auth_sessions_expires ON core.auth_sessions USING btree (expires_at)\nCREATE UNIQUE INDEX uq_auth_sessions_refresh ON core.auth_sessions USING btree (refresh_token_hash)\nCREATE UNIQUE INDEX uq_auth_sessions_token ON core.auth_sessions USING btree (session_token_hash)'
}

Table core.auth_totp_factors {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null]
  label "character varying(160)" [null]
  secret_encrypted bytea [not null, note: 'Encrypted TOTP secret.']
  algorithm core.totp_algorithm [not null, default: `'sha1'::core.totp_algorithm`]
  digits smallint [not null, default: `6`]
  period_seconds smallint [not null, default: `30`]
  verified_at "timestamp with time zone" [null, note: 'NULL until setup is confirmed by a valid TOTP code.']
  created_at "timestamp with time zone" [not null, default: `now()`]
  last_used_at "timestamp with time zone" [null]
  revoked_at "timestamp with time zone" [null]
  last_used_counter bigint [null, note: 'Last accepted RFC 6238 time-step counter. A counter may be accepted only once.']
  secret_key_version smallint [not null, default: `1`, note: 'Version of the external encryption key used for secret_encrypted.']
  setup_expires_at "timestamp with time zone" [null, note: 'Expiry of a pending, unverified TOTP setup.']
  indexes {
    account_id [name: 'idx_auth_totp_account', type: btree]
    revoked_at [name: 'idx_auth_totp_revoked', type: btree]
  }
  Note: 'TOTP MFA factors. Secret is encrypted; encryption key lives outside the database.\nauth_totp_factors_account_id_not_null: NOT NULL account_id\nauth_totp_factors_algorithm_not_null: NOT NULL algorithm\nauth_totp_factors_created_at_not_null: NOT NULL created_at\nauth_totp_factors_digits_not_null: NOT NULL digits\nauth_totp_factors_id_not_null: NOT NULL id\nauth_totp_factors_period_seconds_not_null: NOT NULL period_seconds\nauth_totp_factors_secret_encrypted_not_null: NOT NULL secret_encrypted\nauth_totp_factors_secret_key_version_not_null: NOT NULL secret_key_version\nchk_auth_totp_digits: CHECK (digits >= 6 AND digits <= 8)\nchk_auth_totp_factors_label_text: CHECK (label IS NULL OR btrim(label::text) <> \'\'::text AND label::text !~ \'[[:cntrl:]]\'::text)\nchk_auth_totp_last_used_counter: CHECK (last_used_counter IS NULL OR last_used_counter >= 0)\nchk_auth_totp_period: CHECK (period_seconds > 0)\nchk_auth_totp_secret_key_version: CHECK (secret_key_version > 0)\nchk_auth_totp_secret_not_empty: CHECK (octet_length(secret_encrypted) > 0)\nchk_auth_totp_setup_expiry: CHECK (setup_expires_at IS NULL OR setup_expires_at > created_at)\nfk_auth_totp_factors_account: FOREIGN KEY (account_id) REFERENCES core.accounts(id) ON DELETE CASCADE\nCREATE INDEX idx_auth_totp_account ON core.auth_totp_factors USING btree (account_id)\nCREATE INDEX idx_auth_totp_pending_expiry ON core.auth_totp_factors USING btree (setup_expires_at) WHERE ((verified_at IS NULL) AND (revoked_at IS NULL))\nCREATE INDEX idx_auth_totp_revoked ON core.auth_totp_factors USING btree (revoked_at)\nCREATE UNIQUE INDEX uq_auth_totp_active_verified_account ON core.auth_totp_factors USING btree (account_id) WHERE ((verified_at IS NOT NULL) AND (revoked_at IS NULL))'
}

Table core.data_subject_request_deadlines {
  id uuid [pk, not null, default: `uuidv7()`]
  request_id uuid [not null]
  deadline_code "character varying(120)" [not null]
  triggered_at "timestamp with time zone" [not null]
  calendar_type "character varying(20)" [not null]
  due_at "timestamp with time zone" [not null]
  extension_allowed boolean [not null, default: `false`]
  extended_at "timestamp with time zone" [null]
  extended_due_at "timestamp with time zone" [null]
  extension_reason_code "character varying(120)" [null]
  satisfied_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (request_id, deadline_code) [name: 'data_subject_request_deadlines_request_id_deadline_code_key', type: btree, unique]
  }
  Note: 'chk_dsar_calendar: CHECK (calendar_type::text = ANY (ARRAY[\'working_days\'::character varying, \'calendar_days\'::character varying, \'hours\'::character varying]::text[]))\nchk_dsar_deadline_code: CHECK (deadline_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_dsar_due_order: CHECK (due_at >= triggered_at)\nchk_dsar_extension: CHECK (extended_at IS NULL AND extended_due_at IS NULL AND extension_reason_code IS NULL OR extension_allowed AND extended_at IS NOT NULL AND extended_due_at IS NOT NULL AND extension_reason_code IS NOT NULL AND extended_due_at > due_at AND extended_at <= extended_due_at)\nchk_dsar_extension_reason: CHECK (extension_reason_code IS NULL OR extension_reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_dsar_satisfied_order: CHECK (satisfied_at IS NULL OR satisfied_at >= triggered_at)\ndata_subject_request_deadlines_calendar_type_not_null: NOT NULL calendar_type\ndata_subject_request_deadlines_created_at_not_null: NOT NULL created_at\ndata_subject_request_deadlines_deadline_code_not_null: NOT NULL deadline_code\ndata_subject_request_deadlines_due_at_not_null: NOT NULL due_at\ndata_subject_request_deadlines_extension_allowed_not_null: NOT NULL extension_allowed\ndata_subject_request_deadlines_id_not_null: NOT NULL id\ndata_subject_request_deadlines_request_id_deadline_code_key: UNIQUE (request_id, deadline_code)\ndata_subject_request_deadlines_request_id_fkey: FOREIGN KEY (request_id) REFERENCES core.data_subject_requests(id) ON DELETE RESTRICT\ndata_subject_request_deadlines_request_id_not_null: NOT NULL request_id\ndata_subject_request_deadlines_triggered_at_not_null: NOT NULL triggered_at\nCREATE UNIQUE INDEX data_subject_request_deadlines_request_id_deadline_code_key ON core.data_subject_request_deadlines USING btree (request_id, deadline_code)\nCREATE INDEX idx_dsar_deadline_open ON core.data_subject_request_deadlines USING btree (due_at) WHERE (satisfied_at IS NULL)\nCREATE TRIGGER trg_dsar_deadline_protect BEFORE DELETE OR UPDATE ON core.data_subject_request_deadlines FOR EACH ROW EXECUTE FUNCTION core.protect_dsar_deadline()'
}

Table core.data_subject_request_events {
  id uuid [pk, not null, default: `uuidv7()`]
  request_id uuid [not null]
  event_code "character varying(120)" [not null]
  from_status "character varying(32)" [null]
  to_status "character varying(32)" [null]
  actor_account_id uuid [not null]
  reason_code "character varying(120)" [null]
  occurred_at "timestamp with time zone" [not null]
  indexes {
    (request_id, occurred_at, id) [name: 'idx_dsar_event_history', type: btree]
  }
  Note: 'chk_dsar_event_code: CHECK (event_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_dsar_event_reason: CHECK (reason_code IS NULL OR reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\ndata_subject_request_events_actor_account_id_fkey: FOREIGN KEY (actor_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\ndata_subject_request_events_actor_account_id_not_null: NOT NULL actor_account_id\ndata_subject_request_events_event_code_not_null: NOT NULL event_code\ndata_subject_request_events_id_not_null: NOT NULL id\ndata_subject_request_events_occurred_at_not_null: NOT NULL occurred_at\ndata_subject_request_events_request_id_fkey: FOREIGN KEY (request_id) REFERENCES core.data_subject_requests(id) ON DELETE RESTRICT\ndata_subject_request_events_request_id_not_null: NOT NULL request_id\nCREATE INDEX idx_dsar_event_history ON core.data_subject_request_events USING btree (request_id, occurred_at, id)\nCREATE TRIGGER trg_dsar_event_protect BEFORE DELETE OR UPDATE ON core.data_subject_request_events FOR EACH ROW EXECUTE FUNCTION core.protect_dsar_event()'
}

Table core.data_subject_request_executions {
  id uuid [pk, not null, default: `uuidv7()`]
  request_id uuid [not null]
  execution_code "character varying(120)" [not null]
  status "character varying(20)" [not null]
  actor_account_id uuid [null]
  contributor_code "character varying(120)" [null]
  resource_type "character varying(120)" [null]
  resource_id uuid [null]
  schema_version "character varying(40)" [null]
  result_sha256 character(64) [null]
  result_size_bytes bigint [null]
  changed_paths "text[]" [null]
  error_code "character varying(120)" [null]
  started_at "timestamp with time zone" [not null]
  completed_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  stopped_purpose_codes "text[]" [null]
  retained_purpose_codes "text[]" [null]
  reason_codes "text[]" [null]
  erasure_case_id uuid [null]
  erasure_completed_items integer [null]
  erasure_blocked_items integer [null]
  erasure_failed_items integer [null]
  indexes {
    (execution_code, status) [name: 'idx_dsar_executions_code_status', type: btree]
    (request_id, started_at) [name: 'idx_dsar_executions_request', type: btree]
  }
  Note: 'chk_dsar_execution_codes: CHECK (execution_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND (contributor_code IS NULL OR contributor_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (resource_type IS NULL OR resource_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (error_code IS NULL OR error_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text))\nchk_dsar_execution_error: CHECK (status::text = \'failed\'::text AND error_code IS NOT NULL OR status::text <> \'failed\'::text AND error_code IS NULL)\nchk_dsar_execution_paths: CHECK (changed_paths IS NULL OR cardinality(changed_paths) >= 1 AND cardinality(changed_paths) <= 32 AND array_to_string(changed_paths, \',\'::text) !~ \'[^a-zA-Z0-9_,.-]\'::text)\nchk_dsar_execution_resource: CHECK ((resource_type IS NULL) = (resource_id IS NULL))\nchk_dsar_execution_result: CHECK (result_sha256 IS NULL AND result_size_bytes IS NULL OR status::text = \'completed\'::text AND result_sha256 ~ \'^[a-f0-9]{64}$\'::text AND result_size_bytes >= 0)\nchk_dsar_execution_status: CHECK (status::text = ANY (ARRAY[\'started\'::character varying, \'completed\'::character varying, \'failed\'::character varying]::text[]))\nchk_dsar_execution_terminal: CHECK ((status::text = \'started\'::text) = (completed_at IS NULL))\nchk_dsar_execution_time: CHECK (completed_at IS NULL OR completed_at >= started_at)\nchk_erasure_execution_evidence: CHECK (erasure_case_id IS NULL AND erasure_completed_items IS NULL AND erasure_blocked_items IS NULL AND erasure_failed_items IS NULL OR execution_code::text = \'data_erasure\'::text AND status::text = \'completed\'::text AND erasure_case_id IS NOT NULL AND erasure_completed_items > 0 AND erasure_blocked_items >= 0 AND erasure_failed_items = 0)\nchk_termination_evidence: CHECK (stopped_purpose_codes IS NULL AND retained_purpose_codes IS NULL AND reason_codes IS NULL OR execution_code::text = \'processing_termination\'::text AND status::text = \'completed\'::text AND stopped_purpose_codes IS NOT NULL AND retained_purpose_codes IS NOT NULL AND reason_codes IS NOT NULL AND (cardinality(stopped_purpose_codes) + cardinality(retained_purpose_codes)) >= 1 AND (cardinality(stopped_purpose_codes) + cardinality(retained_purpose_codes)) <= 100 AND cardinality(reason_codes) <= 100 AND array_to_string((stopped_purpose_codes || retained_purpose_codes) || reason_codes, \',\'::text) !~ \'[^a-z0-9_,.-]\'::text)\ndata_subject_request_executions_actor_account_id_fkey: FOREIGN KEY (actor_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\ndata_subject_request_executions_created_at_not_null: NOT NULL created_at\ndata_subject_request_executions_erasure_case_id_fkey: FOREIGN KEY (erasure_case_id) REFERENCES core.privacy_erasure_cases(id) ON DELETE RESTRICT\ndata_subject_request_executions_execution_code_not_null: NOT NULL execution_code\ndata_subject_request_executions_id_not_null: NOT NULL id\ndata_subject_request_executions_request_id_fkey: FOREIGN KEY (request_id) REFERENCES core.data_subject_requests(id) ON DELETE RESTRICT\ndata_subject_request_executions_request_id_not_null: NOT NULL request_id\ndata_subject_request_executions_started_at_not_null: NOT NULL started_at\ndata_subject_request_executions_status_not_null: NOT NULL status\nCREATE INDEX idx_dsar_executions_code_status ON core.data_subject_request_executions USING btree (execution_code, status)\nCREATE INDEX idx_dsar_executions_request ON core.data_subject_request_executions USING btree (request_id, started_at DESC)\nCREATE TRIGGER trg_dsar_execution_protect BEFORE DELETE OR UPDATE ON core.data_subject_request_executions FOR EACH ROW EXECUTE FUNCTION core.protect_dsar_execution()'
}

Table core.data_subject_requests {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  submitted_by_person_id uuid [null]
  submitted_by_account_id uuid [not null]
  legal_representation_id uuid [null]
  request_type "character varying(40)" [not null]
  status "character varying(32)" [not null, default: `'submitted'::character varying`]
  submitted_at "timestamp with time zone" [not null]
  identity_verified_at "timestamp with time zone" [null]
  completed_at "timestamp with time zone" [null]
  resolution_code "character varying(120)" [null]
  submission_request_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  intake_channel "character varying(32)" [null]
  identity_verification_code "character varying(120)" [null]
  identity_evidence_reference "character varying(500)" [null]
  representative_verification_reference "character varying(500)" [null]
  indexes {
    (submitted_by_account_id, submitted_at) [name: 'idx_dsar_actor_submitted', type: btree]
    (status, submitted_at) [name: 'idx_dsar_status_submitted', type: btree]
    (subject_person_id, submitted_at) [name: 'idx_dsar_subject_submitted', type: btree]
    (request_type, status) [name: 'idx_dsar_type_status', type: btree]
  }
  Note: 'chk_dsar_actor: CHECK (intake_channel IS NULL AND submitted_by_person_id IS NOT NULL AND identity_verification_code IS NULL AND identity_evidence_reference IS NULL AND representative_verification_reference IS NULL AND (subject_person_id = submitted_by_person_id AND legal_representation_id IS NULL OR subject_person_id <> submitted_by_person_id AND legal_representation_id IS NOT NULL) OR (intake_channel::text = ANY (ARRAY[\'paper\'::character varying, \'email\'::character varying, \'signed_electronic_document\'::character varying]::text[])) AND submitted_by_person_id IS NULL AND legal_representation_id IS NULL AND identity_verification_code IS NOT NULL AND identity_evidence_reference IS NOT NULL AND identity_verification_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND length(btrim(identity_evidence_reference::text)) > 0)\nchk_dsar_completion: CHECK ((status::text = ANY (ARRAY[\'completed\'::character varying, \'partially_completed\'::character varying]::text[])) = (completed_at IS NOT NULL))\nchk_dsar_completion_order: CHECK (completed_at IS NULL OR completed_at >= submitted_at)\nchk_dsar_resolution: CHECK (resolution_code IS NULL OR resolution_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_dsar_status: CHECK (status::text = ANY (ARRAY[\'submitted\'::character varying, \'identity_verification\'::character varying, \'in_review\'::character varying, \'in_progress\'::character varying, \'completed\'::character varying, \'partially_completed\'::character varying, \'rejected\'::character varying, \'cancelled\'::character varying]::text[]))\nchk_dsar_type: CHECK (request_type::text = ANY (ARRAY[\'access\'::character varying, \'processing_information\'::character varying, \'correction\'::character varying, \'restriction\'::character varying, \'processing_termination\'::character varying, \'erasure\'::character varying, \'export\'::character varying, \'consent_withdrawal\'::character varying]::text[]))\ndata_subject_requests_created_at_not_null: NOT NULL created_at\ndata_subject_requests_id_not_null: NOT NULL id\ndata_subject_requests_legal_representation_id_fkey: FOREIGN KEY (legal_representation_id) REFERENCES core.legal_representations(id) ON DELETE RESTRICT\ndata_subject_requests_request_type_not_null: NOT NULL request_type\ndata_subject_requests_status_not_null: NOT NULL status\ndata_subject_requests_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\ndata_subject_requests_subject_person_id_not_null: NOT NULL subject_person_id\ndata_subject_requests_submitted_at_not_null: NOT NULL submitted_at\ndata_subject_requests_submitted_by_account_id_fkey: FOREIGN KEY (submitted_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\ndata_subject_requests_submitted_by_account_id_not_null: NOT NULL submitted_by_account_id\ndata_subject_requests_submitted_by_person_id_fkey: FOREIGN KEY (submitted_by_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\ndata_subject_requests_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_dsar_actor_submitted ON core.data_subject_requests USING btree (submitted_by_account_id, submitted_at DESC)\nCREATE INDEX idx_dsar_status_submitted ON core.data_subject_requests USING btree (status, submitted_at DESC)\nCREATE INDEX idx_dsar_subject_submitted ON core.data_subject_requests USING btree (subject_person_id, submitted_at DESC)\nCREATE INDEX idx_dsar_type_status ON core.data_subject_requests USING btree (request_type, status)\nCREATE TRIGGER trg_dsar_actor BEFORE INSERT ON core.data_subject_requests FOR EACH ROW EXECUTE FUNCTION core.validate_dsar_insert()'
}

Table core.feature_flags {
  id uuid [pk, not null, default: `uuidv7()`]
  module_id uuid [null, note: 'Owner module; NULL means installation-wide flag.']
  code "character varying(160)" [not null]
  enabled boolean [not null, default: `false`]
  rollout_percent smallint [not null, default: `100`, note: 'Integer rollout percentage from 0 to 100.']
  config jsonb [not null, default: `'{}'::jsonb`]
  description text [null]
  updated_by_account_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    module_id [name: 'idx_feature_flags_module', type: btree]
    code [name: 'uq_feature_flags_code', type: btree, unique]
  }
  Note: 'Global or module-owned feature flags with percentage rollout.\nchk_feature_flags_code_format: CHECK (code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_feature_flags_code_not_blank: CHECK (btrim(code::text) <> \'\'::text)\nchk_feature_flags_description_text: CHECK (description IS NULL OR btrim(description) <> \'\'::text AND char_length(description) <= 1000 AND description !~ \'[[:cntrl:]]\'::text)\nchk_feature_flags_rollout: CHECK (rollout_percent >= 0 AND rollout_percent <= 100)\nfeature_flags_code_not_null: NOT NULL code\nfeature_flags_config_not_null: NOT NULL config\nfeature_flags_created_at_not_null: NOT NULL created_at\nfeature_flags_enabled_not_null: NOT NULL enabled\nfeature_flags_id_not_null: NOT NULL id\nfeature_flags_rollout_percent_not_null: NOT NULL rollout_percent\nfeature_flags_updated_at_not_null: NOT NULL updated_at\nfk_feature_flags_module: FOREIGN KEY (module_id) REFERENCES core.modules(id) ON DELETE CASCADE\nfk_feature_flags_updated_by: FOREIGN KEY (updated_by_account_id) REFERENCES core.accounts(id) ON DELETE SET NULL\nCREATE INDEX idx_feature_flags_module ON core.feature_flags USING btree (module_id)\nCREATE UNIQUE INDEX uq_feature_flags_code ON core.feature_flags USING btree (code)'
}

Table core.inbox_events {
  id bigint [pk, not null, note: 'PostgreSQL identity: d']
  event_id uuid [not null]
  consumer "character varying(180)" [not null, note: 'Stable unique code of the consuming handler.']
  status core.inbox_status [not null, default: `'received'::core.inbox_status`]
  attempts integer [not null, default: `0`]
  received_at "timestamp with time zone" [not null, default: `now()`]
  processed_at "timestamp with time zone" [null, note: 'Successful processing time.']
  locked_by "character varying(160)" [null]
  locked_until "timestamp with time zone" [null, note: 'Lease expiration for a consumer worker lock.']
  last_error text [null]
  indexes {
    (consumer, status) [name: 'idx_inbox_events_consumer_status', type: btree]
    (status, received_at) [name: 'idx_inbox_events_status_received', type: btree]
    (event_id, consumer) [name: 'uq_inbox_events_event_consumer', type: btree, unique]
  }
  Note: 'Consumer idempotency ledger. event_id + consumer is unique.\nchk_inbox_attempts: CHECK (attempts >= 0)\nchk_inbox_consumer_not_blank: CHECK (btrim(consumer::text) <> \'\'::text)\ninbox_events_attempts_not_null: NOT NULL attempts\ninbox_events_consumer_not_null: NOT NULL consumer\ninbox_events_event_id_not_null: NOT NULL event_id\ninbox_events_id_not_null: NOT NULL id\ninbox_events_received_at_not_null: NOT NULL received_at\ninbox_events_status_not_null: NOT NULL status\nCREATE INDEX idx_inbox_events_consumer_status ON core.inbox_events USING btree (consumer, status)\nCREATE INDEX idx_inbox_events_status_received ON core.inbox_events USING btree (status, received_at)\nCREATE UNIQUE INDEX uq_inbox_events_event_consumer ON core.inbox_events USING btree (event_id, consumer)'
}

Table core.legal_representation_scopes {
  representation_id uuid [not null]
  scope_code "character varying(120)" [not null]
  indexes {
    (representation_id, scope_code) [pk]
  }
  Note: 'chk_legal_rep_scope_code: CHECK (scope_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nlegal_representation_scopes_representation_id_fkey: FOREIGN KEY (representation_id) REFERENCES core.legal_representations(id) ON DELETE RESTRICT\nlegal_representation_scopes_representation_id_not_null: NOT NULL representation_id\nlegal_representation_scopes_scope_code_not_null: NOT NULL scope_code\nCREATE TRIGGER trg_legal_representation_scopes_protect BEFORE INSERT OR DELETE OR UPDATE ON core.legal_representation_scopes FOR EACH ROW EXECUTE FUNCTION core.protect_legal_representation_scope()'
}

Table core.legal_representations {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  representative_person_id uuid [not null]
  authority_type "character varying(120)" [not null]
  status "character varying(32)" [not null, default: `'declared'::character varying`]
  valid_from "timestamp with time zone" [not null]
  valid_until "timestamp with time zone" [null]
  verified_at "timestamp with time zone" [null]
  verified_by_account_id uuid [null]
  evidence_type "character varying(120)" [null]
  evidence_reference "character varying(512)" [null]
  evidence_sha256 bytea [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  revoked_at "timestamp with time zone" [null]
  revoked_by_account_id uuid [null]
  revocation_reason_code "character varying(120)" [null]
  indexes {
    (representative_person_id, status) [name: 'idx_legal_rep_representative', type: btree]
    (subject_person_id, status, valid_until) [name: 'idx_legal_rep_subject', type: btree]
  }
  Note: 'Verified generic authority to act for another Person; no scanned documents stored here.\nchk_legal_rep_distinct: CHECK (subject_person_id <> representative_person_id)\nchk_legal_rep_evidence_hash: CHECK (evidence_sha256 IS NULL OR octet_length(evidence_sha256) = 32)\nchk_legal_rep_revocation: CHECK ((status::text = \'revoked\'::text) = (revoked_at IS NOT NULL))\nchk_legal_rep_revocation_actor: CHECK ((revoked_at IS NULL) = (revoked_by_account_id IS NULL))\nchk_legal_rep_status: CHECK (status::text = ANY (ARRAY[\'declared\'::character varying, \'verification_pending\'::character varying, \'verified\'::character varying, \'revoked\'::character varying, \'expired\'::character varying, \'rejected\'::character varying]::text[]))\nchk_legal_rep_type: CHECK (authority_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_legal_rep_validity: CHECK (valid_until IS NULL OR valid_until >= valid_from)\nchk_legal_rep_verification: CHECK ((verified_at IS NULL) = (verified_by_account_id IS NULL))\nchk_legal_rep_verified_evidence: CHECK ((status::text <> ALL (ARRAY[\'verified\'::character varying, \'revoked\'::character varying, \'expired\'::character varying]::text[])) OR evidence_type IS NOT NULL AND (evidence_reference IS NOT NULL OR evidence_sha256 IS NOT NULL))\nchk_legal_rep_verified_status: CHECK ((status::text <> ALL (ARRAY[\'verified\'::character varying, \'revoked\'::character varying, \'expired\'::character varying]::text[])) OR verified_at IS NOT NULL)\nlegal_representations_authority_type_not_null: NOT NULL authority_type\nlegal_representations_created_at_not_null: NOT NULL created_at\nlegal_representations_id_not_null: NOT NULL id\nlegal_representations_representative_person_id_fkey: FOREIGN KEY (representative_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nlegal_representations_representative_person_id_not_null: NOT NULL representative_person_id\nlegal_representations_revoked_by_account_id_fkey: FOREIGN KEY (revoked_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nlegal_representations_status_not_null: NOT NULL status\nlegal_representations_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nlegal_representations_subject_person_id_not_null: NOT NULL subject_person_id\nlegal_representations_updated_at_not_null: NOT NULL updated_at\nlegal_representations_valid_from_not_null: NOT NULL valid_from\nlegal_representations_verified_by_account_id_fkey: FOREIGN KEY (verified_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nCREATE INDEX idx_legal_rep_representative ON core.legal_representations USING btree (representative_person_id, status)\nCREATE INDEX idx_legal_rep_subject ON core.legal_representations USING btree (subject_person_id, status, valid_until)\nCREATE TRIGGER trg_legal_representation_verification BEFORE UPDATE ON core.legal_representations FOR EACH ROW EXECUTE FUNCTION core.validate_legal_representation_verification()\nCREATE TRIGGER trg_legal_representations_protect BEFORE DELETE OR UPDATE ON core.legal_representations FOR EACH ROW EXECUTE FUNCTION core.protect_legal_representation()'
}

Table core.module_settings {
  id uuid [pk, not null, default: `uuidv7()`]
  module_id uuid [not null]
  setting_key "character varying(160)" [not null, note: 'Setting key unique inside a module.']
  value jsonb [not null, note: 'JSONB setting value. Do not put secrets here.']
  description text [null]
  updated_by_account_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (module_id, setting_key) [name: 'uq_module_settings_module_key', type: btree, unique]
  }
  Note: 'Non-secret settings of a specific module.\nchk_module_settings_description_text: CHECK (description IS NULL OR btrim(description) <> \'\'::text AND char_length(description) <= 1000 AND description !~ \'[[:cntrl:]]\'::text)\nchk_module_settings_key_format: CHECK (setting_key::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_module_settings_key_not_blank: CHECK (btrim(setting_key::text) <> \'\'::text)\nfk_module_settings_module: FOREIGN KEY (module_id) REFERENCES core.modules(id) ON DELETE CASCADE\nfk_module_settings_updated_by: FOREIGN KEY (updated_by_account_id) REFERENCES core.accounts(id) ON DELETE SET NULL\nmodule_settings_created_at_not_null: NOT NULL created_at\nmodule_settings_id_not_null: NOT NULL id\nmodule_settings_module_id_not_null: NOT NULL module_id\nmodule_settings_setting_key_not_null: NOT NULL setting_key\nmodule_settings_updated_at_not_null: NOT NULL updated_at\nmodule_settings_value_not_null: NOT NULL value\nCREATE UNIQUE INDEX uq_module_settings_module_key ON core.module_settings USING btree (module_id, setting_key)'
}

Table core.modules {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(100)" [not null, note: 'Stable module code, e.g. education, games, chat.']
  name "character varying(160)" [not null]
  description text [null]
  version "character varying(40)" [not null]
  settings_schema_version integer [not null, default: `1`, note: 'Version of module settings schema.']
  enabled boolean [not null, default: `false`]
  installed_at "timestamp with time zone" [not null, default: `now()`]
  enabled_at "timestamp with time zone" [null]
  disabled_at "timestamp with time zone" [null]
  indexes {
    enabled [name: 'idx_modules_enabled', type: btree]
    code [name: 'uq_modules_code', type: btree, unique]
  }
  Note: 'Registry of installed/known platform modules. Core knows metadata only, never module internals.\nchk_modules_code_format: CHECK (code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_modules_code_not_blank: CHECK (btrim(code::text) <> \'\'::text)\nchk_modules_name_not_blank: CHECK (btrim(name::text) <> \'\'::text)\nchk_modules_settings_schema_version: CHECK (settings_schema_version > 0)\nchk_modules_version_not_blank: CHECK (btrim(version::text) <> \'\'::text)\nmodules_code_not_null: NOT NULL code\nmodules_enabled_not_null: NOT NULL enabled\nmodules_id_not_null: NOT NULL id\nmodules_installed_at_not_null: NOT NULL installed_at\nmodules_name_not_null: NOT NULL name\nmodules_settings_schema_version_not_null: NOT NULL settings_schema_version\nmodules_version_not_null: NOT NULL version\nCREATE INDEX idx_modules_enabled ON core.modules USING btree (enabled)\nCREATE UNIQUE INDEX uq_modules_code ON core.modules USING btree (code)'
}

Table core.organization_memberships {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  person_id uuid [not null]
  status "character varying(20)" [not null, default: `'active'::character varying`]
  joined_at "timestamp with time zone" [not null, default: `now()`]
  left_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (person_id, organization_id) [name: 'idx_organization_memberships_person', type: btree]
  }
  Note: 'chk_memberships_dates: CHECK (left_at IS NULL OR left_at >= joined_at)\nchk_memberships_left: CHECK ((status::text = \'left\'::text) = (left_at IS NOT NULL))\norganization_memberships_created_at_not_null: NOT NULL created_at\norganization_memberships_id_not_null: NOT NULL id\norganization_memberships_joined_at_not_null: NOT NULL joined_at\norganization_memberships_organization_id_fkey: FOREIGN KEY (organization_id) REFERENCES core.organizations(id) ON DELETE RESTRICT\norganization_memberships_organization_id_not_null: NOT NULL organization_id\norganization_memberships_person_id_fkey: FOREIGN KEY (person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\norganization_memberships_person_id_not_null: NOT NULL person_id\norganization_memberships_status_check: CHECK (status::text = ANY (ARRAY[\'active\'::character varying, \'left\'::character varying]::text[]))\norganization_memberships_status_not_null: NOT NULL status\norganization_memberships_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_organization_memberships_person ON core.organization_memberships USING btree (person_id, organization_id)\nCREATE UNIQUE INDEX uq_organization_memberships_active ON core.organization_memberships USING btree (organization_id, person_id) WHERE ((status)::text = \'active\'::text)'
}

Table core.organizations {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(120)" [not null]
  name "character varying(255)" [not null]
  status "character varying(20)" [not null, default: `'active'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  archived_at "timestamp with time zone" [null]
  indexes {
    code [name: 'organizations_code_key', type: btree, unique]
  }
  Note: 'chk_organizations_archive: CHECK ((status::text = \'archived\'::text) = (archived_at IS NOT NULL))\norganizations_code_check: CHECK (code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\norganizations_code_key: UNIQUE (code)\norganizations_code_not_null: NOT NULL code\norganizations_created_at_not_null: NOT NULL created_at\norganizations_id_not_null: NOT NULL id\norganizations_name_check: CHECK (btrim(name::text) <> \'\'::text)\norganizations_name_not_null: NOT NULL name\norganizations_status_check: CHECK (status::text = ANY (ARRAY[\'active\'::character varying, \'suspended\'::character varying, \'archived\'::character varying]::text[]))\norganizations_status_not_null: NOT NULL status\norganizations_updated_at_not_null: NOT NULL updated_at\nCREATE UNIQUE INDEX organizations_code_key ON core.organizations USING btree (code)'
}

Table core.outbox_events {
  id bigint [pk, not null, note: 'PostgreSQL identity: d']
  event_id uuid [not null, default: `uuidv7()`]
  producer_module "character varying(100)" [not null, note: 'Module that produced the event.']
  event_type "character varying(220)" [not null, note: 'Stable namespaced event type.']
  aggregate_type "character varying(160)" [null]
  aggregate_id "character varying(160)" [null]
  payload jsonb [not null]
  headers jsonb [not null, default: `'{}'::jsonb`]
  correlation_id uuid [null]
  causation_id uuid [null]
  status core.outbox_status [not null, default: `'pending'::core.outbox_status`]
  attempts integer [not null, default: `0`]
  occurred_at "timestamp with time zone" [not null, default: `now()`]
  available_at "timestamp with time zone" [not null, default: `now()`, note: 'Earliest time the publisher worker may attempt delivery.']
  published_at "timestamp with time zone" [null]
  locked_by "character varying(160)" [null]
  locked_until "timestamp with time zone" [null, note: 'Lease expiration for a worker lock.']
  last_error text [null]
  indexes {
    (aggregate_type, aggregate_id) [name: 'idx_outbox_events_aggregate', type: btree]
    correlation_id [name: 'idx_outbox_events_correlation', type: btree]
    (status, available_at) [name: 'idx_outbox_events_dispatch', type: btree]
    event_id [name: 'uq_outbox_events_event', type: btree, unique]
  }
  Note: 'Transactional Outbox. Business state and outbox event must be committed in one PostgreSQL transaction.\nchk_outbox_attempts: CHECK (attempts >= 0)\nchk_outbox_event_type_not_blank: CHECK (btrim(event_type::text) <> \'\'::text)\nchk_outbox_producer_not_blank: CHECK (btrim(producer_module::text) <> \'\'::text)\noutbox_events_attempts_not_null: NOT NULL attempts\noutbox_events_available_at_not_null: NOT NULL available_at\noutbox_events_event_id_not_null: NOT NULL event_id\noutbox_events_event_type_not_null: NOT NULL event_type\noutbox_events_headers_not_null: NOT NULL headers\noutbox_events_id_not_null: NOT NULL id\noutbox_events_occurred_at_not_null: NOT NULL occurred_at\noutbox_events_payload_not_null: NOT NULL payload\noutbox_events_producer_module_not_null: NOT NULL producer_module\noutbox_events_status_not_null: NOT NULL status\nCREATE INDEX idx_outbox_events_aggregate ON core.outbox_events USING btree (aggregate_type, aggregate_id)\nCREATE INDEX idx_outbox_events_correlation ON core.outbox_events USING btree (correlation_id)\nCREATE INDEX idx_outbox_events_dispatch ON core.outbox_events USING btree (status, available_at)\nCREATE UNIQUE INDEX uq_outbox_events_event ON core.outbox_events USING btree (event_id)'
}

Table core.permissions {
  id uuid [pk, not null, default: `uuidv7()`]
  module_id uuid [null, note: 'Permission -> Module. NULL means permission belongs to Core itself.']
  code "character varying(180)" [not null, note: 'Globally unique namespaced permission code.']
  name "character varying(180)" [not null]
  description text [null]
  is_system boolean [not null, default: `false`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    module_id [name: 'idx_permissions_module', type: btree]
    code [name: 'uq_permissions_code', type: btree, unique]
  }
  Note: 'Global catalog of RBAC permission codes.\nchk_permissions_code_format: CHECK (code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_permissions_code_not_blank: CHECK (btrim(code::text) <> \'\'::text)\nchk_permissions_name_not_blank: CHECK (btrim(name::text) <> \'\'::text)\nfk_permissions_module: FOREIGN KEY (module_id) REFERENCES core.modules(id) ON DELETE SET NULL\npermissions_code_not_null: NOT NULL code\npermissions_created_at_not_null: NOT NULL created_at\npermissions_id_not_null: NOT NULL id\npermissions_is_system_not_null: NOT NULL is_system\npermissions_name_not_null: NOT NULL name\npermissions_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_permissions_module ON core.permissions USING btree (module_id)\nCREATE UNIQUE INDEX uq_permissions_code ON core.permissions USING btree (code)'
}

Table core.person_contacts {
  id uuid [pk, not null, default: `uuidv7()`]
  person_id uuid [not null, note: 'Child -> parent: person_contacts.person_id -> persons.id.']
  contact_type core.contact_type [not null, note: 'Contact type: email or phone.']
  value "character varying(320)" [not null, note: 'Original/display value.']
  normalized_value "character varying(320)" [not null, note: 'Normalized value used for comparison/search.']
  label "character varying(80)" [null]
  is_primary boolean [not null, default: `false`, note: 'Marks the primary contact of a given type for the Person.']
  verified_at "timestamp with time zone" [null, note: 'Verification time; NULL means unverified.']
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    normalized_value [name: 'idx_person_contacts_normalized', type: btree]
    (person_id, contact_type) [name: 'idx_person_contacts_person_type', type: btree]
    (person_id, contact_type, normalized_value) [name: 'uq_person_contacts_value', type: btree, unique]
  }
  Note: 'Contacts of a physical Person. These are not Account login identifiers.\nchk_person_contacts_label_not_blank: CHECK (label IS NULL OR btrim(label::text) <> \'\'::text AND label::text !~ \'[[:cntrl:]]\'::text)\nchk_person_contacts_normalized_email: CHECK (contact_type <> \'email\'::core.contact_type OR normalized_value::text ~~ \'%@%\'::text AND normalized_value::text = lower(normalized_value::text))\nchk_person_contacts_normalized_not_blank: CHECK (btrim(normalized_value::text) <> \'\'::text)\nchk_person_contacts_normalized_phone: CHECK (contact_type <> \'phone\'::core.contact_type OR normalized_value::text ~ \'^\\+[1-9][0-9]{7,14}$\'::text)\nchk_person_contacts_value_not_blank: CHECK (btrim(value::text) <> \'\'::text)\nfk_person_contacts_person: FOREIGN KEY (person_id) REFERENCES core.persons(id) ON DELETE CASCADE\nperson_contacts_contact_type_not_null: NOT NULL contact_type\nperson_contacts_created_at_not_null: NOT NULL created_at\nperson_contacts_id_not_null: NOT NULL id\nperson_contacts_is_primary_not_null: NOT NULL is_primary\nperson_contacts_normalized_value_not_null: NOT NULL normalized_value\nperson_contacts_person_id_not_null: NOT NULL person_id\nperson_contacts_updated_at_not_null: NOT NULL updated_at\nperson_contacts_value_not_null: NOT NULL value\nCREATE INDEX idx_person_contacts_normalized ON core.person_contacts USING btree (normalized_value)\nCREATE INDEX idx_person_contacts_person_type ON core.person_contacts USING btree (person_id, contact_type)\nCREATE UNIQUE INDEX uq_person_contacts_primary_per_type ON core.person_contacts USING btree (person_id, contact_type) WHERE (is_primary = true)\nCREATE UNIQUE INDEX uq_person_contacts_value ON core.person_contacts USING btree (person_id, contact_type, normalized_value)'
}

Table core.persons {
  id uuid [pk, not null, default: `uuidv7()`, note: 'UUIDv7 primary key of the physical person.']
  status core.person_status [not null, default: `'active'::core.person_status`, note: 'Person lifecycle status: active, inactive, archived.']
  given_name "character varying(120)" [not null, note: 'First/given name.']
  family_name "character varying(120)" [not null, note: 'Family/last name.']
  middle_name "character varying(120)" [null, note: 'Optional middle/patronymic name.']
  display_name "character varying(255)" [null, note: 'Optional preformatted display name for UI.']
  birth_date date [null, note: 'Birth date without time.']
  created_at "timestamp with time zone" [not null, default: `now()`, note: 'Creation timestamp.']
  updated_at "timestamp with time zone" [not null, default: `now()`, note: 'Last update timestamp; application-managed for now.']
  archived_at "timestamp with time zone" [null, note: 'Archive timestamp; NULL means not archived.']
  indexes {
    birth_date [name: 'idx_persons_birth_date', type: btree]
    (family_name, given_name) [name: 'idx_persons_name', type: btree]
    status [name: 'idx_persons_status', type: btree]
  }
  Note: 'Physical individuals separated from accounts. Core v1 base table (1 of 23). Data hygiene constraints applied.\nchk_persons_birth_date_bounds: CHECK (birth_date IS NULL OR birth_date <= CURRENT_DATE AND birth_date >= \'1900-01-01\'::date)\nchk_persons_display_name_not_blank: CHECK (display_name IS NULL OR btrim(display_name::text) <> \'\'::text)\nchk_persons_family_name_not_blank: CHECK (btrim(family_name::text) <> \'\'::text)\nchk_persons_given_name_not_blank: CHECK (btrim(given_name::text) <> \'\'::text)\nchk_persons_middle_name_not_blank: CHECK (middle_name IS NULL OR btrim(middle_name::text) <> \'\'::text)\npersons_created_at_not_null: NOT NULL created_at\npersons_family_name_not_null: NOT NULL family_name\npersons_given_name_not_null: NOT NULL given_name\npersons_id_not_null: NOT NULL id\npersons_status_not_null: NOT NULL status\npersons_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_persons_birth_date ON core.persons USING btree (birth_date)\nCREATE INDEX idx_persons_name ON core.persons USING btree (family_name, given_name)\nCREATE INDEX idx_persons_status ON core.persons USING btree (status)'
}

Table core.privacy_cleanup_runs {
  id uuid [pk, not null, default: `uuidv7()`]
  category_code "character varying(120)" [not null]
  deleted_count integer [not null]
  policy_days integer [null]
  executed_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'privacy_cleanup_runs_category_code_check: CHECK (category_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_cleanup_runs_category_code_not_null: NOT NULL category_code\nprivacy_cleanup_runs_deleted_count_check: CHECK (deleted_count >= 0)\nprivacy_cleanup_runs_deleted_count_not_null: NOT NULL deleted_count\nprivacy_cleanup_runs_executed_at_not_null: NOT NULL executed_at\nprivacy_cleanup_runs_id_not_null: NOT NULL id'
}

Table core.privacy_collection_notices {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  purpose_code "character varying(120)" [not null]
  category_codes "text[]" [not null]
  source_code "character varying(120)" [not null]
  collected_at "timestamp with time zone" [not null]
  notice_required boolean [not null]
  exemption_code "character varying(120)" [null]
  notice_issued_at "timestamp with time zone" [null]
  notice_evidence_reference "character varying(500)" [null]
  created_by_account_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (subject_person_id, collected_at) [name: 'privacy_collection_notices_subject_idx', type: btree]
  }
  Note: 'collection_notice_codes: CHECK (purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND source_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND (exemption_code IS NULL OR exemption_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text))\ncollection_notice_exemption: CHECK (notice_required AND exemption_code IS NULL OR NOT notice_required AND exemption_code IS NOT NULL)\ncollection_notice_issued: CHECK (notice_issued_at IS NULL AND notice_evidence_reference IS NULL OR notice_required AND notice_issued_at IS NOT NULL AND length(btrim(notice_evidence_reference::text)) > 0)\nprivacy_collection_notices_category_codes_check: CHECK (cardinality(category_codes) > 0)\nprivacy_collection_notices_category_codes_not_null: NOT NULL category_codes\nprivacy_collection_notices_collected_at_not_null: NOT NULL collected_at\nprivacy_collection_notices_created_at_not_null: NOT NULL created_at\nprivacy_collection_notices_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_collection_notices_created_by_account_id_not_null: NOT NULL created_by_account_id\nprivacy_collection_notices_id_not_null: NOT NULL id\nprivacy_collection_notices_notice_required_not_null: NOT NULL notice_required\nprivacy_collection_notices_purpose_code_not_null: NOT NULL purpose_code\nprivacy_collection_notices_source_code_not_null: NOT NULL source_code\nprivacy_collection_notices_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_collection_notices_subject_person_id_not_null: NOT NULL subject_person_id\nCREATE INDEX privacy_collection_notices_subject_idx ON core.privacy_collection_notices USING btree (subject_person_id, collected_at DESC)'
}

Table core.privacy_consents {
  id uuid [pk, not null, default: `uuidv7()`]
  granted_by_account_id uuid [not null]
  consent_code "character varying(120)" [not null]
  document_version "character varying(80)" [not null]
  document_sha256 bytea [not null]
  locale "character varying(35)" [not null]
  source "character varying(80)" [not null]
  granted_at "timestamp with time zone" [not null, default: `now()`]
  withdrawn_at "timestamp with time zone" [null]
  request_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  subject_person_id uuid [null]
  granted_by_person_id uuid [null]
  legal_representation_id uuid [null]
  purpose_code "character varying(120)" [null]
  retention_until "timestamp with time zone" [null]
  legacy_record boolean [not null, default: `false`]
  indexes {
    (granted_by_account_id, consent_code, granted_at, id) [name: 'idx_account_consents_history', type: btree]
    (granted_by_account_id, granted_at, id) [name: 'idx_privacy_consents_actor_history', type: btree]
    (subject_person_id, granted_at, id) [name: 'idx_privacy_consents_subject_history', type: btree]
  }
  Note: 'Subject and actor consent evidence; migration 018 rows remain flagged as unclassified legacy evidence.\naccount_consents_account_id_fkey: FOREIGN KEY (granted_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\naccount_consents_account_id_not_null: NOT NULL granted_by_account_id\naccount_consents_consent_code_not_null: NOT NULL consent_code\naccount_consents_created_at_not_null: NOT NULL created_at\naccount_consents_document_sha256_not_null: NOT NULL document_sha256\naccount_consents_document_version_not_null: NOT NULL document_version\naccount_consents_granted_at_not_null: NOT NULL granted_at\naccount_consents_id_not_null: NOT NULL id\naccount_consents_locale_not_null: NOT NULL locale\naccount_consents_source_not_null: NOT NULL source\nchk_account_consents_code: CHECK (consent_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_account_consents_hash: CHECK (octet_length(document_sha256) = 32)\nchk_account_consents_locale: CHECK (locale::text ~ \'^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$\'::text)\nchk_account_consents_source: CHECK (source::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_account_consents_version: CHECK (btrim(document_version::text) <> \'\'::text AND document_version::text !~ \'[[:cntrl:]]\'::text)\nchk_account_consents_withdrawal: CHECK (withdrawn_at IS NULL OR withdrawn_at >= granted_at)\nchk_privacy_consent_purpose: CHECK (purpose_code IS NULL OR purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_privacy_consent_retention: CHECK (retention_until IS NULL OR retention_until >= granted_at)\nchk_privacy_consent_subject_actor: CHECK (legacy_record OR subject_person_id IS NOT NULL AND granted_by_person_id IS NOT NULL AND purpose_code IS NOT NULL AND (subject_person_id = granted_by_person_id AND legal_representation_id IS NULL OR subject_person_id <> granted_by_person_id AND legal_representation_id IS NOT NULL))\nprivacy_consents_granted_by_person_id_fkey: FOREIGN KEY (granted_by_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_consents_legacy_record_not_null: NOT NULL legacy_record\nprivacy_consents_legal_representation_id_fkey: FOREIGN KEY (legal_representation_id) REFERENCES core.legal_representations(id) ON DELETE RESTRICT\nprivacy_consents_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nCREATE INDEX idx_account_consents_history ON core.privacy_consents USING btree (granted_by_account_id, consent_code, granted_at DESC, id DESC)\nCREATE INDEX idx_privacy_consents_actor_history ON core.privacy_consents USING btree (granted_by_account_id, granted_at DESC, id DESC)\nCREATE INDEX idx_privacy_consents_subject_history ON core.privacy_consents USING btree (subject_person_id, granted_at DESC, id DESC)\nCREATE UNIQUE INDEX uq_privacy_consents_one_active ON core.privacy_consents USING btree (subject_person_id, consent_code, purpose_code) WHERE ((withdrawn_at IS NULL) AND (legacy_record = false))\nCREATE TRIGGER trg_privacy_consent_validate_insert BEFORE INSERT ON core.privacy_consents FOR EACH ROW EXECUTE FUNCTION core.validate_privacy_consent_insert()\nCREATE TRIGGER trg_privacy_consents_protect BEFORE DELETE OR UPDATE ON core.privacy_consents FOR EACH ROW EXECUTE FUNCTION core.protect_privacy_consent()'
}

Table core.privacy_destruction_evidence {
  id uuid [pk, not null, default: `uuidv7()`]
  case_id uuid [not null]
  item_id uuid [not null]
  resource_type "character varying(120)" [not null]
  resource_reference_hash character(64) [not null]
  policy_code "character varying(120)" [not null]
  evidence_policy_code "character varying(120)" [not null]
  evidence_retain_until "timestamp with time zone" [not null]
  action "character varying(24)" [not null]
  result "character varying(24)" [not null]
  executed_at "timestamp with time zone" [not null]
  executor_account_id uuid [null]
  journal_event_id uuid [not null]
  indexes {
    (case_id, executed_at, id) [name: 'idx_destruction_evidence_case', type: btree]
    item_id [name: 'privacy_destruction_evidence_item_id_key', type: btree, unique]
  }
  Note: 'chk_destruction_codes: CHECK (resource_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND policy_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND evidence_policy_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_destruction_evidence_action_check: CHECK (action::text = ANY (ARRAY[\'delete\'::character varying, \'anonymize\'::character varying, \'pseudonymize\'::character varying, \'custom\'::character varying]::text[]))\nprivacy_destruction_evidence_action_not_null: NOT NULL action\nprivacy_destruction_evidence_case_id_fkey: FOREIGN KEY (case_id) REFERENCES core.privacy_erasure_cases(id) ON DELETE RESTRICT\nprivacy_destruction_evidence_case_id_not_null: NOT NULL case_id\nprivacy_destruction_evidence_evidence_policy_code_not_null: NOT NULL evidence_policy_code\nprivacy_destruction_evidence_evidence_retain_until_not_null: NOT NULL evidence_retain_until\nprivacy_destruction_evidence_executed_at_not_null: NOT NULL executed_at\nprivacy_destruction_evidence_executor_account_id_fkey: FOREIGN KEY (executor_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_destruction_evidence_id_not_null: NOT NULL id\nprivacy_destruction_evidence_item_id_fkey: FOREIGN KEY (item_id) REFERENCES core.privacy_erasure_items(id) ON DELETE RESTRICT\nprivacy_destruction_evidence_item_id_key: UNIQUE (item_id)\nprivacy_destruction_evidence_item_id_not_null: NOT NULL item_id\nprivacy_destruction_evidence_journal_event_id_not_null: NOT NULL journal_event_id\nprivacy_destruction_evidence_policy_code_not_null: NOT NULL policy_code\nprivacy_destruction_evidence_resource_reference_hash_check: CHECK (resource_reference_hash ~ \'^[a-f0-9]{64}$\'::text)\nprivacy_destruction_evidence_resource_reference_hash_not_null: NOT NULL resource_reference_hash\nprivacy_destruction_evidence_resource_type_not_null: NOT NULL resource_type\nprivacy_destruction_evidence_result_check: CHECK (result::text = ANY (ARRAY[\'deleted\'::character varying, \'anonymized\'::character varying, \'pseudonymized\'::character varying, \'custom_completed\'::character varying]::text[]))\nprivacy_destruction_evidence_result_not_null: NOT NULL result\nCREATE INDEX idx_destruction_evidence_case ON core.privacy_destruction_evidence USING btree (case_id, executed_at, id)\nCREATE UNIQUE INDEX privacy_destruction_evidence_item_id_key ON core.privacy_destruction_evidence USING btree (item_id)\nCREATE TRIGGER trg_privacy_destruction_evidence_protect BEFORE DELETE OR UPDATE ON core.privacy_destruction_evidence FOR EACH ROW EXECUTE FUNCTION core.protect_privacy_destruction_evidence()'
}

Table core.privacy_distribution_consents {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  granted_by_person_id uuid [not null]
  granted_by_account_id uuid [not null]
  legal_representation_id uuid [null]
  purpose_code "character varying(120)" [not null]
  category_codes "text[]" [not null]
  field_codes "text[]" [not null]
  condition_codes "text[]" [not null, default: `'{}'::text[]`]
  restriction_codes "text[]" [not null, default: `'{}'::text[]`]
  document_version "character varying(80)" [not null]
  document_sha256 character(64) [not null]
  granted_at "timestamp with time zone" [not null]
  withdrawn_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (subject_person_id, purpose_code, granted_at) [name: 'idx_distribution_consent_subject', type: btree]
  }
  Note: 'chk_distribution_actor: CHECK (subject_person_id = granted_by_person_id AND legal_representation_id IS NULL OR subject_person_id <> granted_by_person_id AND legal_representation_id IS NOT NULL)\nchk_distribution_codes: CHECK (array_to_string(category_codes, \',\'::text) ~ \'^[a-z0-9.,_-]+$\'::text AND array_to_string(field_codes, \',\'::text) ~ \'^[a-z0-9.,_-]+$\'::text AND (cardinality(condition_codes) = 0 OR array_to_string(condition_codes, \',\'::text) ~ \'^[a-z0-9.,_-]+$\'::text) AND (cardinality(restriction_codes) = 0 OR array_to_string(restriction_codes, \',\'::text) ~ \'^[a-z0-9.,_-]+$\'::text))\nchk_distribution_withdrawal: CHECK (withdrawn_at IS NULL OR withdrawn_at >= granted_at)\nprivacy_distribution_consents_category_codes_check: CHECK (cardinality(category_codes) >= 1 AND cardinality(category_codes) <= 32)\nprivacy_distribution_consents_category_codes_not_null: NOT NULL category_codes\nprivacy_distribution_consents_condition_codes_not_null: NOT NULL condition_codes\nprivacy_distribution_consents_created_at_not_null: NOT NULL created_at\nprivacy_distribution_consents_document_sha256_check: CHECK (document_sha256 ~ \'^[a-f0-9]{64}$\'::text)\nprivacy_distribution_consents_document_sha256_not_null: NOT NULL document_sha256\nprivacy_distribution_consents_document_version_not_null: NOT NULL document_version\nprivacy_distribution_consents_field_codes_check: CHECK (cardinality(field_codes) >= 1 AND cardinality(field_codes) <= 64)\nprivacy_distribution_consents_field_codes_not_null: NOT NULL field_codes\nprivacy_distribution_consents_granted_at_not_null: NOT NULL granted_at\nprivacy_distribution_consents_granted_by_account_id_fkey: FOREIGN KEY (granted_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_distribution_consents_granted_by_account_id_not_null: NOT NULL granted_by_account_id\nprivacy_distribution_consents_granted_by_person_id_fkey: FOREIGN KEY (granted_by_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_distribution_consents_granted_by_person_id_not_null: NOT NULL granted_by_person_id\nprivacy_distribution_consents_id_not_null: NOT NULL id\nprivacy_distribution_consents_legal_representation_id_fkey: FOREIGN KEY (legal_representation_id) REFERENCES core.legal_representations(id) ON DELETE RESTRICT\nprivacy_distribution_consents_purpose_code_check: CHECK (purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_distribution_consents_purpose_code_not_null: NOT NULL purpose_code\nprivacy_distribution_consents_restriction_codes_not_null: NOT NULL restriction_codes\nprivacy_distribution_consents_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_distribution_consents_subject_person_id_not_null: NOT NULL subject_person_id\nCREATE INDEX idx_distribution_consent_subject ON core.privacy_distribution_consents USING btree (subject_person_id, purpose_code, granted_at DESC)\nCREATE TRIGGER trg_privacy_distribution_consent_protect BEFORE DELETE OR UPDATE ON core.privacy_distribution_consents FOR EACH ROW EXECUTE FUNCTION core.protect_privacy_distribution_consent()'
}

Table core.privacy_erasure_cases {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  source_request_id uuid [null]
  reason_code "character varying(120)" [not null]
  status "character varying(32)" [not null]
  created_at "timestamp with time zone" [not null]
  started_at "timestamp with time zone" [null]
  completed_at "timestamp with time zone" [null]
  updated_at "timestamp with time zone" [not null]
  created_by_account_id uuid [not null]
  indexes {
    (status, updated_at) [name: 'idx_erasure_cases_status', type: btree]
    (subject_person_id, created_at) [name: 'idx_erasure_cases_subject', type: btree]
    source_request_id [name: 'privacy_erasure_cases_source_request_id_key', type: btree, unique]
  }
  Note: 'chk_erasure_case_complete: CHECK ((status::text = \'completed\'::text) = (completed_at IS NOT NULL))\nchk_erasure_case_time: CHECK (started_at IS NULL OR started_at >= created_at)\nprivacy_erasure_cases_created_at_not_null: NOT NULL created_at\nprivacy_erasure_cases_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_erasure_cases_created_by_account_id_not_null: NOT NULL created_by_account_id\nprivacy_erasure_cases_id_not_null: NOT NULL id\nprivacy_erasure_cases_reason_code_check: CHECK (reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_erasure_cases_reason_code_not_null: NOT NULL reason_code\nprivacy_erasure_cases_source_request_id_fkey: FOREIGN KEY (source_request_id) REFERENCES core.data_subject_requests(id) ON DELETE RESTRICT\nprivacy_erasure_cases_source_request_id_key: UNIQUE (source_request_id)\nprivacy_erasure_cases_status_check: CHECK (status::text = ANY (ARRAY[\'planned\'::character varying, \'in_progress\'::character varying, \'partially_completed\'::character varying, \'completed\'::character varying, \'blocked\'::character varying, \'failed\'::character varying]::text[]))\nprivacy_erasure_cases_status_not_null: NOT NULL status\nprivacy_erasure_cases_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_erasure_cases_subject_person_id_not_null: NOT NULL subject_person_id\nprivacy_erasure_cases_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_erasure_cases_status ON core.privacy_erasure_cases USING btree (status, updated_at)\nCREATE INDEX idx_erasure_cases_subject ON core.privacy_erasure_cases USING btree (subject_person_id, created_at DESC)\nCREATE UNIQUE INDEX privacy_erasure_cases_source_request_id_key ON core.privacy_erasure_cases USING btree (source_request_id)'
}

Table core.privacy_erasure_item_purposes {
  item_id uuid [not null]
  purpose_code "character varying(120)" [not null]
  policy_code "character varying(120)" [not null]
  trigger_code "character varying(120)" [not null]
