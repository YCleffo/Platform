  Note: 'chk_privacy_block_codes: CHECK (reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND (purpose_code IS NULL OR purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (resource_type IS NULL OR resource_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (release_reason_code IS NULL OR release_reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text))\nchk_privacy_block_release: CHECK (released_at IS NULL AND released_by_account_id IS NULL AND release_reason_code IS NULL OR released_at IS NOT NULL AND released_by_account_id IS NOT NULL AND release_reason_code IS NOT NULL AND released_at >= started_at)\nchk_privacy_block_scope: CHECK (scope_type::text = \'subject\'::text AND purpose_code IS NULL AND resource_type IS NULL AND resource_id IS NULL OR scope_type::text = \'purpose\'::text AND purpose_code IS NOT NULL AND resource_type IS NULL AND resource_id IS NULL OR scope_type::text = \'resource\'::text AND resource_type IS NOT NULL AND resource_id IS NOT NULL)\nchk_privacy_block_time: CHECK (expires_at IS NULL OR expires_at > started_at)\nprivacy_processing_blocks_created_at_not_null: NOT NULL created_at\nprivacy_processing_blocks_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_processing_blocks_id_not_null: NOT NULL id\nprivacy_processing_blocks_reason_code_not_null: NOT NULL reason_code\nprivacy_processing_blocks_released_by_account_id_fkey: FOREIGN KEY (released_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_processing_blocks_scope_type_not_null: NOT NULL scope_type\nprivacy_processing_blocks_source_request_id_fkey: FOREIGN KEY (source_request_id) REFERENCES core.data_subject_requests(id) ON DELETE RESTRICT\nprivacy_processing_blocks_started_at_not_null: NOT NULL started_at\nprivacy_processing_blocks_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_processing_blocks_subject_person_id_not_null: NOT NULL subject_person_id\nCREATE INDEX idx_privacy_blocks_request ON core.privacy_processing_blocks USING btree (source_request_id)\nCREATE INDEX idx_privacy_blocks_subject_active ON core.privacy_processing_blocks USING btree (subject_person_id) WHERE (released_at IS NULL)\nCREATE TRIGGER trg_privacy_block_request BEFORE INSERT ON core.privacy_processing_blocks FOR EACH ROW EXECUTE FUNCTION core.validate_privacy_block_request()'
}

Table core.privacy_retention_decisions {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [not null]
  resource_type "character varying(120)" [not null]
  resource_id uuid [not null]
  purpose_code "character varying(120)" [not null]
  policy_code "character varying(120)" [not null]
  decision_code "character varying(120)" [not null]
  trigger_code "character varying(120)" [not null]
  triggered_at "timestamp with time zone" [null]
  eligible_at "timestamp with time zone" [null]
  legal_hold_id uuid [null]
  source_request_id uuid [null]
  evaluated_at "timestamp with time zone" [not null]
  evaluator_version "character varying(40)" [not null]
  indexes {
    (resource_type, resource_id, evaluated_at) [name: 'idx_privacy_retention_resource', type: btree]
    (subject_person_id, evaluated_at) [name: 'idx_privacy_retention_subject', type: btree]
  }
  Note: 'chk_privacy_retention_codes: CHECK (resource_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND policy_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND trigger_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND (decision_code::text = ANY (ARRAY[\'retain\'::character varying, \'not_yet_eligible\'::character varying, \'eligible_delete\'::character varying, \'eligible_anonymize\'::character varying, \'eligible_pseudonymize\'::character varying, \'eligible_custom\'::character varying, \'blocked_by_legal_hold\'::character varying, \'blocked_by_active_basis\'::character varying, \'blocked_by_missing_policy\'::character varying, \'blocked_by_unknown_basis\'::character varying, \'blocked_by_dependency\'::character varying]::text[])))\nprivacy_retention_decisions_decision_code_not_null: NOT NULL decision_code\nprivacy_retention_decisions_evaluated_at_not_null: NOT NULL evaluated_at\nprivacy_retention_decisions_evaluator_version_not_null: NOT NULL evaluator_version\nprivacy_retention_decisions_id_not_null: NOT NULL id\nprivacy_retention_decisions_legal_hold_id_fkey: FOREIGN KEY (legal_hold_id) REFERENCES core.privacy_legal_holds(id) ON DELETE RESTRICT\nprivacy_retention_decisions_policy_code_not_null: NOT NULL policy_code\nprivacy_retention_decisions_purpose_code_not_null: NOT NULL purpose_code\nprivacy_retention_decisions_resource_id_not_null: NOT NULL resource_id\nprivacy_retention_decisions_resource_type_not_null: NOT NULL resource_type\nprivacy_retention_decisions_source_request_id_fkey: FOREIGN KEY (source_request_id) REFERENCES core.data_subject_requests(id) ON DELETE RESTRICT\nprivacy_retention_decisions_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nprivacy_retention_decisions_subject_person_id_not_null: NOT NULL subject_person_id\nprivacy_retention_decisions_trigger_code_not_null: NOT NULL trigger_code\nCREATE INDEX idx_privacy_retention_resource ON core.privacy_retention_decisions USING btree (resource_type, resource_id, evaluated_at DESC)\nCREATE INDEX idx_privacy_retention_subject ON core.privacy_retention_decisions USING btree (subject_person_id, evaluated_at DESC)\nCREATE TRIGGER trg_privacy_retention_decision_protect BEFORE DELETE OR UPDATE ON core.privacy_retention_decisions FOR EACH ROW EXECUTE FUNCTION core.protect_privacy_retention_decision()'
}

Table core.role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]
  granted_at "timestamp with time zone" [not null, default: `now()`]
  granted_by_account_id uuid [null, note: 'Account that granted the permission; NULL for seed/system operation.']
  indexes {
    (role_id, permission_id) [pk]
    permission_id [name: 'idx_role_permissions_permission', type: btree]
  }
  Note: 'Many-to-many relation Role <-> Permission.\nfk_role_permissions_granted_by: FOREIGN KEY (granted_by_account_id) REFERENCES core.accounts(id) ON DELETE SET NULL\nfk_role_permissions_permission: FOREIGN KEY (permission_id) REFERENCES core.permissions(id) ON DELETE CASCADE\nfk_role_permissions_role: FOREIGN KEY (role_id) REFERENCES core.roles(id) ON DELETE CASCADE\nrole_permissions_granted_at_not_null: NOT NULL granted_at\nrole_permissions_permission_id_not_null: NOT NULL permission_id\nrole_permissions_role_id_not_null: NOT NULL role_id\nCREATE INDEX idx_role_permissions_permission ON core.role_permissions USING btree (permission_id)'
}

Table core.roles {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(120)" [not null, note: 'Stable namespaced role code, e.g. core.superadmin.']
  name "character varying(160)" [not null]
  description text [null]
  is_system boolean [not null, default: `false`, note: 'Role is system-provided.']
  is_protected boolean [not null, default: `false`, note: 'Ordinary management flows must not remove/alter protected roles freely.']
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    is_system [name: 'idx_roles_system', type: btree]
    code [name: 'uq_roles_code', type: btree, unique]
  }
  Note: 'RBAC roles. A role is a bundle of permissions, not a separate Admin entity.\nchk_roles_code_format: CHECK (code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_roles_code_not_blank: CHECK (btrim(code::text) <> \'\'::text)\nchk_roles_name_not_blank: CHECK (btrim(name::text) <> \'\'::text)\nroles_code_not_null: NOT NULL code\nroles_created_at_not_null: NOT NULL created_at\nroles_id_not_null: NOT NULL id\nroles_is_protected_not_null: NOT NULL is_protected\nroles_is_system_not_null: NOT NULL is_system\nroles_name_not_null: NOT NULL name\nroles_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_roles_system ON core.roles USING btree (is_system)\nCREATE UNIQUE INDEX uq_roles_code ON core.roles USING btree (code)'
}

Table core.service_credentials {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null]
  credential_id uuid [not null, default: `uuidv4()`]
  secret_hash bytea [not null]
  status "character varying(16)" [not null, default: `'active'::character varying`]
  scopes "text[]" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  expires_at "timestamp with time zone" [null]
  last_used_at "timestamp with time zone" [null]
  rotated_at "timestamp with time zone" [null]
  revoked_at "timestamp with time zone" [null]
  created_by_account_id uuid [null]
  indexes {
    (account_id, created_at) [name: 'idx_service_credentials_account', type: btree]
    credential_id [name: 'service_credentials_credential_id_key', type: btree, unique]
  }
  Note: 'chk_service_credentials_expiry: CHECK (expires_at IS NULL OR expires_at > created_at)\nchk_service_credentials_status: CHECK (status::text = \'active\'::text AND rotated_at IS NULL AND revoked_at IS NULL OR status::text = \'rotated\'::text AND rotated_at IS NOT NULL AND revoked_at IS NULL OR status::text = \'revoked\'::text AND revoked_at IS NOT NULL)\nservice_credentials_account_id_fkey: FOREIGN KEY (account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nservice_credentials_account_id_not_null: NOT NULL account_id\nservice_credentials_created_at_not_null: NOT NULL created_at\nservice_credentials_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id) ON DELETE SET NULL\nservice_credentials_credential_id_key: UNIQUE (credential_id)\nservice_credentials_credential_id_not_null: NOT NULL credential_id\nservice_credentials_id_not_null: NOT NULL id\nservice_credentials_scopes_check: CHECK (cardinality(scopes) > 0 AND array_position(scopes, NULL::text) IS NULL)\nservice_credentials_scopes_not_null: NOT NULL scopes\nservice_credentials_secret_hash_check: CHECK (octet_length(secret_hash) = 32)\nservice_credentials_secret_hash_not_null: NOT NULL secret_hash\nservice_credentials_status_check: CHECK (status::text = ANY (ARRAY[\'active\'::character varying, \'rotated\'::character varying, \'revoked\'::character varying]::text[]))\nservice_credentials_status_not_null: NOT NULL status\nCREATE INDEX idx_service_credentials_account ON core.service_credentials USING btree (account_id, created_at DESC)\nCREATE INDEX idx_service_credentials_cleanup ON core.service_credentials USING btree (COALESCE(revoked_at, rotated_at, expires_at)) WHERE (((status)::text <> \'active\'::text) OR (expires_at IS NOT NULL))\nCREATE UNIQUE INDEX service_credentials_credential_id_key ON core.service_credentials USING btree (credential_id)\nCREATE TRIGGER service_credential_account_guard BEFORE INSERT OR UPDATE OF account_id ON core.service_credentials FOR EACH ROW EXECUTE FUNCTION core.enforce_service_credential_account()'
}

Table core.system_settings {
  id uuid [pk, not null, default: `uuidv7()`]
  setting_key "character varying(160)" [not null, note: 'Globally unique generic setting key.']
  value jsonb [not null]
  is_public boolean [not null, default: `false`, note: 'Whether this non-secret setting may be exposed to a public/client configuration endpoint.']
  description text [null]
  updated_by_account_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    setting_key [name: 'uq_system_settings_key', type: btree, unique]
  }
  Note: 'Installation-wide non-secret settings: generic platform/branding metadata and similar configuration.\nchk_system_settings_description_text: CHECK (description IS NULL OR btrim(description) <> \'\'::text AND char_length(description) <= 1000 AND description !~ \'[[:cntrl:]]\'::text)\nchk_system_settings_key_format: CHECK (setting_key::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nchk_system_settings_key_not_blank: CHECK (btrim(setting_key::text) <> \'\'::text)\nfk_system_settings_updated_by: FOREIGN KEY (updated_by_account_id) REFERENCES core.accounts(id) ON DELETE SET NULL\nsystem_settings_created_at_not_null: NOT NULL created_at\nsystem_settings_id_not_null: NOT NULL id\nsystem_settings_is_public_not_null: NOT NULL is_public\nsystem_settings_setting_key_not_null: NOT NULL setting_key\nsystem_settings_updated_at_not_null: NOT NULL updated_at\nsystem_settings_value_not_null: NOT NULL value\nCREATE UNIQUE INDEX uq_system_settings_key ON core.system_settings USING btree (setting_key)'
}

