}

Table core.privacy_legal_holds {
  id uuid [pk, not null, default: `uuidv7()`]
  subject_person_id uuid [null]
  scope_type "character varying(20)" [not null]
  purpose_code "character varying(120)" [null]
  resource_type "character varying(120)" [null]
  resource_id uuid [null]
  reason_code "character varying(120)" [not null]
  source_type "character varying(120)" [null]
  source_reference "character varying(160)" [null]
  created_at "timestamp with time zone" [not null]
  created_by_account_id uuid [not null]
  expires_at "timestamp with time zone" [null]
  released_at "timestamp with time zone" [null]
  released_by_account_id uuid [null]
  release_reason_code "character varying(120)" [null]
  Note: 'chk_privacy_hold_codes: CHECK (reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND (purpose_code IS NULL OR purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (resource_type IS NULL OR resource_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (source_type IS NULL OR source_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (release_reason_code IS NULL OR release_reason_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text) AND (source_reference IS NULL OR source_reference::text ~ \'^[a-zA-Z0-9._:/-]+$\'::text))\nchk_privacy_hold_release: CHECK (released_at IS NULL AND released_by_account_id IS NULL AND release_reason_code IS NULL OR released_at >= created_at AND released_by_account_id IS NOT NULL AND release_reason_code IS NOT NULL)\nchk_privacy_hold_scope: CHECK (scope_type::text = \'subject\'::text AND subject_person_id IS NOT NULL AND purpose_code IS NULL AND resource_type IS NULL AND resource_id IS NULL OR scope_type::text = \'purpose\'::text AND purpose_code IS NOT NULL AND resource_type IS NULL AND resource_id IS NULL OR scope_type::text = \'resource\'::text AND resource_type IS NOT NULL AND resource_id IS NOT NULL)\nchk_privacy_hold_times: CHECK (expires_at IS NULL OR expires_at > created_at)\nprivacy_legal_holds_created_at_not_null: NOT NULL created_at\nprivacy_legal_holds_created_by_account_id_fkey: FOREIGN KEY (created_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_legal_holds_created_by_account_id_not_null: NOT NULL created_by_account_id\nprivacy_legal_holds_id_not_null: NOT NULL id\nprivacy_legal_holds_reason_code_not_null: NOT NULL reason_code\nprivacy_legal_holds_released_by_account_id_fkey: FOREIGN KEY (released_by_account_id) REFERENCES core.accounts(id) ON DELETE RESTRICT\nprivacy_legal_holds_scope_type_check: CHECK (scope_type::text = ANY (ARRAY[\'subject\'::character varying, \'purpose\'::character varying, \'resource\'::character varying]::text[]))\nprivacy_legal_holds_scope_type_not_null: NOT NULL scope_type\nprivacy_legal_holds_subject_person_id_fkey: FOREIGN KEY (subject_person_id) REFERENCES core.persons(id) ON DELETE RESTRICT\nCREATE INDEX idx_privacy_hold_resource_active ON core.privacy_legal_holds USING btree (resource_type, resource_id) WHERE (released_at IS NULL)\nCREATE INDEX idx_privacy_hold_subject_active ON core.privacy_legal_holds USING btree (subject_person_id, scope_type, expires_at) WHERE (released_at IS NULL)'
}

