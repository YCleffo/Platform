  contributor_code "character varying(120)" [not null]
  indexes {
    (item_id, purpose_code, contributor_code) [pk]
  }
  Note: 'chk_erasure_item_purpose_codes: CHECK (purpose_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND policy_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND trigger_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND contributor_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_erasure_item_purposes_contributor_code_not_null: NOT NULL contributor_code\nprivacy_erasure_item_purposes_item_id_fkey: FOREIGN KEY (item_id) REFERENCES core.privacy_erasure_items(id) ON DELETE RESTRICT\nprivacy_erasure_item_purposes_item_id_not_null: NOT NULL item_id\nprivacy_erasure_item_purposes_policy_code_not_null: NOT NULL policy_code\nprivacy_erasure_item_purposes_purpose_code_not_null: NOT NULL purpose_code\nprivacy_erasure_item_purposes_trigger_code_not_null: NOT NULL trigger_code'
}

Table core.privacy_erasure_items {
  id uuid [pk, not null, default: `uuidv7()`]
  case_id uuid [not null]
  resource_type "character varying(120)" [not null]
  resource_id uuid [not null]
  policy_code "character varying(120)" [not null]
  planned_action "character varying(24)" [null]
  status "character varying(24)" [not null]
  attempts integer [not null, default: `0`]
  started_at "timestamp with time zone" [null]
  completed_at "timestamp with time zone" [null]
  failure_code "character varying(120)" [null]
  created_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null]
  indexes {
    (case_id, status, id) [name: 'idx_erasure_items_case_status', type: btree]
    (case_id, resource_type, resource_id) [name: 'privacy_erasure_items_case_id_resource_type_resource_id_key', type: btree, unique]
  }
  Note: 'chk_erasure_item_complete: CHECK ((status::text = \'completed\'::text) = (completed_at IS NOT NULL))\nchk_erasure_item_time: CHECK (started_at IS NULL OR started_at >= created_at)\nprivacy_erasure_items_attempts_check: CHECK (attempts >= 0)\nprivacy_erasure_items_attempts_not_null: NOT NULL attempts\nprivacy_erasure_items_case_id_fkey: FOREIGN KEY (case_id) REFERENCES core.privacy_erasure_cases(id) ON DELETE RESTRICT\nprivacy_erasure_items_case_id_not_null: NOT NULL case_id\nprivacy_erasure_items_case_id_resource_type_resource_id_key: UNIQUE (case_id, resource_type, resource_id)\nprivacy_erasure_items_created_at_not_null: NOT NULL created_at\nprivacy_erasure_items_failure_code_check: CHECK (failure_code IS NULL OR failure_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_erasure_items_id_not_null: NOT NULL id\nprivacy_erasure_items_planned_action_check: CHECK (planned_action::text = ANY (ARRAY[\'delete\'::character varying, \'anonymize\'::character varying, \'pseudonymize\'::character varying, \'custom\'::character varying]::text[]))\nprivacy_erasure_items_policy_code_check: CHECK (policy_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_erasure_items_policy_code_not_null: NOT NULL policy_code\nprivacy_erasure_items_resource_id_not_null: NOT NULL resource_id\nprivacy_erasure_items_resource_type_check: CHECK (resource_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nprivacy_erasure_items_resource_type_not_null: NOT NULL resource_type\nprivacy_erasure_items_status_check: CHECK (status::text = ANY (ARRAY[\'planned\'::character varying, \'in_progress\'::character varying, \'completed\'::character varying, \'blocked\'::character varying, \'failed\'::character varying]::text[]))\nprivacy_erasure_items_status_not_null: NOT NULL status\nprivacy_erasure_items_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX idx_erasure_items_case_status ON core.privacy_erasure_items USING btree (case_id, status, id)\nCREATE UNIQUE INDEX privacy_erasure_items_case_id_resource_type_resource_id_key ON core.privacy_erasure_items USING btree (case_id, resource_type, resource_id)'
}

