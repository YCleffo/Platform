// СФОРМИРОВАНО scripts/database/export_schema.py; не редактировать вручную.
// Только реальные объекты PostgreSQL. Полное определение SQL: schema.catalog.json.
Project storage {
  database_type: 'PostgreSQL'
  Note: 'Каталог PostgreSQL после миграций. Межбазовые идентификаторы не являются внешними ключами.'
}

Table storage.binary_cleanup {
  storage_key uuid [pk, not null]
  queued_at "timestamp with time zone" [not null, default: `now()`]
  completed_at "timestamp with time zone" [null]
  attempts integer [not null, default: `0`]
  last_error "character varying(160)" [null]
  Note: 'binary_cleanup_attempts_not_null: NOT NULL attempts\nbinary_cleanup_queued_at_not_null: NOT NULL queued_at\nbinary_cleanup_storage_key_not_null: NOT NULL storage_key\nCREATE INDEX storage_cleanup_pending ON storage.binary_cleanup USING btree (queued_at) WHERE (completed_at IS NULL)'
}

Table storage.conflicts {
  id uuid [pk, not null, default: `uuidv7()`]
  space_id uuid [not null]
  path "character varying(1024)" [not null]
  server_version integer [null]
  device_version integer [null]
  server_sha256 character(64) [null]
  device_sha256 character(64) [null]
  resolution "character varying(16)" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  resolved_at "timestamp with time zone" [null]
  manifest_id uuid [null]
  Note: 'conflicts_created_at_not_null: NOT NULL created_at\nconflicts_id_not_null: NOT NULL id\nconflicts_manifest_id_fkey: FOREIGN KEY (manifest_id) REFERENCES storage.manifests(id)\nconflicts_path_not_null: NOT NULL path\nconflicts_space_id_fkey: FOREIGN KEY (space_id) REFERENCES storage.spaces(id)\nconflicts_space_id_not_null: NOT NULL space_id'
}

Table storage.files {
  id uuid [pk, not null, default: `uuidv7()`]
  space_id uuid [not null]
  path "character varying(1024)" [not null]
  current_version_id uuid [null]
  deleted_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  deleted_by_manifest_id uuid [null]
  indexes {
    (space_id, deleted_at, path) [name: 'files_space', type: btree]
    (space_id, path) [name: 'files_space_id_path_key', type: btree, unique]
  }
  Note: 'files_created_at_not_null: NOT NULL created_at\nfiles_id_not_null: NOT NULL id\nfiles_path_check: CHECK (btrim(path::text) <> \'\'::text AND path::text !~~ \'%..%\'::text)\nfiles_path_not_null: NOT NULL path\nfiles_space_id_fkey: FOREIGN KEY (space_id) REFERENCES storage.spaces(id)\nfiles_space_id_not_null: NOT NULL space_id\nfiles_space_id_path_key: UNIQUE (space_id, path)\nCREATE INDEX files_space ON storage.files USING btree (space_id, deleted_at, path)\nCREATE UNIQUE INDEX files_space_id_path_key ON storage.files USING btree (space_id, path)\nCREATE INDEX storage_files_path_trgm_idx ON storage.files USING gin (path gin_trgm_ops)'
}

Table storage.manifest_entries {
  manifest_id uuid [not null]
  path "character varying(1024)" [not null]
  operation "character varying(8)" [not null]
  sha256 character(64) [null]
  size_bytes bigint [null]
  base_sha256 character(64) [null]
  state "character varying(16)" [not null, default: `'expected'::character varying`]
  ticket_id uuid [null]
  verified_sha256 character(64) [null]
  verified_size bigint [null]
  verified_version_id uuid [null]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (manifest_id, path) [pk]
    (manifest_id, state) [name: 'manifest_entries_state', type: btree]
  }
  Note: 'manifest_entries_manifest_id_fkey: FOREIGN KEY (manifest_id) REFERENCES storage.manifests(id) ON DELETE CASCADE\nmanifest_entries_manifest_id_not_null: NOT NULL manifest_id\nmanifest_entries_operation_check: CHECK (operation::text = ANY (ARRAY[\'add\'::character varying, \'update\'::character varying, \'delete\'::character varying]::text[]))\nmanifest_entries_operation_not_null: NOT NULL operation\nmanifest_entries_path_check: CHECK (btrim(path::text) <> \'\'::text AND path::text !~~ \'%..%\'::text)\nmanifest_entries_path_not_null: NOT NULL path\nmanifest_entries_size_bytes_check: CHECK (size_bytes IS NULL OR size_bytes >= 0 AND size_bytes <= \'5497558138880\'::bigint)\nmanifest_entries_state_check: CHECK (state::text = ANY (ARRAY[\'expected\'::character varying, \'verified\'::character varying, \'deleted\'::character varying, \'skipped\'::character varying, \'conflict\'::character varying]::text[]))\nmanifest_entries_state_not_null: NOT NULL state\nmanifest_entries_ticket_id_fkey: FOREIGN KEY (ticket_id) REFERENCES storage.tickets(id)\nmanifest_entries_updated_at_not_null: NOT NULL updated_at\nmanifest_entries_verified_version_id_fkey: FOREIGN KEY (verified_version_id) REFERENCES storage.versions(id)\nCREATE INDEX manifest_entries_state ON storage.manifest_entries USING btree (manifest_id, state)'
}

Table storage.manifests {
  id uuid [pk, not null, default: `uuidv7()`]
  space_id uuid [not null]
  version integer [not null]
  entries jsonb [not null, default: `'[]'::jsonb`]
  status "character varying(16)" [not null, default: `'pending'::character varying`]
  device_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  confirmed_at "timestamp with time zone" [null]
  entries_sha256 character(64) [null]
  base_version integer [null]
  snapshot jsonb [null]
  snapshot_sha256 character(64) [null]
  indexes {
    (space_id, version) [name: 'manifests_space_id_version_key', type: btree, unique]
  }
  Note: 'manifests_created_at_not_null: NOT NULL created_at\nmanifests_entries_not_null: NOT NULL entries\nmanifests_id_not_null: NOT NULL id\nmanifests_space_id_fkey: FOREIGN KEY (space_id) REFERENCES storage.spaces(id)\nmanifests_space_id_not_null: NOT NULL space_id\nmanifests_space_id_version_key: UNIQUE (space_id, version)\nmanifests_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'accepted\'::character varying, \'confirmed\'::character varying]::text[]))\nmanifests_status_not_null: NOT NULL status\nmanifests_version_check: CHECK (version > 0)\nmanifests_version_not_null: NOT NULL version\nCREATE INDEX manifests_confirmed ON storage.manifests USING btree (space_id, version DESC) WHERE ((status)::text = \'confirmed\'::text)\nCREATE UNIQUE INDEX manifests_space_id_version_key ON storage.manifests USING btree (space_id, version)'
}

Table storage.module_migrations {
  name text [pk, not null]
  sha256 character(64) [not null]
  applied_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'module_migrations_applied_at_not_null: NOT NULL applied_at\nmodule_migrations_name_not_null: NOT NULL name\nmodule_migrations_sha256_not_null: NOT NULL sha256'
}

Table storage.object_cleanup {
  object_key "character varying(1024)" [pk, not null]
  multipart_upload_id text [null]
  transfer_id uuid [null]
  queued_at "timestamp with time zone" [not null, default: `now()`]
  not_before "timestamp with time zone" [not null, default: `now()`]
  completed_at "timestamp with time zone" [null]
  attempts integer [not null, default: `0`]
  last_error "character varying(160)" [null]
  Note: 'object_cleanup_attempts_not_null: NOT NULL attempts\nobject_cleanup_not_before_not_null: NOT NULL not_before\nobject_cleanup_object_key_not_null: NOT NULL object_key\nobject_cleanup_queued_at_not_null: NOT NULL queued_at\nCREATE INDEX storage_object_cleanup_pending ON storage.object_cleanup USING btree (not_before, queued_at) WHERE (completed_at IS NULL)'
}

Table storage.object_migrations {
  module "character varying(16)" [not null]
  storage_key uuid [not null]
  size_bytes bigint [not null]
  sha256 character(64) [not null]
  source_fingerprint character(64) [not null]
  verified_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (module, storage_key) [pk]
  }
  Note: 'object_migrations_module_check: CHECK (module::text = ANY (ARRAY[\'storage\'::character varying, \'education\'::character varying]::text[]))\nobject_migrations_module_not_null: NOT NULL module\nobject_migrations_sha256_check: CHECK (sha256 ~ \'^[0-9a-f]{64}$\'::text)\nobject_migrations_sha256_not_null: NOT NULL sha256\nobject_migrations_size_bytes_check: CHECK (size_bytes >= 0)\nobject_migrations_size_bytes_not_null: NOT NULL size_bytes\nobject_migrations_source_fingerprint_not_null: NOT NULL source_fingerprint\nobject_migrations_storage_key_not_null: NOT NULL storage_key\nobject_migrations_verified_at_not_null: NOT NULL verified_at'
}

Table storage.privacy_receipts {
  item_id uuid [pk, not null]
  result "character varying(32)" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'privacy_receipts_created_at_not_null: NOT NULL created_at\nprivacy_receipts_item_id_not_null: NOT NULL item_id\nprivacy_receipts_result_not_null: NOT NULL result'
}

Table storage.spaces {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  student_id uuid [not null]
  account_id uuid [not null]
  max_files integer [not null, default: `5000`]
  max_bytes bigint [not null, default: `1073741824`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  subject_person_id uuid [null]
  indexes {
    (organization_id, student_id) [name: 'spaces_organization_id_student_id_key', type: btree, unique]
  }
  Note: 'spaces_account_id_not_null: NOT NULL account_id\nspaces_created_at_not_null: NOT NULL created_at\nspaces_id_not_null: NOT NULL id\nspaces_max_bytes_check: CHECK (max_bytes >= 1 AND max_bytes <= \'1099511627776\'::bigint)\nspaces_max_bytes_not_null: NOT NULL max_bytes\nspaces_max_files_check: CHECK (max_files >= 1 AND max_files <= 100000)\nspaces_max_files_not_null: NOT NULL max_files\nspaces_organization_id_not_null: NOT NULL organization_id\nspaces_organization_id_student_id_key: UNIQUE (organization_id, student_id)\nspaces_student_id_not_null: NOT NULL student_id\nCREATE UNIQUE INDEX spaces_organization_id_student_id_key ON storage.spaces USING btree (organization_id, student_id)'
}

Table storage.sync_sessions {
  id uuid [pk, not null, default: `uuidv7()`]
  space_id uuid [not null]
  device_id uuid [not null]
  direction "character varying(8)" [not null]
  status "character varying(16)" [not null, default: `'running'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  finished_at "timestamp with time zone" [null]
  Note: 'sync_sessions_created_at_not_null: NOT NULL created_at\nsync_sessions_device_id_not_null: NOT NULL device_id\nsync_sessions_direction_check: CHECK (direction::text = ANY (ARRAY[\'in\'::character varying, \'out\'::character varying]::text[]))\nsync_sessions_direction_not_null: NOT NULL direction\nsync_sessions_id_not_null: NOT NULL id\nsync_sessions_space_id_fkey: FOREIGN KEY (space_id) REFERENCES storage.spaces(id)\nsync_sessions_space_id_not_null: NOT NULL space_id\nsync_sessions_status_check: CHECK (status::text = ANY (ARRAY[\'running\'::character varying, \'done\'::character varying, \'failed\'::character varying]::text[]))\nsync_sessions_status_not_null: NOT NULL status'
}

Table storage.tickets {
  id uuid [pk, not null, default: `uuidv7()`]
  space_id uuid [not null]
  purpose "character varying(8)" [not null]
  path "character varying(1024)" [not null]
  token_hash character(64) [not null]
  single_use boolean [not null, default: `true`]
  used_at "timestamp with time zone" [null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  expected_sha256 character(64) [null]
  expected_size bigint [null]
  file_version_id uuid [null]
  device_id uuid [null]
  base_version_id uuid [null]
  base_deleted_at "timestamp with time zone" [null]
  actor_account_id uuid [null]
  indexes {
    (space_id, created_at) [name: 'tickets_space', type: btree]
    token_hash [name: 'tickets_token_hash_key', type: btree, unique]
  }
  Note: 'tickets_created_at_not_null: NOT NULL created_at\ntickets_expected_size_check: CHECK (expected_size IS NULL OR expected_size >= 0 AND expected_size <= \'5497558138880\'::bigint)\ntickets_expires_at_not_null: NOT NULL expires_at\ntickets_file_version_id_fkey: FOREIGN KEY (file_version_id) REFERENCES storage.versions(id)\ntickets_id_not_null: NOT NULL id\ntickets_path_check: CHECK (btrim(path::text) <> \'\'::text AND path::text !~~ \'%..%\'::text)\ntickets_path_not_null: NOT NULL path\ntickets_purpose_check: CHECK (purpose::text = ANY (ARRAY[\'upload\'::character varying, \'download\'::character varying]::text[]))\ntickets_purpose_not_null: NOT NULL purpose\ntickets_single_use_not_null: NOT NULL single_use\ntickets_space_id_fkey: FOREIGN KEY (space_id) REFERENCES storage.spaces(id)\ntickets_space_id_not_null: NOT NULL space_id\ntickets_token_hash_key: UNIQUE (token_hash)\ntickets_token_hash_not_null: NOT NULL token_hash\nCREATE INDEX tickets_space ON storage.tickets USING btree (space_id, created_at)\nCREATE UNIQUE INDEX tickets_token_hash_key ON storage.tickets USING btree (token_hash)'
}

Table storage.transfer_parts {
  transfer_id uuid [not null]
  part_number integer [not null]
  sha256 character(64) [not null]
  size_bytes bigint [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (transfer_id, part_number) [pk]
  }
  Note: 'transfer_parts_created_at_not_null: NOT NULL created_at\ntransfer_parts_part_number_check: CHECK (part_number >= 1 AND part_number <= 10000)\ntransfer_parts_part_number_not_null: NOT NULL part_number\ntransfer_parts_sha256_check: CHECK (sha256 ~ \'^[0-9a-f]{64}$\'::text)\ntransfer_parts_sha256_not_null: NOT NULL sha256\ntransfer_parts_size_bytes_check: CHECK (size_bytes >= 1 AND size_bytes <= \'5368709120\'::bigint)\ntransfer_parts_size_bytes_not_null: NOT NULL size_bytes\ntransfer_parts_transfer_id_fkey: FOREIGN KEY (transfer_id) REFERENCES storage.transfers(id) ON DELETE CASCADE\ntransfer_parts_transfer_id_not_null: NOT NULL transfer_id'
}

Table storage.transfers {
  id uuid [pk, not null, default: `uuidv7()`]
  ticket_id uuid [not null]
  space_id uuid [not null]
  actor_account_id uuid [null]
  device_id uuid [null]
  direction "character varying(8)" [not null]
  path "character varying(1024)" [not null]
  status "character varying(16)" [not null, default: `'pending'::character varying`]
  mode "character varying(12)" [not null]
  expected_size bigint [not null]
  expected_sha256 character(64) [not null]
  staging_key "character varying(1024)" [not null]
  final_storage_key uuid [not null]
  multipart_upload_id text [null]
  part_size bigint [null]
  total_parts integer [null]
  reserved_bytes bigint [not null, default: `0`]
  reserved_files integer [not null, default: `0`]
  result jsonb [null]
  verified_at "timestamp with time zone" [null]
  expires_at "timestamp with time zone" [not null, default: `(now() + '24:00:00'::interval)`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (status, updated_at) [name: 'storage_transfer_reconciliation', type: btree]
    final_storage_key [name: 'transfers_final_storage_key_key', type: btree, unique]
    staging_key [name: 'transfers_staging_key_key', type: btree, unique]
    ticket_id [name: 'transfers_ticket_id_key', type: btree, unique]
  }
  Note: 'transfers_check: CHECK ((device_id IS NULL) <> (actor_account_id IS NULL))\ntransfers_check1: CHECK (mode::text = \'single\'::text AND part_size IS NULL AND total_parts IS NULL OR mode::text = \'multipart\'::text AND part_size IS NOT NULL AND total_parts IS NOT NULL)\ntransfers_check2: CHECK (status::text <> \'confirmed\'::text OR result IS NOT NULL)\ntransfers_created_at_not_null: NOT NULL created_at\ntransfers_direction_check: CHECK (direction::text = ANY (ARRAY[\'upload\'::character varying, \'download\'::character varying]::text[]))\ntransfers_direction_not_null: NOT NULL direction\ntransfers_expected_sha256_check: CHECK (expected_sha256 ~ \'^[0-9a-f]{64}$\'::text)\ntransfers_expected_sha256_not_null: NOT NULL expected_sha256\ntransfers_expected_size_check: CHECK (expected_size >= 0 AND expected_size <= \'5497558138880\'::bigint)\ntransfers_expected_size_not_null: NOT NULL expected_size\ntransfers_expires_at_not_null: NOT NULL expires_at\ntransfers_final_storage_key_key: UNIQUE (final_storage_key)\ntransfers_final_storage_key_not_null: NOT NULL final_storage_key\ntransfers_id_not_null: NOT NULL id\ntransfers_mode_check: CHECK (mode::text = ANY (ARRAY[\'single\'::character varying, \'multipart\'::character varying]::text[]))\ntransfers_mode_not_null: NOT NULL mode\ntransfers_part_size_check: CHECK (part_size >= 5242880 AND part_size <= \'5368709120\'::bigint)\ntransfers_path_not_null: NOT NULL path\ntransfers_reserved_bytes_check: CHECK (reserved_bytes >= 0)\ntransfers_reserved_bytes_not_null: NOT NULL reserved_bytes\ntransfers_reserved_files_check: CHECK (reserved_files >= 0 AND reserved_files <= 1)\ntransfers_reserved_files_not_null: NOT NULL reserved_files\ntransfers_space_id_fkey: FOREIGN KEY (space_id) REFERENCES storage.spaces(id)\ntransfers_space_id_not_null: NOT NULL space_id\ntransfers_staging_key_key: UNIQUE (staging_key)\ntransfers_staging_key_not_null: NOT NULL staging_key\ntransfers_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'uploading\'::character varying, \'verifying\'::character varying, \'confirmed\'::character varying, \'aborted\'::character varying, \'expired\'::character varying]::text[]))\ntransfers_status_not_null: NOT NULL status\ntransfers_ticket_id_fkey: FOREIGN KEY (ticket_id) REFERENCES storage.tickets(id) ON DELETE CASCADE\ntransfers_ticket_id_key: UNIQUE (ticket_id)\ntransfers_ticket_id_not_null: NOT NULL ticket_id\ntransfers_total_parts_check: CHECK (total_parts >= 1 AND total_parts <= 10000)\ntransfers_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX storage_transfer_reconciliation ON storage.transfers USING btree (status, updated_at)\nCREATE INDEX storage_transfer_reservations ON storage.transfers USING btree (space_id, expires_at) WHERE (((direction)::text = \'upload\'::text) AND ((status)::text = ANY ((ARRAY[\'pending\'::character varying, \'uploading\'::character varying, \'verifying\'::character varying])::text[])))\nCREATE UNIQUE INDEX transfers_final_storage_key_key ON storage.transfers USING btree (final_storage_key)\nCREATE UNIQUE INDEX transfers_staging_key_key ON storage.transfers USING btree (staging_key)\nCREATE UNIQUE INDEX transfers_ticket_id_key ON storage.transfers USING btree (ticket_id)'
}

Table storage.versions {
  id uuid [pk, not null, default: `uuidv7()`]
  file_id uuid [not null]
  version integer [not null]
  size_bytes bigint [not null]
  sha256 character(64) [not null]
  storage_key uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (file_id, version) [name: 'versions_file', type: btree]
    (file_id, version) [name: 'versions_file_id_version_key', type: btree, unique]
    storage_key [name: 'versions_storage_key_key', type: btree, unique]
  }
  Note: 'versions_created_at_not_null: NOT NULL created_at\nversions_file_id_fkey: FOREIGN KEY (file_id) REFERENCES storage.files(id)\nversions_file_id_not_null: NOT NULL file_id\nversions_file_id_version_key: UNIQUE (file_id, version)\nversions_id_not_null: NOT NULL id\nversions_sha256_not_null: NOT NULL sha256\nversions_size_bytes_check: CHECK (size_bytes >= 0 AND size_bytes <= \'5497558138880\'::bigint)\nversions_size_bytes_not_null: NOT NULL size_bytes\nversions_storage_key_key: UNIQUE (storage_key)\nversions_storage_key_not_null: NOT NULL storage_key\nversions_version_check: CHECK (version > 0)\nversions_version_not_null: NOT NULL version\nCREATE INDEX versions_file ON storage.versions USING btree (file_id, version)\nCREATE UNIQUE INDEX versions_file_id_version_key ON storage.versions USING btree (file_id, version)\nCREATE UNIQUE INDEX versions_storage_key_key ON storage.versions USING btree (storage_key)'
}

