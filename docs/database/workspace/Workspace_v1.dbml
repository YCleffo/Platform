// СФОРМИРОВАНО scripts/database/export_schema.py; не редактировать вручную.
// Только реальные объекты PostgreSQL. Полное определение SQL: schema.catalog.json.
Project workspace {
  database_type: 'PostgreSQL'
  Note: 'Каталог PostgreSQL после миграций. Межбазовые идентификаторы не являются внешними ключами.'
}

Table workspace.module_migrations {
  name text [pk, not null]
  sha256 character(64) [not null]
  applied_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'module_migrations_applied_at_not_null: NOT NULL applied_at\nmodule_migrations_name_not_null: NOT NULL name\nmodule_migrations_sha256_not_null: NOT NULL sha256'
}

Table workspace.operations {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  account_id uuid [not null]
  person_id uuid [null]
  action_key "character varying(120)" [not null]
  entity_type "character varying(80)" [not null, default: `''::character varying`]
  entity_id uuid [null]
  payload jsonb [not null, default: `'{}'::jsonb`]
  mode "character varying(24)" [not null]
  status "character varying(24)" [not null]
  undo_deadline "timestamp with time zone" [null]
  execute_at "timestamp with time zone" [null]
  revision integer [not null, default: `1`]
  result jsonb [null]
  error_code "character varying(80)" [null]
  error_message text [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  finalized_at "timestamp with time zone" [null]
  indexes {
    (organization_id, account_id, created_at, id) [name: 'workspace_operations_actor_idx', type: btree]
  }
  Note: 'operations_account_id_not_null: NOT NULL account_id\noperations_action_key_check: CHECK (btrim(action_key::text) <> \'\'::text)\noperations_action_key_not_null: NOT NULL action_key\noperations_created_at_not_null: NOT NULL created_at\noperations_entity_type_not_null: NOT NULL entity_type\noperations_id_not_null: NOT NULL id\noperations_mode_check: CHECK (mode::text = ANY (ARRAY[\'immediate\'::character varying, \'reversible\'::character varying, \'deferred\'::character varying, \'background\'::character varying, \'irreversible\'::character varying, \'confirmed\'::character varying]::text[]))\noperations_mode_not_null: NOT NULL mode\noperations_organization_id_not_null: NOT NULL organization_id\noperations_payload_check: CHECK (jsonb_typeof(payload) = \'object\'::text)\noperations_payload_not_null: NOT NULL payload\noperations_revision_check: CHECK (revision > 0)\noperations_revision_not_null: NOT NULL revision\noperations_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'running\'::character varying, \'undoable\'::character varying, \'committed\'::character varying, \'completed\'::character varying, \'undone\'::character varying, \'cancelled\'::character varying, \'failed\'::character varying]::text[]))\noperations_status_not_null: NOT NULL status\noperations_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX workspace_operations_actor_idx ON workspace.operations USING btree (organization_id, account_id, created_at DESC, id DESC)\nCREATE INDEX workspace_operations_deferred_idx ON workspace.operations USING btree (status, execute_at) WHERE (((status)::text = \'pending\'::text) AND (finalized_at IS NULL))\nCREATE INDEX workspace_operations_entity_idx ON workspace.operations USING btree (entity_type, entity_id) WHERE (entity_id IS NOT NULL)\nCREATE INDEX workspace_operations_person_idx ON workspace.operations USING btree (person_id, created_at DESC) WHERE (person_id IS NOT NULL)\nCREATE INDEX workspace_operations_undoable_idx ON workspace.operations USING btree (status, undo_deadline) WHERE (((status)::text = \'undoable\'::text) AND (finalized_at IS NULL))'
}

Table workspace.preferences {
  id uuid [pk, not null, default: `uuidv7()`]
  account_id uuid [not null]
  organization_id uuid [null]
  key "character varying(120)" [not null]
  value jsonb [not null, default: `'{}'::jsonb`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (account_id, organization_id, key) [name: 'preferences_account_id_organization_id_key_key', type: btree, unique]
    (account_id, organization_id, key) [name: 'workspace_preferences_account_idx', type: btree]
  }
  Note: 'preferences_account_id_not_null: NOT NULL account_id\npreferences_account_id_organization_id_key_key: UNIQUE NULLS NOT DISTINCT (account_id, organization_id, key)\npreferences_id_not_null: NOT NULL id\npreferences_key_check: CHECK (btrim(key::text) <> \'\'::text)\npreferences_key_not_null: NOT NULL key\npreferences_updated_at_not_null: NOT NULL updated_at\npreferences_value_not_null: NOT NULL value\nCREATE UNIQUE INDEX preferences_account_id_organization_id_key_key ON workspace.preferences USING btree (account_id, organization_id, key) NULLS NOT DISTINCT\nCREATE INDEX workspace_preferences_account_idx ON workspace.preferences USING btree (account_id, organization_id, key)'
}

Table workspace.privacy_receipts {
  item_id uuid [pk, not null]
  result "character varying(30)" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'privacy_receipts_created_at_not_null: NOT NULL created_at\nprivacy_receipts_item_id_not_null: NOT NULL item_id\nprivacy_receipts_result_not_null: NOT NULL result'
}

Table workspace.trash_items {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  deleted_by_account_id uuid [not null]
  deleted_by_person_id uuid [null]
  entity_type "character varying(80)" [not null]
  entity_id uuid [not null]
  module_code "character varying(60)" [not null]
  title "character varying(255)" [not null, default: `''::character varying`]
  subtitle "character varying(255)" [not null, default: `''::character varying`]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  payload jsonb [not null, default: `'{}'::jsonb`]
  restore_status "character varying(24)" [not null, default: `'trashed'::character varying`]
  expires_at "timestamp with time zone" [not null, default: `(now() + '30 days'::interval)`]
  deleted_at "timestamp with time zone" [not null, default: `now()`]
  restored_at "timestamp with time zone" [null]
  purged_at "timestamp with time zone" [null]
  indexes {
    (deleted_by_account_id, deleted_by_person_id) [name: 'workspace_trash_actor_idx', type: btree]
    (organization_id, restore_status, deleted_at, id) [name: 'workspace_trash_org_list_idx', type: btree]
  }
  Note: 'trash_items_deleted_at_not_null: NOT NULL deleted_at\ntrash_items_deleted_by_account_id_not_null: NOT NULL deleted_by_account_id\ntrash_items_entity_id_not_null: NOT NULL entity_id\ntrash_items_entity_type_check: CHECK (btrim(entity_type::text) <> \'\'::text)\ntrash_items_entity_type_not_null: NOT NULL entity_type\ntrash_items_expires_at_not_null: NOT NULL expires_at\ntrash_items_id_not_null: NOT NULL id\ntrash_items_metadata_check: CHECK (jsonb_typeof(metadata) = \'object\'::text)\ntrash_items_metadata_not_null: NOT NULL metadata\ntrash_items_module_code_check: CHECK (btrim(module_code::text) <> \'\'::text)\ntrash_items_module_code_not_null: NOT NULL module_code\ntrash_items_organization_id_not_null: NOT NULL organization_id\ntrash_items_payload_check: CHECK (jsonb_typeof(payload) = \'object\'::text)\ntrash_items_payload_not_null: NOT NULL payload\ntrash_items_restore_status_check: CHECK (restore_status::text = ANY (ARRAY[\'trashed\'::character varying, \'restored\'::character varying, \'purged\'::character varying]::text[]))\ntrash_items_restore_status_not_null: NOT NULL restore_status\ntrash_items_subtitle_not_null: NOT NULL subtitle\ntrash_items_title_not_null: NOT NULL title\nCREATE UNIQUE INDEX workspace_trash_active_entity_idx ON workspace.trash_items USING btree (entity_type, entity_id) WHERE ((restore_status)::text = \'trashed\'::text)\nCREATE INDEX workspace_trash_actor_idx ON workspace.trash_items USING btree (deleted_by_account_id, deleted_by_person_id)\nCREATE INDEX workspace_trash_expiry_idx ON workspace.trash_items USING btree (restore_status, expires_at) WHERE ((restore_status)::text = \'trashed\'::text)\nCREATE INDEX workspace_trash_org_list_idx ON workspace.trash_items USING btree (organization_id, restore_status, deleted_at DESC, id DESC)'
}

