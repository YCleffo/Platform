// СФОРМИРОВАНО scripts/database/export_schema.py; не редактировать вручную.
// Только реальные объекты PostgreSQL. Полное определение SQL: schema.catalog.json.
Project activity {
  database_type: 'PostgreSQL'
  Note: 'Каталог PostgreSQL после миграций. Межбазовые идентификаторы не являются внешними ключами.'
}

Table activity.assignments {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  activity_id uuid [not null]
  version_id uuid [not null]
  assigned_by_person_id uuid [not null]
  target_type "character varying(32)" [not null]
  target_id uuid [not null]
  opens_at "timestamp with time zone" [null]
  due_at "timestamp with time zone" [null]
  allow_late boolean [not null, default: `false`]
  config_override jsonb [not null, default: `'{}'::jsonb`]
  status "character varying(24)" [not null, default: `'ACTIVE'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  revoked_at "timestamp with time zone" [null]
  source_legacy_type "character varying(40)" [null]
  source_legacy_id uuid [null]
  indexes {
    (organization_id, target_type, target_id, created_at) [name: 'activity_assignments_org_target_idx', type: btree]
  }
  Note: 'assignments_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES activity.items(id) ON DELETE CASCADE\nassignments_activity_id_not_null: NOT NULL activity_id\nassignments_allow_late_not_null: NOT NULL allow_late\nassignments_assigned_by_person_id_not_null: NOT NULL assigned_by_person_id\nassignments_config_override_check: CHECK (jsonb_typeof(config_override) = \'object\'::text)\nassignments_config_override_not_null: NOT NULL config_override\nassignments_created_at_not_null: NOT NULL created_at\nassignments_id_not_null: NOT NULL id\nassignments_organization_id_not_null: NOT NULL organization_id\nassignments_status_check: CHECK (status::text = ANY (ARRAY[\'ACTIVE\'::character varying, \'CLOSED\'::character varying, \'CANCELLED\'::character varying]::text[]))\nassignments_status_not_null: NOT NULL status\nassignments_target_id_not_null: NOT NULL target_id\nassignments_target_type_check: CHECK (target_type::text = ANY (ARRAY[\'group\'::character varying, \'person\'::character varying, \'student\'::character varying, \'lesson\'::character varying, \'homework\'::character varying, \'room\'::character varying, \'organization\'::character varying]::text[]))\nassignments_target_type_not_null: NOT NULL target_type\nassignments_version_id_fkey: FOREIGN KEY (version_id) REFERENCES activity.versions(id)\nassignments_version_id_not_null: NOT NULL version_id\nCREATE INDEX activity_assignments_active_idx ON activity.assignments USING btree (organization_id, activity_id, status) WHERE (revoked_at IS NULL)\nCREATE INDEX activity_assignments_org_target_idx ON activity.assignments USING btree (organization_id, target_type, target_id, created_at DESC)'
}

Table activity.attempt_events {
  id uuid [pk, not null, default: `uuidv7()`]
  attempt_id uuid [not null]
  from_state "character varying(30)" [null]
  to_state "character varying(30)" [not null]
  actor_person_id uuid [null]
  reason "character varying(120)" [not null, default: `''::character varying`]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (attempt_id, created_at) [name: 'activity_attempt_events_idx', type: btree]
  }
  Note: 'attempt_events_attempt_id_fkey: FOREIGN KEY (attempt_id) REFERENCES activity.attempts(id) ON DELETE CASCADE\nattempt_events_attempt_id_not_null: NOT NULL attempt_id\nattempt_events_created_at_not_null: NOT NULL created_at\nattempt_events_id_not_null: NOT NULL id\nattempt_events_metadata_not_null: NOT NULL metadata\nattempt_events_reason_not_null: NOT NULL reason\nattempt_events_to_state_not_null: NOT NULL to_state\nCREATE INDEX activity_attempt_events_idx ON activity.attempt_events USING btree (attempt_id, created_at)'
}

Table activity.attempts {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  activity_id uuid [not null]
  version_id uuid [not null]
  assignment_id uuid [null]
  participant_person_id uuid [not null]
  participant_account_id uuid [null]
  state "character varying(30)" [not null, default: `'CREATED'::character varying`]
  revision integer [not null, default: `1`]
  seed bigint [not null, default: `0`]
  idempotency_key "character varying(128)" [null]
  runtime_config jsonb [not null, default: `'{}'::jsonb`]
  draft_state jsonb [not null, default: `'{}'::jsonb`]
  telemetry jsonb [not null, default: `'{}'::jsonb`]
  answers jsonb [not null, default: `'{}'::jsonb`]
  evaluation jsonb [not null, default: `'{}'::jsonb`]
  raw_score numeric(10,2) [null]
  max_score numeric(10,2) [null]
  percentage numeric(5,2) [null]
  passed boolean [null]
  started_at "timestamp with time zone" [null]
  expires_at "timestamp with time zone" [null]
  submitted_at "timestamp with time zone" [null]
  evaluated_at "timestamp with time zone" [null]
  reviewer_person_id uuid [null]
  review_notes text [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  source_legacy_type "character varying(40)" [null]
  source_legacy_id uuid [null]
  indexes {
    (organization_id, participant_person_id, activity_id, created_at) [name: 'activity_attempts_participant_idx', type: btree]
    (version_id, state, participant_person_id) [name: 'activity_attempts_version_state_idx', type: btree]
  }
  Note: 'attempts_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES activity.items(id) ON DELETE CASCADE\nattempts_activity_id_not_null: NOT NULL activity_id\nattempts_answers_check: CHECK (jsonb_typeof(answers) = \'object\'::text)\nattempts_answers_not_null: NOT NULL answers\nattempts_assignment_id_fkey: FOREIGN KEY (assignment_id) REFERENCES activity.assignments(id) ON DELETE SET NULL\nattempts_created_at_not_null: NOT NULL created_at\nattempts_draft_state_check: CHECK (jsonb_typeof(draft_state) = \'object\'::text)\nattempts_draft_state_not_null: NOT NULL draft_state\nattempts_evaluation_check: CHECK (jsonb_typeof(evaluation) = \'object\'::text)\nattempts_evaluation_not_null: NOT NULL evaluation\nattempts_id_not_null: NOT NULL id\nattempts_organization_id_not_null: NOT NULL organization_id\nattempts_participant_person_id_not_null: NOT NULL participant_person_id\nattempts_revision_check: CHECK (revision > 0)\nattempts_revision_not_null: NOT NULL revision\nattempts_runtime_config_check: CHECK (jsonb_typeof(runtime_config) = \'object\'::text)\nattempts_runtime_config_not_null: NOT NULL runtime_config\nattempts_seed_not_null: NOT NULL seed\nattempts_state_check: CHECK (state::text = ANY (ARRAY[\'CREATED\'::character varying, \'IN_PROGRESS\'::character varying, \'SUBMITTED\'::character varying, \'PENDING_REVIEW\'::character varying, \'EVALUATED\'::character varying, \'COMPLETED\'::character varying, \'EXPIRED\'::character varying, \'CANCELLED\'::character varying, \'INVALIDATED\'::character varying]::text[]))\nattempts_state_not_null: NOT NULL state\nattempts_telemetry_check: CHECK (jsonb_typeof(telemetry) = \'object\'::text)\nattempts_telemetry_not_null: NOT NULL telemetry\nattempts_updated_at_not_null: NOT NULL updated_at\nattempts_version_id_fkey: FOREIGN KEY (version_id) REFERENCES activity.versions(id)\nattempts_version_id_not_null: NOT NULL version_id\nCREATE UNIQUE INDEX activity_attempts_idempotency_idx ON activity.attempts USING btree (organization_id, participant_person_id, activity_id, idempotency_key) WHERE (idempotency_key IS NOT NULL)\nCREATE INDEX activity_attempts_participant_idx ON activity.attempts USING btree (organization_id, participant_person_id, activity_id, created_at DESC)\nCREATE INDEX activity_attempts_version_state_idx ON activity.attempts USING btree (version_id, state, participant_person_id)'
}

Table activity.items {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  plugin_code "character varying(80)" [not null]
  author_person_id uuid [not null]
  author_account_id uuid [null]
  title "character varying(200)" [not null]
  description text [not null, default: `''::text`]
  status "character varying(24)" [not null, default: `'DRAFT'::character varying`]
  visibility "character varying(24)" [not null, default: `'organization'::character varying`]
  active_version_id uuid [null]
  tags jsonb [not null, default: `'[]'::jsonb`]
  source_legacy_type "character varying(40)" [null]
  source_legacy_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  deleted_at "timestamp with time zone" [null]
  indexes {
    (organization_id, status, plugin_code, updated_at) [name: 'activity_items_org_idx', type: btree]
  }
  Note: 'activity_items_active_version_fkey: FOREIGN KEY (active_version_id) REFERENCES activity.versions(id) ON DELETE SET NULL\nitems_author_person_id_not_null: NOT NULL author_person_id\nitems_created_at_not_null: NOT NULL created_at\nitems_description_not_null: NOT NULL description\nitems_id_not_null: NOT NULL id\nitems_organization_id_not_null: NOT NULL organization_id\nitems_plugin_code_fkey: FOREIGN KEY (plugin_code) REFERENCES activity.plugins(code)\nitems_plugin_code_not_null: NOT NULL plugin_code\nitems_status_check: CHECK (status::text = ANY (ARRAY[\'DRAFT\'::character varying, \'PUBLISHED\'::character varying, \'CLOSED\'::character varying, \'ARCHIVED\'::character varying]::text[]))\nitems_status_not_null: NOT NULL status\nitems_tags_check: CHECK (jsonb_typeof(tags) = \'array\'::text)\nitems_tags_not_null: NOT NULL tags\nitems_title_check: CHECK (btrim(title::text) <> \'\'::text)\nitems_title_not_null: NOT NULL title\nitems_updated_at_not_null: NOT NULL updated_at\nitems_visibility_check: CHECK (visibility::text = ANY (ARRAY[\'private\'::character varying, \'organization\'::character varying, \'group\'::character varying, \'public_catalog\'::character varying]::text[]))\nitems_visibility_not_null: NOT NULL visibility\nCREATE INDEX activity_items_fts_ru_idx ON activity.items USING gin (to_tsvector(\'russian\'::regconfig, (((COALESCE(title, \'\'::character varying))::text || \' \'::text) || COALESCE(description, \'\'::text))))\nCREATE INDEX activity_items_fts_simple_idx ON activity.items USING gin (to_tsvector(\'simple\'::regconfig, (((COALESCE(title, \'\'::character varying))::text || \' \'::text) || COALESCE(description, \'\'::text))))\nCREATE INDEX activity_items_legacy_idx ON activity.items USING btree (organization_id, source_legacy_type, source_legacy_id) WHERE (source_legacy_id IS NOT NULL)\nCREATE INDEX activity_items_org_idx ON activity.items USING btree (organization_id, status, plugin_code, updated_at DESC)\nCREATE INDEX activity_items_search_trgm_idx ON activity.items USING gin (title gin_trgm_ops, description gin_trgm_ops)'
}

Table activity.module_migrations {
  name text [pk, not null]
  sha256 character(64) [not null]
  applied_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'module_migrations_applied_at_not_null: NOT NULL applied_at\nmodule_migrations_name_not_null: NOT NULL name\nmodule_migrations_sha256_not_null: NOT NULL sha256'
}

Table activity.plugins {
  code "character varying(80)" [pk, not null]
  title "character varying(180)" [not null]
  description text [not null, default: `''::text`]
  category "character varying(60)" [not null, default: `'learning'::character varying`]
  contract_version integer [not null, default: `2`]
  capabilities jsonb [not null, default: `'[]'::jsonb`]
  config_schema jsonb [not null, default: `'{}'::jsonb`]
  default_config jsonb [not null, default: `'{}'::jsonb`]
  scoring_rules jsonb [not null, default: `'{}'::jsonb`]
  enabled boolean [not null, default: `true`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'plugins_capabilities_check: CHECK (jsonb_typeof(capabilities) = \'array\'::text)\nplugins_capabilities_not_null: NOT NULL capabilities\nplugins_category_not_null: NOT NULL category\nplugins_code_not_null: NOT NULL code\nplugins_config_schema_check: CHECK (jsonb_typeof(config_schema) = \'object\'::text)\nplugins_config_schema_not_null: NOT NULL config_schema\nplugins_contract_version_check: CHECK (contract_version > 0)\nplugins_contract_version_not_null: NOT NULL contract_version\nplugins_created_at_not_null: NOT NULL created_at\nplugins_default_config_check: CHECK (jsonb_typeof(default_config) = \'object\'::text)\nplugins_default_config_not_null: NOT NULL default_config\nplugins_description_not_null: NOT NULL description\nplugins_enabled_not_null: NOT NULL enabled\nplugins_scoring_rules_check: CHECK (jsonb_typeof(scoring_rules) = \'object\'::text)\nplugins_scoring_rules_not_null: NOT NULL scoring_rules\nplugins_title_not_null: NOT NULL title'
}

Table activity.question_bank {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  author_person_id uuid [not null]
  category "character varying(100)" [not null, default: `'general'::character varying`]
  tags jsonb [not null, default: `'[]'::jsonb`]
  difficulty integer [not null, default: `1`]
  question_type "character varying(30)" [not null]
  content jsonb [not null]
  answer_key jsonb [not null]
  explanation text [not null, default: `''::text`]
  default_points integer [not null, default: `1`]
  archived_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (organization_id, archived_at, category, difficulty) [name: 'activity_question_bank_org_idx', type: btree]
  }
  Note: 'question_bank_answer_key_not_null: NOT NULL answer_key\nquestion_bank_author_person_id_not_null: NOT NULL author_person_id\nquestion_bank_category_not_null: NOT NULL category\nquestion_bank_content_check: CHECK (jsonb_typeof(content) = \'object\'::text)\nquestion_bank_content_not_null: NOT NULL content\nquestion_bank_created_at_not_null: NOT NULL created_at\nquestion_bank_default_points_check: CHECK (default_points >= 1 AND default_points <= 100)\nquestion_bank_default_points_not_null: NOT NULL default_points\nquestion_bank_difficulty_check: CHECK (difficulty >= 1 AND difficulty <= 3)\nquestion_bank_difficulty_not_null: NOT NULL difficulty\nquestion_bank_explanation_not_null: NOT NULL explanation\nquestion_bank_id_not_null: NOT NULL id\nquestion_bank_organization_id_not_null: NOT NULL organization_id\nquestion_bank_question_type_check: CHECK (question_type::text = ANY (ARRAY[\'single_choice\'::character varying, \'multi_choice\'::character varying, \'true_false\'::character varying, \'short_text\'::character varying, \'numeric\'::character varying, \'matching\'::character varying, \'ordering\'::character varying, \'long_text\'::character varying]::text[]))\nquestion_bank_question_type_not_null: NOT NULL question_type\nquestion_bank_tags_check: CHECK (jsonb_typeof(tags) = \'array\'::text)\nquestion_bank_tags_not_null: NOT NULL tags\nquestion_bank_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX activity_question_bank_org_idx ON activity.question_bank USING btree (organization_id, archived_at, category, difficulty)'
}

Table activity.versions {
  id uuid [pk, not null, default: `uuidv7()`]
  activity_id uuid [not null]
  version_number integer [not null]
  title "character varying(200)" [not null]
  instructions text [not null, default: `''::text`]
  config jsonb [not null, default: `'{}'::jsonb`]
  content jsonb [not null, default: `'{}'::jsonb`]
  scoring_rules jsonb [not null, default: `'{}'::jsonb`]
  time_limit_seconds integer [null]
  max_attempts integer [not null, default: `0`]
  passing_score_percent integer [not null, default: `60`]
  grading_policy "character varying(30)" [not null, default: `'highest'::character varying`]
  created_by_person_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  reveal_answers_policy "character varying(30)" [not null, default: `'after_grading'::character varying`]
  indexes {
    (activity_id, version_number) [name: 'activity_versions_item_idx', type: btree]
    (activity_id, version_number) [name: 'versions_activity_id_version_number_key', type: btree, unique]
  }
  Note: 'activity_versions_reveal_policy_check: CHECK (reveal_answers_policy::text = ANY (ARRAY[\'never\'::character varying, \'immediate\'::character varying, \'after_grading\'::character varying, \'deadline\'::character varying]::text[]))\nversions_activity_id_fkey: FOREIGN KEY (activity_id) REFERENCES activity.items(id) ON DELETE CASCADE\nversions_activity_id_not_null: NOT NULL activity_id\nversions_activity_id_version_number_key: UNIQUE (activity_id, version_number)\nversions_config_check: CHECK (jsonb_typeof(config) = \'object\'::text)\nversions_config_not_null: NOT NULL config\nversions_content_check: CHECK (jsonb_typeof(content) = \'object\'::text)\nversions_content_not_null: NOT NULL content\nversions_created_at_not_null: NOT NULL created_at\nversions_grading_policy_check: CHECK (grading_policy::text = ANY (ARRAY[\'highest\'::character varying, \'latest\'::character varying, \'average\'::character varying, \'practice_no_grade\'::character varying]::text[]))\nversions_grading_policy_not_null: NOT NULL grading_policy\nversions_id_not_null: NOT NULL id\nversions_instructions_not_null: NOT NULL instructions\nversions_max_attempts_check: CHECK (max_attempts >= 0)\nversions_max_attempts_not_null: NOT NULL max_attempts\nversions_passing_score_percent_check: CHECK (passing_score_percent >= 0 AND passing_score_percent <= 100)\nversions_passing_score_percent_not_null: NOT NULL passing_score_percent\nversions_reveal_answers_policy_not_null: NOT NULL reveal_answers_policy\nversions_scoring_rules_check: CHECK (jsonb_typeof(scoring_rules) = \'object\'::text)\nversions_scoring_rules_not_null: NOT NULL scoring_rules\nversions_title_check: CHECK (btrim(title::text) <> \'\'::text)\nversions_title_not_null: NOT NULL title\nversions_version_number_check: CHECK (version_number > 0)\nversions_version_number_not_null: NOT NULL version_number\nCREATE INDEX activity_versions_item_idx ON activity.versions USING btree (activity_id, version_number DESC)\nCREATE INDEX activity_versions_reveal_policy_idx ON activity.versions USING btree (reveal_answers_policy, ((config ->> \'revealAnswersPolicy\'::text)))\nCREATE UNIQUE INDEX versions_activity_id_version_number_key ON activity.versions USING btree (activity_id, version_number)'
}

