// Только реальные объекты PostgreSQL. Полное определение SQL: schema.catalog.json.
Project device_management {
  database_type: 'PostgreSQL'
  Note: 'Каталог PostgreSQL после миграций. Межбазовые идентификаторы не являются внешними ключами.'
}

Table device_management.classrooms {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  owner_person_id uuid [not null]
  name "character varying(160)" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  archived_at "timestamp with time zone" [null]
  indexes {
    (id, organization_id, owner_account_id) [name: 'classrooms_id_organization_id_owner_account_id_key', type: btree, unique]
  }
  Note: 'classrooms_created_at_not_null: NOT NULL created_at\nclassrooms_id_not_null: NOT NULL id\nclassrooms_id_organization_id_owner_account_id_key: UNIQUE (id, organization_id, owner_account_id)\nclassrooms_name_check: CHECK (btrim(name::text) <> \'\'::text)\nclassrooms_name_not_null: NOT NULL name\nclassrooms_organization_id_not_null: NOT NULL organization_id\nclassrooms_owner_account_id_not_null: NOT NULL owner_account_id\nclassrooms_owner_person_id_not_null: NOT NULL owner_person_id\nCREATE UNIQUE INDEX classrooms_id_organization_id_owner_account_id_key ON device_management.classrooms USING btree (id, organization_id, owner_account_id)'
}

Table device_management.device_commands {
  id uuid [pk, not null, default: `uuidv7()`]
  device_id uuid [not null]
  kind "character varying(40)" [not null]
  payload jsonb [not null, default: `'{}'::jsonb`]
  state "character varying(16)" [not null, default: `'queued'::character varying`]
  expires_at "timestamp with time zone" [not null]
  delivered_at "timestamp with time zone" [null]
  acknowledged_at "timestamp with time zone" [null]
  authorized_by_account_id uuid [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (device_id, state, id) [name: 'device_commands_poll', type: btree]
  }
  Note: 'device_commands_created_at_not_null: NOT NULL created_at\ndevice_commands_device_id_fkey: FOREIGN KEY (device_id) REFERENCES device_management.devices(id)\ndevice_commands_device_id_not_null: NOT NULL device_id\ndevice_commands_expires_at_not_null: NOT NULL expires_at\ndevice_commands_id_not_null: NOT NULL id\ndevice_commands_kind_not_null: NOT NULL kind\ndevice_commands_payload_not_null: NOT NULL payload\ndevice_commands_state_check: CHECK (state::text = ANY (ARRAY[\'queued\'::character varying, \'delivered\'::character varying, \'acknowledged\'::character varying, \'expired\'::character varying]::text[]))\ndevice_commands_state_not_null: NOT NULL state\nCREATE INDEX device_commands_poll ON device_management.device_commands USING btree (device_id, state, id)'
}

Table device_management.device_credentials {
  id uuid [pk, not null, default: `uuidv7()`]
  device_id uuid [not null]
  credential_hash character(64) [not null]
  revoked_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    credential_hash [name: 'device_credentials_credential_hash_key', type: btree, unique]
  }
  Note: 'device_credentials_created_at_not_null: NOT NULL created_at\ndevice_credentials_credential_hash_key: UNIQUE (credential_hash)\ndevice_credentials_credential_hash_not_null: NOT NULL credential_hash\ndevice_credentials_device_id_fkey: FOREIGN KEY (device_id) REFERENCES device_management.devices(id)\ndevice_credentials_device_id_not_null: NOT NULL device_id\ndevice_credentials_id_not_null: NOT NULL id\nCREATE UNIQUE INDEX device_credentials_credential_hash_key ON device_management.device_credentials USING btree (credential_hash)\nCREATE INDEX device_credentials_device ON device_management.device_credentials USING btree (device_id) WHERE (revoked_at IS NULL)'
}

Table device_management.device_enrollments {
  id uuid [pk, not null, default: `uuidv7()`]
