    (classroom_id, number) [name: 'workstations_classroom_id_number_key', type: btree, unique]
  }
  Note: 'workstations_classroom_id_not_null: NOT NULL classroom_id\nworkstations_classroom_id_number_key: UNIQUE (classroom_id, number)\nworkstations_classroom_id_organization_id_owner_account_id_fkey: FOREIGN KEY (classroom_id, organization_id, owner_account_id) REFERENCES device_management.classrooms(id, organization_id, owner_account_id)\nworkstations_id_not_null: NOT NULL id\nworkstations_name_not_null: NOT NULL name\nworkstations_number_check: CHECK (btrim(number::text) <> \'\'::text)\nworkstations_number_not_null: NOT NULL number\nworkstations_organization_id_not_null: NOT NULL organization_id\nworkstations_owner_account_id_not_null: NOT NULL owner_account_id\nCREATE UNIQUE INDEX workstations_classroom_id_number_key ON device_management.workstations USING btree (classroom_id, number)'
}

