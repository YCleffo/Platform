  used_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    code_hash [name: 'device_enrollments_code_hash_key', type: btree, unique]
  }
  Note: 'device_enrollments_code_hash_key: UNIQUE (code_hash)\ndevice_enrollments_code_hash_not_null: NOT NULL code_hash\ndevice_enrollments_created_at_not_null: NOT NULL created_at\ndevice_enrollments_device_id_fkey: FOREIGN KEY (device_id) REFERENCES device_management.devices(id)\ndevice_enrollments_device_id_not_null: NOT NULL device_id\ndevice_enrollments_expires_at_not_null: NOT NULL expires_at\ndevice_enrollments_id_not_null: NOT NULL id\nCREATE UNIQUE INDEX device_enrollments_code_hash_key ON device_management.device_enrollments USING btree (code_hash)'
}

Table device_management.device_events {
  id uuid [pk, not null, default: `uuidv7()`]
  device_id uuid [not null]
  kind "character varying(60)" [not null]
  payload jsonb [not null, default: `'{}'::jsonb`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (device_id, id) [name: 'device_events_device', type: btree]
  }
  Note: 'device_events_created_at_not_null: NOT NULL created_at\ndevice_events_device_id_fkey: FOREIGN KEY (device_id) REFERENCES device_management.devices(id)\ndevice_events_device_id_not_null: NOT NULL device_id\ndevice_events_id_not_null: NOT NULL id\ndevice_events_kind_not_null: NOT NULL kind\ndevice_events_payload_not_null: NOT NULL payload\nCREATE INDEX device_events_device ON device_management.device_events USING btree (device_id, id)'
}

Table device_management.device_heartbeats {
  device_id uuid [not null]
  received_at "timestamp with time zone" [not null, default: `now()`]
  state jsonb [not null, default: `'{}'::jsonb`]
  indexes {
    (device_id, received_at) [pk]
  }
  Note: 'device_heartbeats_device_id_fkey: FOREIGN KEY (device_id) REFERENCES device_management.devices(id)\ndevice_heartbeats_device_id_not_null: NOT NULL device_id\ndevice_heartbeats_received_at_not_null: NOT NULL received_at\ndevice_heartbeats_state_not_null: NOT NULL state'
}

Table device_management.device_sessions {
  id uuid [pk, not null, default: `uuidv7()`]
  device_id uuid [not null]
  student_id uuid [not null]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  status "character varying(24)" [not null, default: `'AUTHORIZED'::character varying`]
  desired_status "character varying(24)" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  started_at "timestamp with time zone" [not null, default: `now()`]
  ended_at "timestamp with time zone" [null]
  evidence jsonb [not null, default: `'{}'::jsonb`]
  classroom_id uuid [null]
  indexes {
    (device_id, created_at, id) [name: 'device_sessions_history', type: btree]
  }
  Note: 'device_sessions_created_at_not_null: NOT NULL created_at\ndevice_sessions_desired_status_check: CHECK (desired_status IS NULL OR (desired_status::text = ANY (ARRAY[\'AUTHORIZED\'::character varying, \'PREPARING\'::character varying, \'WINDOWS_PROFILE_READY\'::character varying, \'SYNCING_IN\'::character varying, \'ACTIVE\'::character varying, \'ENDING\'::character varying, \'SYNCING_OUT\'::character varying, \'STORAGE_CONFIRMED\'::character varying, \'CLEANUP\'::character varying, \'CLOSED\'::character varying, \'SYNC_PENDING\'::character varying, \'RECOVERY_REQUIRED\'::character varying, \'FAILED\'::character varying]::text[])))\ndevice_sessions_device_id_fkey: FOREIGN KEY (device_id) REFERENCES device_management.devices(id)\ndevice_sessions_device_id_not_null: NOT NULL device_id\ndevice_sessions_evidence_not_null: NOT NULL evidence\ndevice_sessions_id_not_null: NOT NULL id\ndevice_sessions_organization_id_not_null: NOT NULL organization_id\ndevice_sessions_owner_account_id_not_null: NOT NULL owner_account_id\ndevice_sessions_started_at_not_null: NOT NULL started_at\ndevice_sessions_status_check: CHECK (status::text = ANY (ARRAY[\'AUTHORIZED\'::character varying, \'PREPARING\'::character varying, \'WINDOWS_PROFILE_READY\'::character varying, \'SYNCING_IN\'::character varying, \'ACTIVE\'::character varying, \'ENDING\'::character varying, \'SYNCING_OUT\'::character varying, \'STORAGE_CONFIRMED\'::character varying, \'CLEANUP\'::character varying, \'CLOSED\'::character varying, \'SYNC_PENDING\'::character varying, \'RECOVERY_REQUIRED\'::character varying, \'FAILED\'::character varying]::text[]))\ndevice_sessions_status_not_null: NOT NULL status\ndevice_sessions_student_id_not_null: NOT NULL student_id\nCREATE UNIQUE INDEX device_sessions_active ON device_management.device_sessions USING btree (device_id) WHERE ((status)::text <> ALL ((ARRAY[\'CLOSED\'::character varying, \'FAILED\'::character varying])::text[]))\nCREATE INDEX device_sessions_history ON device_management.device_sessions USING btree (device_id, created_at DESC, id DESC)'
}

Table device_management.devices {
  id uuid [pk, not null, default: `uuidv7()`]
  organization_id uuid [not null]
  owner_account_id uuid [not null]
  owner_person_id uuid [not null]
  classroom_id uuid [null]
  workstation_id uuid [null]
  name "character varying(160)" [not null, default: `''::character varying`]
  number "character varying(40)" [not null, default: `''::character varying`]
  status "character varying(24)" [not null, default: `'OFFLINE'::character varying`]
  enrollment_state "character varying(20)" [not null, default: `'pending'::character varying`]
  last_seen_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  state_version bigint [not null, default: `0`]
  agent_state jsonb [not null, default: `'{}'::jsonb`]
  indexes {
    (id, organization_id, owner_account_id) [name: 'devices_id_organization_id_owner_account_id_key', type: btree, unique]
    (organization_id, owner_account_id, created_at, id) [name: 'devices_owner', type: btree]
  }
  Note: 'devices_agent_state_not_null: NOT NULL agent_state\ndevices_classroom_id_organization_id_owner_account_id_fkey: FOREIGN KEY (classroom_id, organization_id, owner_account_id) REFERENCES device_management.classrooms(id, organization_id, owner_account_id)\ndevices_created_at_not_null: NOT NULL created_at\ndevices_enrollment_state_check: CHECK (enrollment_state::text = ANY (ARRAY[\'pending\'::character varying, \'confirmed\'::character varying, \'revoked\'::character varying]::text[]))\ndevices_enrollment_state_not_null: NOT NULL enrollment_state\ndevices_id_not_null: NOT NULL id\ndevices_id_organization_id_owner_account_id_key: UNIQUE (id, organization_id, owner_account_id)\ndevices_name_not_null: NOT NULL name\ndevices_number_not_null: NOT NULL number\ndevices_organization_id_not_null: NOT NULL organization_id\ndevices_owner_account_id_not_null: NOT NULL owner_account_id\ndevices_owner_person_id_not_null: NOT NULL owner_person_id\ndevices_state_version_not_null: NOT NULL state_version\ndevices_status_check: CHECK (status::text = ANY (ARRAY[\'OFFLINE\'::character varying, \'AVAILABLE\'::character varying, \'RESERVED\'::character varying, \'PREPARING\'::character varying, \'SYNCING_IN\'::character varying, \'ACTIVE\'::character varying, \'SYNCING_OUT\'::character varying, \'CLEANUP\'::character varying, \'RECOVERY_REQUIRED\'::character varying, \'ERROR\'::character varying]::text[]))\ndevices_status_not_null: NOT NULL status\ndevices_workstation_id_fkey: FOREIGN KEY (workstation_id) REFERENCES device_management.workstations(id)\nCREATE UNIQUE INDEX devices_classroom_number ON device_management.devices USING btree (classroom_id, number) WHERE ((classroom_id IS NOT NULL) AND ((number)::text <> \'\'::text))\nCREATE UNIQUE INDEX devices_id_organization_id_owner_account_id_key ON device_management.devices USING btree (id, organization_id, owner_account_id)\nCREATE INDEX devices_owner ON device_management.devices USING btree (organization_id, owner_account_id, created_at, id)'
}

