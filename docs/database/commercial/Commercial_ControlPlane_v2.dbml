lan_price_idx ON commercial.invoice_lines USING btree (plan_price_id)\nCREATE INDEX invoice_lines_subscription_item_idx ON commercial.invoice_lines USING btree (subscription_item_id)\nCREATE TRIGGER invoice_line_contract_guard BEFORE INSERT OR DELETE OR UPDATE ON commercial.invoice_lines FOR EACH ROW EXECUTE FUNCTION commercial.enforce_invoice_line_contract()'
