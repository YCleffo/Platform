Table commercial.invoices {
  id uuid [pk, not null, default: `uuidv7()`]
  commercial_account_id uuid [not null]
  subscription_id uuid [not null]
  billing_profile_id uuid [not null]
  billing_reason "character varying(40)" [not null]
  currency character(3) [not null]
  total_minor bigint [not null, default: `0`]
  status "character varying(16)" [not null, default: `'draft'::character varying`]
  bill_to_legal_name "character varying(240)" [not null]
  bill_to_country_code character(2) [not null]
  bill_to_contact_name "character varying(200)" [null]
  bill_to_contact_email "character varying(320)" [null]
  bill_to_tax_identifier "character varying(80)" [null]
  bill_to_address jsonb [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  issued_at "timestamp with time zone" [null]
  paid_at "timestamp with time zone" [null]
  voided_at "timestamp with time zone" [null]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  service_period_start "timestamp with time zone" [null]
  service_period_end "timestamp with time zone" [null]
  indexes {
    (commercial_account_id, created_at, id) [name: 'invoices_account_history_idx', type: btree]
    (commercial_account_id, subscription_id, id) [name: 'invoices_account_subscription_id_uidx', type: btree, unique]
    (subscription_id, created_at, id) [name: 'invoices_subscription_history_idx', type: btree]
  }
  Note: 'invoices_address_check: CHECK (jsonb_typeof(bill_to_address) = \'object\'::text)\ninvoices_bill_to_address_not_null: NOT NULL bill_to_address\ninvoices_bill_to_country_code_not_null: NOT NULL bill_to_country_code\ninvoices_bill_to_legal_name_not_null: NOT NULL bill_to_legal_name\ninvoices_billing_profile_id_fkey: FOREIGN KEY (billing_profile_id) REFERENCES commercial.billing_profiles(id) ON DELETE RESTRICT\ninvoices_billing_profile_id_not_null: NOT NULL billing_profile_id\ninvoices_billing_reason_not_null: NOT NULL billing_reason\ninvoices_commercial_account_id_fkey: FOREIGN KEY (commercial_account_id) REFERENCES commercial.commercial_accounts(id) ON DELETE RESTRICT\ninvoices_commercial_account_id_not_null: NOT NULL commercial_account_id\ninvoices_contact_email_check: CHECK (bill_to_contact_email IS NULL OR bill_to_contact_email::text = lower(btrim(bill_to_contact_email::text)) AND length(bill_to_contact_email::text) >= 3 AND length(bill_to_contact_email::text) <= 320 AND bill_to_contact_email::text !~ \'[[:cntrl:]]\'::text AND POSITION((\'@\'::text) IN (bill_to_contact_email)) > 1)\ninvoices_contact_name_check: CHECK (bill_to_contact_name IS NULL OR btrim(bill_to_contact_name::text) <> \'\'::text AND bill_to_contact_name::text !~ \'[[:cntrl:]]\'::text)\ninvoices_country_check: CHECK (bill_to_country_code ~ \'^[A-Z]{2}$\'::text)\ninvoices_created_at_not_null: NOT NULL created_at\ninvoices_currency_check: CHECK (currency ~ \'^[A-Z]{3}$\'::text)\ninvoices_currency_not_null: NOT NULL currency\ninvoices_id_not_null: NOT NULL id\ninvoices_legal_name_check: CHECK (btrim(bill_to_legal_name::text) <> \'\'::text AND bill_to_legal_name::text !~ \'[[:cntrl:]]\'::text)\ninvoices_reason_check: CHECK (billing_reason::text = ANY (ARRAY[\'subscription_create\'::character varying, \'subscription_renewal\'::character varying]::text[]))\ninvoices_service_period_check: CHECK (billing_reason::text = \'subscription_create\'::text AND service_period_start IS NULL AND service_period_end IS NULL OR billing_reason::text = \'subscription_renewal\'::text AND service_period_start IS NOT NULL AND service_period_end > service_period_start)\ninvoices_status_check: CHECK (status::text = ANY (ARRAY[\'draft\'::character varying, \'issued\'::character varying, \'paid\'::character varying, \'void\'::character varying]::text[]))\ninvoices_status_not_null: NOT NULL status\ninvoices_status_timestamps_check: CHECK (status::text = \'draft\'::text AND issued_at IS NULL AND paid_at IS NULL AND voided_at IS NULL OR status::text = \'issued\'::text AND issued_at IS NOT NULL AND paid_at IS NULL AND voided_at IS NULL OR status::text = \'paid\'::text AND issued_at IS NOT NULL AND paid_at IS NOT NULL AND voided_at IS NULL OR status::text = \'void\'::text AND paid_at IS NULL AND voided_at IS NOT NULL)\ninvoices_subscription_id_fkey: FOREIGN KEY (subscription_id) REFERENCES commercial.subscriptions(id) ON DELETE RESTRICT\ninvoices_subscription_id_not_null: NOT NULL subscription_id\ninvoices_tax_check: CHECK (bill_to_tax_identifier IS NULL OR btrim(bill_to_tax_identifier::text) <> \'\'::text AND bill_to_tax_identifier::text !~ \'[[:cntrl:]]\'::text)\ninvoices_total_check: CHECK (total_minor >= 0)\ninvoices_total_minor_not_null: NOT NULL total_minor\ninvoices_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX invoices_account_history_idx ON commercial.invoices USING btree (commercial_account_id, created_at DESC, id)\nCREATE UNIQUE INDEX invoices_account_subscription_id_uidx ON commercial.invoices USING btree (commercial_account_id, subscription_id, id)\nCREATE UNIQUE INDEX invoices_one_current_initial_uidx ON commercial.invoices USING btree (subscription_id) WHERE (((billing_reason)::text = \'subscription_create\'::text) AND ((status)::text = ANY ((ARRAY[\'issued\'::character varying, \'paid\'::character varying])::text[])))\nCREATE UNIQUE INDEX invoices_one_current_renewal_period_uidx ON commercial.invoices USING btree (subscription_id, service_period_start, service_period_end) WHERE (((billing_reason)::text = \'subscription_renewal\'::text) AND ((status)::text = ANY ((ARRAY[\'issued\'::character varying, \'paid\'::character varying])::text[])))\nCREATE INDEX invoices_subscription_history_idx ON commercial.invoices USING btree (subscription_id, created_at DESC, id)\nCREATE TRIGGER invoice_contract_guard BEFORE INSERT OR DELETE OR UPDATE ON commercial.invoices FOR EACH ROW EXECUTE FUNCTION commercial.enforce_invoice_contract()'
}

