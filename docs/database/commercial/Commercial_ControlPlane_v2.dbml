ription_id) REFERENCES commercial.subscriptions(id) ON DELETE RESTRICT\nsubscription_plan_changes_target_subscription_id_key: UNIQUE (target_subscription_id)\nsubscription_plan_changes_target_subscription_id_not_null: NOT NULL target_subscription_id\nsubscription_plan_changes_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX plan_changes_due_idx ON commercial.subscription_plan_changes USING btree (period_end, id) WHERE ((status)::text = \'scheduled\'::text)\nCREATE UNIQUE INDEX plan_changes_one_open_source_uidx ON commercial.subscription_plan_changes USING btree (source_subscription_id) WHERE ((status)::text = ANY ((ARRAY[\'scheduled\'::character varying, \'payment_required\'::character varying, \'paid_unapplied\'::character varying])::text[]))\nCREATE INDEX plan_changes_recovery_idx ON commercial.subscription_plan_changes USING btree (updated_at, id) WHERE ((compensation_status)::text = \'recovery_required\'::text)\nCREATE UNIQUE INDEX subscription_plan_changes_commercial_account_id_idempotency_key ON commercial.subscription_plan_changes USING btree (commercial_account_id, idempotency_key)\nCREATE UNIQUE INDEX subscription_plan_changes_invoice_id_key ON commercial.subscription_plan_changes USING btree (invoice_id)\nCREATE UNIQUE INDEX subscription_plan_changes_target_subscription_id_key ON commercial.subscription_plan_changes USING btree (target_subscription_id)\nCREATE TRIGGER subscription_plan_change_guard BEFORE DELETE OR UPDATE ON commercial.subscription_plan_changes FOR EACH ROW EXECUTE FUNCTION commercial.guard_subscription_plan_change()'
