    (provider_account_id, provider_request_key) [name: 'payment_attempts_provider_account_id_provider_request_key_key', type: btree, unique]
  }
  Note: 'payment_attempts_created_at_not_null: NOT NULL created_at\npayment_attempts_failure_check: CHECK (failure_code IS NULL OR status::text = \'failed\'::text AND failure_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\npayment_attempts_id_not_null: NOT NULL id\npayment_attempts_method_check: CHECK (method_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\npayment_attempts_method_type_not_null: NOT NULL method_type\npayment_attempts_payment_id_fkey: FOREIGN KEY (payment_id) REFERENCES commercial.payments(id) ON DELETE RESTRICT\npayment_attempts_payment_id_not_null: NOT NULL payment_id\npayment_attempts_provider_account_id_fkey: FOREIGN KEY (provider_account_id) REFERENCES commercial.payment_provider_accounts(id) ON DELETE RESTRICT\npayment_attempts_provider_account_id_not_null: NOT NULL provider_account_id\npayment_attempts_provider_account_id_provider_request_key_key: UNIQUE (provider_account_id, provider_request_key)\npayment_attempts_provider_id_check: CHECK (provider_payment_id IS NULL OR btrim(provider_payment_id::text) <> \'\'::text AND provider_payment_id::text !~ \'[[:cntrl:]]\'::text)\npayment_attempts_provider_request_key_not_null: NOT NULL provider_request_key\npayment_attempts_request_key_check: CHECK (btrim(provider_request_key::text) <> \'\'::text AND provider_request_key::text !~ \'[[:cntrl:]]\'::text)\npayment_attempts_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'succeeded\'::character varying, \'failed\'::character varying, \'cancelled\'::character varying]::text[]))\npayment_attempts_status_not_null: NOT NULL status\npayment_attempts_timestamp_check: CHECK (status::text = \'pending\'::text AND completed_at IS NULL OR status::text <> \'pending\'::text AND completed_at IS NOT NULL)\nCREATE UNIQUE INDEX payment_attempts_one_pending_uidx ON commercial.payment_attempts USING btree (payment_id) WHERE ((status)::text = \'pending\'::text)\nCREATE INDEX payment_attempts_payment_history_idx ON commercial.payment_attempts USING btree (payment_id, created_at, id)\nCREATE UNIQUE INDEX payment_attempts_provider_account_id_provider_request_key_key ON commercial.payment_attempts USING btree (provider_account_id, provider_request_key)\nCREATE UNIQUE INDEX payment_attempts_provider_payment_uidx ON commercial.payment_attempts USING btree (provider_account_id, provider_payment_id) WHERE (provider_payment_id IS NOT NULL)\nCREATE TRIGGER payment_attempt_contract_guard BEFORE INSERT OR DELETE OR UPDATE ON commercial.payment_attempts FOR EACH ROW EXECUTE FUNCTION commercial.enforce_payment_attempt_contract()'
}

Table commercial.payment_provider_accounts {
  id uuid [pk, not null, default: `uuidv7()`]
