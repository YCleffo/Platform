ed_at\nCREATE INDEX saved_payment_methods_account_idx ON commercial.saved_payment_methods USING btree (commercial_account_id, status, created_at DESC)\nCREATE UNIQUE INDEX saved_payment_methods_one_default_uidx ON commercial.saved_payment_methods USING btree (commercial_account_id) WHERE (is_default AND ((status)::text = \'active\'::text))\nCREATE UNIQUE INDEX saved_payment_methods_provider_reference_uidx ON commercial.saved_payment_methods USING btree (provider_account_id, provider_method_reference)\nCREATE TRIGGER saved_payment_methods_contract BEFORE DELETE OR UPDATE ON commercial.saved_payment_methods FOR EACH ROW EXECUTE FUNCTION commercial.protect_saved_payment_method()'
