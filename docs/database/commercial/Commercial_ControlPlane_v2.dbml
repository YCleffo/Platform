  }
  Note: 'subscription_usage_period_consistency: TRIGGER DEFERRABLE INITIALLY DEFERRED\nsubscriptions_active_period_check: CHECK (status::text <> \'active\'::text OR current_period_start IS NOT NULL AND current_period_end IS NOT NULL)\nsubscriptions_auto_renew_enabled_not_null: NOT NULL auto_renew_enabled\nsubscriptions_billing_grace_check: CHECK (billing_status::text = \'current\'::text AND past_due_since IS NULL AND grace_until IS NULL OR billing_status::text = \'past_due\'::text AND past_due_since IS NOT NULL AND grace_until IS NOT NULL AND grace_until >= past_due_since)\nsubscriptions_billing_profile_id_fkey: FOREIGN KEY (billing_profile_id) REFERENCES commercial.billing_profiles(id) ON DELETE RESTRICT\nsubscriptions_billing_profile_id_not_null: NOT NULL billing_profile_id\nsubscriptions_billing_status_check: CHECK (billing_status::text = ANY (ARRAY[\'current\'::character varying, \'past_due\'::character varying]::text[]))\nsubscriptions_billing_status_not_null: NOT NULL billing_status\nsubscriptions_commercial_account_id_fkey: FOREIGN KEY (commercial_account_id) REFERENCES commercial.commercial_accounts(id) ON DELETE RESTRICT\nsubscriptions_commercial_account_id_not_null: NOT NULL commercial_account_id\nsubscriptions_created_at_not_null: NOT NULL created_at\nsubscriptions_draft_period_check: CHECK (status::text <> \'draft\'::text OR current_period_start IS NULL)\nsubscriptions_id_not_null: NOT NULL id\nsubscriptions_period_order_check: CHECK (current_period_end IS NULL OR current_period_end > current_period_start)\nsubscriptions_period_pair_check: CHECK ((current_period_start IS NULL) = (current_period_end IS NULL))\nsubscriptions_status_check: CHECK (status::text = ANY (ARRAY[\'draft\'::character varying, \'active\'::character varying, \'cancelled\'::character varying, \'expired\'::character varying]::text[]))\nsubscriptions_status_not_null: NOT NULL status\nsubscriptions_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX subscriptions_account_history_idx ON commercial.subscriptions USING btree (commercial_account_id, created_at DESC)\nCREATE UNIQUE INDEX subscriptions_account_id_uidx ON commercial.subscriptions USING btree (commercial_account_id, id)\nCREATE INDEX subscriptions_billing_due_idx ON commercial.subscriptions USING btree (billing_status, grace_until) WHERE ((status)::text = \'active\'::text)\nCREATE UNIQUE INDEX subscriptions_one_active_per_account_uidx ON commercial.subscriptions USING btree (commercial_account_id) WHERE ((status)::text = \'active\'::text)\nCREATE UNIQUE INDEX subscriptions_one_draft_per_account_uidx ON commercial.subscriptions USING btree (commercial_account_id) WHERE ((status)::text = \'draft\'::text)\nCREATE TRIGGER subscription_transition BEFORE UPDATE ON commercial.subscriptions FOR EACH ROW EXECUTE FUNCTION commercial.enforce_subscription_transition()\nCREATE CONSTRAINT TRIGGER subscription_usage_period_consistency AFTER INSERT OR UPDATE ON commercial.subscriptions DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION commercial.assert_subscription_usage_period()'
}

Table commercial.usage_counters {
  usage_period_id uuid [not null]
  feature_id uuid [not null]
  quantity bigint [not null, default: `0`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (usage_period_id, feature_id) [pk]
    feature_id [name: 'usage_counters_feature_idx', type: btree]
  }
  Note: 'usage_counters_feature_id_fkey: FOREIGN KEY (feature_id) REFERENCES commercial.features(id) ON DELETE RESTRICT\nusage_counters_feature_id_not_null: NOT NULL feature_id\nusage_counters_quantity_check: CHECK (quantity >= 0)\nusage_counters_quantity_not_null: NOT NULL quantity\nusage_counters_updated_at_not_null: NOT NULL updated_at\nusage_counters_usage_period_id_fkey: FOREIGN KEY (usage_period_id) REFERENCES commercial.usage_periods(id) ON DELETE RESTRICT\nusage_counters_usage_period_id_not_null: NOT NULL usage_period_id\nCREATE INDEX usage_counters_feature_idx ON commercial.usage_counters USING btree (feature_id)\nCREATE TRIGGER usage_counter_guard BEFORE INSERT OR DELETE OR UPDATE ON commercial.usage_counters FOR EACH ROW EXECUTE FUNCTION commercial.protect_usage_counter()'
}

Table commercial.usage_periods {
  id uuid [pk, not null, default: `uuidv7()`]
  subscription_id uuid [not null]
  starts_at "timestamp with time zone" [not null]
  ends_at "timestamp with time zone" [not null]
  status "character varying(16)" [not null, default: `'open'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  closed_at "timestamp with time zone" [null]
  indexes {
    (subscription_id, starts_at) [name: 'usage_periods_subscription_history_idx', type: btree]
  }
  Note: 'usage_period_subscription_consistency: TRIGGER DEFERRABLE INITIALLY DEFERRED\nusage_periods_bounds_check: CHECK (ends_at > starts_at)\nusage_periods_closed_check: CHECK (status::text = \'open\'::text AND closed_at IS NULL OR status::text = \'closed\'::text AND closed_at IS NOT NULL)\nusage_periods_created_at_not_null: NOT NULL created_at\nusage_periods_ends_at_not_null: NOT NULL ends_at\nusage_periods_id_not_null: NOT NULL id\nusage_periods_starts_at_not_null: NOT NULL starts_at\nusage_periods_status_check: CHECK (status::text = ANY (ARRAY[\'open\'::character varying, \'closed\'::character varying]::text[]))\nusage_periods_status_not_null: NOT NULL status\nusage_periods_subscription_id_fkey: FOREIGN KEY (subscription_id) REFERENCES commercial.subscriptions(id) ON DELETE RESTRICT\nusage_periods_subscription_id_not_null: NOT NULL subscription_id\nCREATE UNIQUE INDEX usage_periods_one_open_per_subscription_uidx ON commercial.usage_periods USING btree (subscription_id) WHERE ((status)::text = \'open\'::text)\nCREATE INDEX usage_periods_subscription_history_idx ON commercial.usage_periods USING btree (subscription_id, starts_at DESC)\nCREATE TRIGGER usage_period_guard BEFORE DELETE OR UPDATE ON commercial.usage_periods FOR EACH ROW EXECUTE FUNCTION commercial.protect_usage_period()\nCREATE CONSTRAINT TRIGGER usage_period_subscription_consistency AFTER INSERT OR UPDATE ON commercial.usage_periods DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION commercial.assert_subscription_usage_period()'
}

