  indexes {
    (commercial_account_id, created_at, id) [name: 'payments_account_history_idx', type: btree]
    invoice_id [name: 'payments_invoice_id_key', type: btree, unique]
  }
  Note: 'payments_amount_check: CHECK (amount_minor >= 0)\npayments_amount_minor_not_null: NOT NULL amount_minor\npayments_commercial_account_id_fkey: FOREIGN KEY (commercial_account_id) REFERENCES commercial.commercial_accounts(id) ON DELETE RESTRICT\npayments_commercial_account_id_not_null: NOT NULL commercial_account_id\npayments_created_at_not_null: NOT NULL created_at\npayments_currency_check: CHECK (currency ~ \'^[A-Z]{3}$\'::text)\npayments_currency_not_null: NOT NULL currency\npayments_id_not_null: NOT NULL id\npayments_invoice_id_fkey: FOREIGN KEY (invoice_id) REFERENCES commercial.invoices(id) ON DELETE RESTRICT\npayments_invoice_id_key: UNIQUE (invoice_id)\npayments_invoice_id_not_null: NOT NULL invoice_id\npayments_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'succeeded\'::character varying, \'cancelled\'::character varying]::text[]))\npayments_status_not_null: NOT NULL status\npayments_status_timestamps_check: CHECK (status::text = \'pending\'::text AND succeeded_at IS NULL AND cancelled_at IS NULL OR status::text = \'succeeded\'::text AND succeeded_at IS NOT NULL AND cancelled_at IS NULL OR status::text = \'cancelled\'::text AND succeeded_at IS NULL AND cancelled_at IS NOT NULL)\npayments_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX payments_account_history_idx ON commercial.payments USING btree (commercial_account_id, created_at DESC, id)\nCREATE UNIQUE INDEX payments_invoice_id_key ON commercial.payments USING btree (invoice_id)\nCREATE TRIGGER payment_contract_guard BEFORE INSERT OR DELETE OR UPDATE ON commercial.payments FOR EACH ROW EXECUTE FUNCTION commercial.enforce_payment_contract()'
}

