  source_fingerprint bytea [not null]
  issued_at "timestamp with time zone" [not null]
  valid_from "timestamp with time zone" [not null]
  valid_until "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (deployment_id, sequence) [name: 'deployment_entitlement_documents_deployment_id_sequence_key', type: btree, unique]
    (deployment_id, sequence) [name: 'deployment_entitlement_latest_idx', type: btree]
  }
  Note: 'deployment_entitlement_bytes_check: CHECK (octet_length(canonical_document) > 0 AND octet_length(document_sha256) = 32 AND octet_length(signature) = 64 AND octet_length(source_fingerprint) = 32)\ndeployment_entitlement_documents_canonical_document_not_null: NOT NULL canonical_document\ndeployment_entitlement_documents_created_at_not_null: NOT NULL created_at\ndeployment_entitlement_documents_deployment_id_fkey: FOREIGN KEY (deployment_id) REFERENCES commercial.deployments(id) ON DELETE RESTRICT\ndeployment_entitlement_documents_deployment_id_not_null: NOT NULL deployment_id\ndeployment_entitlement_documents_deployment_id_sequence_key: UNIQUE (deployment_id, sequence)\ndeployment_entitlement_documents_document_sha256_not_null: NOT NULL document_sha256\ndeployment_entitlement_documents_document_version_not_null: NOT NULL document_version\ndeployment_entitlement_documents_id_not_null: NOT NULL id\ndeployment_entitlement_documents_installation_id_not_null: NOT NULL installation_id\ndeployment_entitlement_documents_issued_at_not_null: NOT NULL issued_at\ndeployment_entitlement_documents_sequence_not_null: NOT NULL sequence\ndeployment_entitlement_documents_signature_not_null: NOT NULL signature\ndeployment_entitlement_documents_signing_key_id_fkey: FOREIGN KEY (signing_key_id) REFERENCES commercial.signing_keys(key_id) ON DELETE RESTRICT\ndeployment_entitlement_documents_signing_key_id_not_null: NOT NULL signing_key_id\ndeployment_entitlement_documents_source_fingerprint_not_null: NOT NULL source_fingerprint\ndeployment_entitlement_documents_valid_from_not_null: NOT NULL valid_from\ndeployment_entitlement_sequence_check: CHECK (sequence > 0)\ndeployment_entitlement_validity_check: CHECK (valid_until IS NULL OR valid_until > valid_from)\ndeployment_entitlement_version_check: CHECK (document_version = 1)\nCREATE UNIQUE INDEX deployment_entitlement_documents_deployment_id_sequence_key ON commercial.deployment_entitlement_documents USING btree (deployment_id, sequence)\nCREATE INDEX deployment_entitlement_latest_idx ON commercial.deployment_entitlement_documents USING btree (deployment_id, sequence DESC)\nCREATE TRIGGER deployment_entitlement_immutable BEFORE DELETE OR UPDATE ON commercial.deployment_entitlement_documents FOR EACH ROW EXECUTE FUNCTION commercial.reject_mutation()'
}

Table commercial.deployment_operations {
  id uuid [pk, not null, default: `uuidv7()`]
  deployment_id uuid [not null]
  operation_type "character varying(32)" [not null]
  idempotency_key "character varying(200)" [not null]
  status "character varying(24)" [not null, default: `'pending'::character varying`]
  current_step "character varying(120)" [null]
  attempt_count integer [not null, default: `0`]
  next_retry_at "timestamp with time zone" [null]
  last_error_code "character varying(120)" [null]
  started_at "timestamp with time zone" [null]
  finished_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  indexes {
    (deployment_id, idempotency_key) [name: 'deployment_operations_deployment_id_idempotency_key_key', type: btree, unique]
  }
  Note: 'deployment_operation_attempts_check: CHECK (attempt_count >= 0)\ndeployment_operation_error_check: CHECK (last_error_code IS NULL OR last_error_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\ndeployment_operation_key_check: CHECK (idempotency_key::text ~ \'^[!-~]+$\'::text)\ndeployment_operation_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'running\'::character varying, \'retry\'::character varying, \'succeeded\'::character varying, \'failed\'::character varying]::text[]))\ndeployment_operation_type_check: CHECK (operation_type::text = ANY (ARRAY[\'provision\'::character varying, \'update\'::character varying, \'deprovision\'::character varying, \'domain_attach\'::character varying, \'backup\'::character varying, \'restore\'::character varying]::text[]))\ndeployment_operations_attempt_count_not_null: NOT NULL attempt_count\ndeployment_operations_created_at_not_null: NOT NULL created_at\ndeployment_operations_deployment_id_fkey: FOREIGN KEY (deployment_id) REFERENCES commercial.deployments(id) ON DELETE RESTRICT\ndeployment_operations_deployment_id_idempotency_key_key: UNIQUE (deployment_id, idempotency_key)\ndeployment_operations_deployment_id_not_null: NOT NULL deployment_id\ndeployment_operations_id_not_null: NOT NULL id\ndeployment_operations_idempotency_key_not_null: NOT NULL idempotency_key\ndeployment_operations_operation_type_not_null: NOT NULL operation_type\ndeployment_operations_status_not_null: NOT NULL status\nCREATE UNIQUE INDEX deployment_operations_deployment_id_idempotency_key_key ON commercial.deployment_operations USING btree (deployment_id, idempotency_key)\nCREATE INDEX deployment_operations_retry_idx ON commercial.deployment_operations USING btree (next_retry_at) WHERE ((status)::text = \'retry\'::text)'
}

Table commercial.deployments {
  id uuid [pk, not null, default: `uuidv7()`]
  commercial_account_id uuid [not null]
  installation_id uuid [not null]
  mode "character varying(16)" [not null]
  system_slug "character varying(63)" [null]
  status "character varying(24)" [not null, default: `'reserved'::character varying`]
  provisioning_state "character varying(24)" [not null, default: `'pending'::character varying`]
  current_release_id uuid [null]
  desired_release_id uuid [null]
  core_db_secret_ref "character varying(300)" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  archived_at "timestamp with time zone" [null]
  indexes {
    commercial_account_id [name: 'deployments_account_idx', type: btree]
    installation_id [name: 'deployments_installation_id_key', type: btree, unique]
    system_slug [name: 'deployments_system_slug_key', type: btree, unique]
  }
  Note: 'cloud_system_domain_required: TRIGGER DEFERRABLE INITIALLY DEFERRED\ndeployment_cloud_slug_check: CHECK ((mode::text = \'on_prem\'::text) = (system_slug IS NULL))\ndeployment_mode_check: CHECK (mode::text = ANY (ARRAY[\'shared\'::character varying, \'dedicated\'::character varying, \'on_prem\'::character varying]::text[]))\ndeployment_provision_state_check: CHECK (provisioning_state::text = ANY (ARRAY[\'pending\'::character varying, \'running\'::character varying, \'ready\'::character varying, \'failed\'::character varying, \'not_applicable\'::character varying]::text[]))\ndeployment_secret_ref_check: CHECK (core_db_secret_ref IS NULL OR core_db_secret_ref::text ~ \'^(vault|kms|hsm)://[^[:space:]]+$\'::text OR core_db_secret_ref::text ~ \'^localdev://[0-9a-f-]{36}/db$\'::text)\ndeployment_slug_check: CHECK (system_slug IS NULL OR system_slug::text ~ \'^[a-z0-9]+(-[a-z0-9]+)*$\'::text AND (system_slug::text <> ALL (ARRAY[\'www\'::character varying, \'api\'::character varying, \'admin\'::character varying, \'app\'::character varying, \'auth\'::character varying, \'billing\'::character varying, \'control\'::character varying, \'control-plane\'::character varying, \'support\'::character varying, \'status\'::character varying, \'cdn\'::character varying, \'storage\'::character varying, \'static\'::character varying, \'mail\'::character varying, \'smtp\'::character varying, \'root\'::character varying, \'system\'::character varying, \'platform\'::character varying]::text[])))\ndeployment_status_check: CHECK (status::text = ANY (ARRAY[\'reserved\'::character varying, \'provisioning\'::character varying, \'active\'::character varying, \'suspended\'::character varying, \'failed\'::character varying, \'decommissioned\'::character varying]::text[]))\ndeployments_commercial_account_id_fkey: FOREIGN KEY (commercial_account_id) REFERENCES commercial.commercial_accounts(id) ON DELETE RESTRICT\ndeployments_commercial_account_id_not_null: NOT NULL commercial_account_id\ndeployments_created_at_not_null: NOT NULL created_at\ndeployments_current_release_id_fkey: FOREIGN KEY (current_release_id) REFERENCES commercial.releases(id) ON DELETE RESTRICT\ndeployments_desired_release_id_fkey: FOREIGN KEY (desired_release_id) REFERENCES commercial.releases(id) ON DELETE RESTRICT\ndeployments_id_not_null: NOT NULL id\ndeployments_installation_id_key: UNIQUE (installation_id)\ndeployments_installation_id_not_null: NOT NULL installation_id\ndeployments_mode_not_null: NOT NULL mode\ndeployments_provisioning_state_not_null: NOT NULL provisioning_state\ndeployments_status_not_null: NOT NULL status\ndeployments_system_slug_key: UNIQUE (system_slug)\ndeployments_updated_at_not_null: NOT NULL updated_at\nCREATE INDEX deployments_account_idx ON commercial.deployments USING btree (commercial_account_id)\nCREATE UNIQUE INDEX deployments_installation_id_key ON commercial.deployments USING btree (installation_id)\nCREATE UNIQUE INDEX deployments_system_slug_key ON commercial.deployments USING btree (system_slug)\nCREATE CONSTRAINT TRIGGER cloud_system_domain_required AFTER INSERT OR UPDATE ON commercial.deployments DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION commercial.enforce_cloud_system_domain()\nCREATE TRIGGER deployment_no_delete BEFORE DELETE ON commercial.deployments FOR EACH ROW EXECUTE FUNCTION commercial.reject_mutation()'
}

Table commercial.external_compensation_attestations {
  id uuid [pk, not null, default: `uuidv7()`]
  plan_change_id uuid [not null]
  payment_id uuid [not null]
  amount_minor bigint [not null]
  currency character(3) [not null]
  external_transaction_reference "character varying(200)" [not null]
  document_reference "character varying(500)" [not null]
  document_sha256 character(64) [not null]
  proposed_by uuid [not null]
  proposed_at "timestamp with time zone" [not null, default: `now()`]
  status "character varying(16)" [not null, default: `'proposed'::character varying`]
  reviewed_by uuid [null]
  reviewed_at "timestamp with time zone" [null]
  rejection_reason "character varying(500)" [null]
  Note: 'external_compensation_attes_external_transaction_refer_not_null: NOT NULL external_transaction_reference\nexternal_compensation_attest_external_transaction_referen_check: CHECK (length(btrim(external_transaction_reference::text)) > 0)\nexternal_compensation_attestations_amount_minor_check: CHECK (amount_minor > 0)\nexternal_compensation_attestations_amount_minor_not_null: NOT NULL amount_minor\nexternal_compensation_attestations_currency_check: CHECK (currency ~ \'^[A-Z]{3}$\'::text)\nexternal_compensation_attestations_currency_not_null: NOT NULL currency\nexternal_compensation_attestations_document_reference_check: CHECK (document_reference::text ~ \'^urn:.+\'::text)\nexternal_compensation_attestations_document_reference_not_null: NOT NULL document_reference\nexternal_compensation_attestations_document_sha256_check: CHECK (document_sha256 ~ \'^[0-9a-f]{64}$\'::text)\nexternal_compensation_attestations_document_sha256_not_null: NOT NULL document_sha256\nexternal_compensation_attestations_id_not_null: NOT NULL id\nexternal_compensation_attestations_payment_id_fkey: FOREIGN KEY (payment_id) REFERENCES commercial.payments(id) ON DELETE RESTRICT\nexternal_compensation_attestations_payment_id_not_null: NOT NULL payment_id\nexternal_compensation_attestations_plan_change_id_fkey: FOREIGN KEY (plan_change_id) REFERENCES commercial.subscription_plan_changes(id) ON DELETE RESTRICT\nexternal_compensation_attestations_plan_change_id_not_null: NOT NULL plan_change_id\nexternal_compensation_attestations_proposed_at_not_null: NOT NULL proposed_at\nexternal_compensation_attestations_proposed_by_fkey: FOREIGN KEY (proposed_by) REFERENCES commercial.control_users(id) ON DELETE RESTRICT\nexternal_compensation_attestations_proposed_by_not_null: NOT NULL proposed_by\nexternal_compensation_attestations_reviewed_by_fkey: FOREIGN KEY (reviewed_by) REFERENCES commercial.control_users(id) ON DELETE RESTRICT\nexternal_compensation_attestations_status_check: CHECK (status::text = ANY (ARRAY[\'proposed\'::character varying, \'approved\'::character varying, \'rejected\'::character varying]::text[]))\nexternal_compensation_attestations_status_not_null: NOT NULL status\nexternal_compensation_review_check: CHECK (status::text = \'proposed\'::text AND reviewed_by IS NULL AND reviewed_at IS NULL AND rejection_reason IS NULL OR status::text = \'approved\'::text AND reviewed_by IS NOT NULL AND reviewed_by <> proposed_by AND reviewed_at IS NOT NULL AND rejection_reason IS NULL OR status::text = \'rejected\'::text AND reviewed_by IS NOT NULL AND reviewed_by <> proposed_by AND reviewed_at IS NOT NULL AND rejection_reason IS NOT NULL)\nCREATE UNIQUE INDEX external_compensation_approved_transfer_idx ON commercial.external_compensation_attestations USING btree (external_transaction_reference) WHERE ((status)::text = \'approved\'::text)\nCREATE UNIQUE INDEX external_compensation_open_change_idx ON commercial.external_compensation_attestations USING btree (plan_change_id) WHERE ((status)::text = ANY ((ARRAY[\'proposed\'::character varying, \'approved\'::character varying])::text[]))\nCREATE TRIGGER external_compensation_attestation_transition BEFORE DELETE OR UPDATE ON commercial.external_compensation_attestations FOR EACH ROW EXECUTE FUNCTION commercial.enforce_external_compensation_attestation_transition()'
}

Table commercial.features {
  id uuid [pk, not null, default: `uuidv7()`]
  code "character varying(160)" [not null]
  value_type "character varying(16)" [not null]
  description text [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  retired_at "timestamp with time zone" [null]
  usage_mode "character varying(16)" [not null, default: `'none'::character varying`]
  indexes {
    code [name: 'features_code_key', type: btree, unique]
  }
  Note: 'features_code_check: CHECK (code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nfeatures_code_key: UNIQUE (code)\nfeatures_code_not_null: NOT NULL code\nfeatures_created_at_not_null: NOT NULL created_at\nfeatures_description_check: CHECK (description IS NULL OR btrim(description) <> \'\'::text AND length(description) <= 2000 AND description !~ \'[[:cntrl:]]\'::text)\nfeatures_id_not_null: NOT NULL id\nfeatures_metered_integer_check: CHECK (usage_mode::text = \'none\'::text OR value_type::text = \'integer\'::text)\nfeatures_type_check: CHECK (value_type::text = ANY (ARRAY[\'boolean\'::character varying, \'integer\'::character varying, \'string\'::character varying, \'json\'::character varying]::text[]))\nfeatures_usage_mode_check: CHECK (usage_mode::text = ANY (ARRAY[\'none\'::character varying, \'counter\'::character varying, \'gauge\'::character varying]::text[]))\nfeatures_usage_mode_not_null: NOT NULL usage_mode\nfeatures_value_type_not_null: NOT NULL value_type\nCREATE UNIQUE INDEX features_code_key ON commercial.features USING btree (code)\nCREATE TRIGGER feature_identity_guard BEFORE UPDATE ON commercial.features FOR EACH ROW EXECUTE FUNCTION commercial.protect_feature_identity()'
}

