Project Commercial_ControlPlane_v2 {
  database_type: 'PostgreSQL'
  Note: '''Current target model for the separate platform_commercial database. Tables marked through Phase 3.9 and outbox reliability migration 020 are implemented by 20 Control Plane migrations (39 base tables); Planned tables describe later phases only. Yii/Core is a different database. Control User is not Yii Core Account; Commercial Account is not Yii organization; Control Plane Auth is not Yii Auth. No tenant_id is added to Core.'''
}

// Phase 1 + Phase 2: central identity and customers.
Table commercial.control_users {
  id uuid [pk, default: `uuidv7()`]
  email varchar(320) [not null, note: 'Trimmed presentation form; not a Diary account']
  email_normalized varchar(320) [not null, unique, note: 'Lowercase lookup identity']
  password_hash varchar(255) [not null, note: 'Symfony PasswordHasher output only']
  status varchar(24) [not null, default: 'pending_verification', note: 'pending_verification/active/suspended/disabled']
  email_verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz
  password_changed_at timestamptz
  archived_at timestamptz
  Note: 'Phase 2 central identity. Password plaintext, tokens and MFA secrets are never stored here.'
}

Table commercial.control_user_email_verifications {
  id uuid [pk, default: `uuidv7()`]
  control_user_id uuid [not null, ref: > commercial.control_users.id]
  token_hash bytea [not null, unique, note: 'SHA-256; raw token is never persisted']
  expires_at timestamptz [not null]
  consumed_at timestamptz
  invalidated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Phase 2. One-time verification artifact; resend invalidates active predecessors under user row lock.'
}

Table commercial.control_sessions {
  id uuid [pk, default: `uuidv7()`]
  control_user_id uuid [not null, ref: > commercial.control_users.id]
  token_family_id uuid [not null, default: `uuidv7()`]
  access_token_hash bytea [not null, unique]
  refresh_token_hash bytea [not null, unique]
  previous_refresh_token_hash bytea [note: 'Partial unique index; reuse revokes the family session']
  generation integer [not null, default: 0]
  issued_at timestamptz [not null, default: `now()`]
  access_expires_at timestamptz [not null]
  expires_at timestamptz [not null]
  last_used_at timestamptz
  rotated_at timestamptz
  revoked_at timestamptz
  revoke_reason varchar(80)
  ip_hash bytea
  user_agent varchar(300)
  Note: 'Phase 2. Server-side opaque session with short access lifetime, refresh rotation and revocation.'
}

Table commercial.control_session_refresh_history {
  token_hash bytea [pk, note: 'Hash of a consumed refresh token']
  control_session_id uuid [not null, ref: > commercial.control_sessions.id]
  consumed_at timestamptz [not null, default: `now()`]
  Note: 'Phase 2. Full family reuse detection; deleted with the expired session.'
}

Table commercial.commercial_accounts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(120) [not null, unique, note: 'Canonical machine code']
  display_name varchar(200) [not null]
  legal_name varchar(240)
  status varchar(24) [not null, default: 'draft']
  onboarding_state varchar(40) [not null, default: 'profile_required', note: 'profile_required/catalog_selection_pending/ready_for_subscription/completed']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  Note: 'Phase 1. Customer of Platform; never a Diary organization.'
}

Table commercial.commercial_account_memberships {
  id uuid [pk, default: `uuidv7()`]
  control_user_id uuid [not null, ref: > commercial.control_users.id]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  role varchar(24) [not null, note: 'owner/admin/billing/technical']
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  indexes { (control_user_id, commercial_account_id) [unique] }
  Note: 'Phase 1. Account-scoped central membership, separate from Diary RBAC.'
}

Table commercial.billing_profiles {
  id uuid [pk, default: `uuidv7()`]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  legal_name varchar(240) [not null]
  country_code char(2) [not null]
  contact_name varchar(200)
  contact_email varchar(320)
  tax_identifier varchar(80)
  address jsonb [not null, default: `{}`]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  Note: 'Phase 1. Partial unique index allows one active default per commercial account.'
}

// Phase 1: versioned catalog. Prices use minor units, never floating point.
Table commercial.features {
  id uuid [pk, default: `uuidv7()`]
  code varchar(160) [not null, unique]
  value_type varchar(16) [not null, note: 'boolean/integer/string/json']
  usage_mode varchar(16) [not null, default: 'none', note: 'none/counter/gauge; counter and gauge require integer value_type and are immutable identity semantics']
  description text
  created_at timestamptz [not null, default: `now()`]
  retired_at timestamptz
  Note: 'Phase 3.4. Stable machine code, typed value and immutable usage mode.'
}

Table commercial.plans {
  id uuid [pk, default: `uuidv7()`]
  code varchar(120) [not null]
  version integer [not null]
  status varchar(24) [not null, default: 'draft']
  name varchar(200) [not null]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  retired_at timestamptz
  indexes { (code, version) [unique] }
  Note: 'Phase 1. Published terms are immutable; changes require a new version.'
}

Table commercial.plan_prices {
  id uuid [pk, default: `uuidv7()`]
  plan_id uuid [not null, ref: > commercial.plans.id]
  currency char(3) [not null, note: 'ISO uppercase']
  amount_minor bigint [not null, note: 'Nonnegative']
  billing_period varchar(24) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (plan_id, currency, billing_period) [unique] }
  Note: 'Phase 1. Never rewrite published historical prices.'
}

Table commercial.plan_features {
  plan_id uuid [not null, ref: > commercial.plans.id]
  feature_id uuid [not null, ref: > commercial.features.id]
  value jsonb [not null, note: 'Must match features.value_type; metered values are nonnegative bigint hard quotas']
  indexes { (plan_id, feature_id) [pk] }
  Note: 'Phase 1. Published plan features are immutable.'
}

// Phase 3.1–3.3: draft subscriptions select concrete published recurring prices; activation freezes the contract; cancellation, expiration and replacement preserve history.
Table commercial.subscriptions {
  id uuid [pk, default: `uuidv7()`]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  billing_profile_id uuid [not null, ref: > commercial.billing_profiles.id]
  status varchar(24) [not null, default: 'draft', note: 'draft/active/cancelled/expired']
  current_period_start timestamptz
  current_period_end timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Phase 3.3. Partial unique indexes allow at most one draft and one active subscription per account. Active periods and lifecycle transitions are database guarded. Cancelled/expired rows remain historical and may be followed by a new subscription row.'
}

Table commercial.subscription_items {
  id uuid [pk, default: `uuidv7()`]
  subscription_id uuid [not null, ref: > commercial.subscriptions.id]
  plan_price_id uuid [not null, ref: > commercial.plan_prices.id]
  quantity integer [not null, note: 'Greater than zero']
  valid_from timestamptz [not null]
  valid_until timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Phase 3.2. Historical selection points to an immutable published plan price; items are database-frozen once the parent leaves draft.'
}

// Phase 1: deployments and durable operations. Core database secrets are references only.
Table commercial.deployments {
  id uuid [pk, default: `uuidv7()`]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  installation_id uuid [not null, unique]
  mode varchar(16) [not null, note: 'shared/dedicated/on_prem']
  system_slug varchar(63) [unique, note: 'Nullable for on_prem; lowercase DNS label, reserved names rejected']
  status varchar(24) [not null, default: 'reserved']
  provisioning_state varchar(24) [not null, default: 'pending']
  current_release_id uuid [ref: > commercial.releases.id]
  desired_release_id uuid [ref: > commercial.releases.id]
  core_db_secret_ref varchar(300) [note: 'Never plaintext credentials']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  Note: 'Phase 1. A Cloud deployment needs a system slug and one system domain. No automatic provisioning yet.'
}

Table commercial.deployment_domains {
  id uuid [pk, default: `uuidv7()`]
  deployment_id uuid [not null, ref: > commercial.deployments.id]
  kind varchar(16) [not null, note: 'system/custom']
  hostname varchar(253) [not null, unique, note: 'Canonical lowercase ASCII IDNA hostname']
  status varchar(24) [not null, default: 'pending']
  ownership_verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  disabled_at timestamptz
  Note: 'Phase 1. Partial unique index: one system domain per deployment. System domain cannot be deleted by customer.'
}

Table commercial.deployment_operations {
  id uuid [pk, default: `uuidv7()`]
  deployment_id uuid [not null, ref: > commercial.deployments.id]
  operation_type varchar(32) [not null]
  idempotency_key varchar(200) [not null]
  status varchar(24) [not null, default: 'pending']
  current_step varchar(120)
  attempt_count integer [not null, default: 0]
  next_retry_at timestamptz
  last_error_code varchar(120) [note: 'Sanitized code, not raw credentials or stack trace']
  started_at timestamptz
  finished_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes { (deployment_id, idempotency_key) [unique] }
  Note: 'Phase 1 durable state model; execution belongs to later provisioning phases.'
}

// Phase 1: key metadata, mutable license policy, immutable signed artifacts.
Table commercial.signing_keys {
  key_id varchar(160) [pk]
  algorithm varchar(24) [not null, note: 'Ed25519']
  purpose varchar(32) [not null, note: 'entitlement/release']
  public_key bytea [not null]
  private_key_secret_ref varchar(300) [not null, note: 'Vault/KMS reference only; never private key bytes']
  status varchar(24) [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Phase 1. Key rotation uses multiple key IDs; private bytes never enter PostgreSQL.'
}

Table commercial.licenses {
  id uuid [pk, default: `uuidv7()`]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  kind varchar(24) [not null, note: 'subscription/perpetual']
  status varchar(24) [not null, default: 'draft']
  valid_from timestamptz [not null]
  valid_until timestamptz
  max_installations integer [not null]
  policy jsonb [not null, note: 'Feature and numeric limit policy']
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  Note: 'Phase 1. Lifecycle record is not itself the signed document.'
}

Table commercial.license_installations {
  license_id uuid [not null, ref: > commercial.licenses.id]
  installation_id uuid [not null]
  activated_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  indexes { (license_id, installation_id) [pk] }
  Note: 'Phase 1. Active assignments are bounded by max_installations under row lock.'
}

Table commercial.maintenance_contracts {
  id uuid [pk, default: `uuidv7()`]
  license_id uuid [not null, ref: > commercial.licenses.id]
  valid_from timestamptz [not null]
  valid_until timestamptz [not null]
  status varchar(24) [not null]
  Note: 'Phase 1. Maintenance rights are separate from perpetual license validity.'
}

Table commercial.issued_entitlement_documents {
  id uuid [pk, default: `uuidv7()`]
  license_id uuid [not null, ref: > commercial.licenses.id]
  installation_id uuid [not null]
  document_version integer [not null]
  sequence bigint [not null]
  envelope bytea [not null, note: 'Versioned canonical serialized envelope']
  envelope_sha256 bytea [not null]
  signature bytea [not null]
  signing_key_id varchar(160) [not null, ref: > commercial.signing_keys.key_id]
  issued_at timestamptz [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes { (installation_id, sequence) [unique] }
  Note: 'Phase 1 registry. Insert-only; no fake signature on draft license. Issuer and canonical serializer are later phases.'
}

// Phase 1: release registry. Published release data is immutable.
Table commercial.releases {
  id uuid [pk, default: `uuidv7()`]
  version varchar(80) [not null, unique, note: 'Semantic version']
  channel varchar(24) [not null]
  status varchar(24) [not null, default: 'draft']
  compatibility jsonb [not null]
  oci_reference varchar(400)
  image_digest varchar(80) [note: 'sha256 digest, not mutable tag']
  manifest_sha256 bytea
  manifest_signature bytea
  signing_key_id varchar(160) [ref: > commercial.signing_keys.key_id]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  retired_at timestamptz
  Note: 'Phase 1 metadata. Publish requires a complete signed immutable digest.'
}

Table commercial.release_entitlements {
  release_id uuid [not null, ref: > commercial.releases.id]
  feature_id uuid [not null, ref: > commercial.features.id]
  requirement jsonb [not null]
  indexes { (release_id, feature_id) [pk] }
  Note: 'Phase 1 release capability metadata.'
}

// Phase 1: reliability ledger. Application writes business change and outbox in one transaction.
Table commercial.idempotency_keys {
  id uuid [pk, default: `uuidv7()`]
  scope varchar(120) [not null]
  idempotency_key varchar(200) [not null]
  request_sha256 bytea [not null]
  status varchar(24) [not null]
  result_reference varchar(200)
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  indexes { (scope, idempotency_key) [unique] }
  Note: 'Phase 1. Same key and hash resolves to same result; changed hash is a conflict.'
}

Table commercial.rate_limit_counters {
  scope varchar(80) [not null]
  key_hash bytea [not null, note: 'HMAC-pseudonymized key']
  window_started_at timestamptz [not null]
  hits integer [not null, default: 1]
  expires_at timestamptz [not null]
  indexes { (scope, key_hash, window_started_at) [pk] }
  Note: 'Phase 2. Bounded fixed-window counters removed by control:security:cleanup.'
}

Table commercial.audit_events {
  id bigint [pk, increment]
  event_id uuid [not null, unique, default: `uuidv7()`]
  occurred_at timestamptz [not null, default: `now()`]
  actor_type varchar(24) [not null]
  actor_id uuid
  commercial_account_id uuid [ref: > commercial.commercial_accounts.id]
  action varchar(160) [not null]
  resource_type varchar(120) [not null]
  resource_id varchar(160) [not null]
  correlation_id uuid
  outcome varchar(24) [not null]
  metadata jsonb [not null, note: 'Redacted, no request bodies or credentials']
  Note: 'Phase 1. Append-only.'
}

Table commercial.outbox_events {
  id bigint [pk, increment]
  event_id uuid [not null, unique, default: `uuidv7()`]
  event_type varchar(180) [not null]
  aggregate_type varchar(120) [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  schema_version smallint [not null, default: 1]
  status varchar(24) [not null, default: 'pending']
  attempts integer [not null, default: 0]
  available_at timestamptz [not null, default: `now()`]
  locked_at timestamptz
  lock_token uuid
  last_error varchar(160)
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  Note: 'Phase 4.0 migration 020. Leased at-least-once delivery; pending/processing/published/failed/dead, bounded retries, immutable published rows. Verification email has a production worker; other event consumers remain deferred.'
}

// Phase 3.3 effective entitlements are a derived read model over the current active subscription graph; cancelled and expired subscriptions grant nothing.
// There is intentionally no mutable commercial.entitlements table.

// Phase 3.4 operational quota state. It is not billing metering.
Table commercial.usage_periods {
  id uuid [pk, default: `uuidv7()`]
  subscription_id uuid [not null, ref: > commercial.subscriptions.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status varchar(16) [not null, default: 'open', note: 'open/closed; at most one open period per subscription']
  created_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  Note: 'Phase 3.4. Immutable subscription-period boundaries; only open to closed transition is allowed.'
}
Table commercial.usage_counters {
  usage_period_id uuid [not null, ref: > commercial.usage_periods.id]
  feature_id uuid [not null, ref: > commercial.features.id]
  quantity bigint [not null, default: 0, note: 'Nonnegative and hard-quota enforced by the application service']
  updated_at timestamptz [not null, default: `now()`]
  indexes { (usage_period_id, feature_id) [pk] }
  Note: 'Phase 3.4. Lazy operational counter; closed-period history is immutable and never cascades.'
}

// Phase 3.5 immutable billing snapshots. Invoice is not payment.
Table commercial.invoices {
  id uuid [pk, default: `uuidv7()`]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  subscription_id uuid [not null, ref: > commercial.subscriptions.id]
  billing_profile_id uuid [not null, ref: > commercial.billing_profiles.id]
  billing_reason varchar(40) [not null, note: 'subscription_create/subscription_renewal']
  service_period_start timestamptz [note: 'Required only for renewal invoices']
  service_period_end timestamptz [note: 'Required only for renewal invoices; greater than start']
  currency char(3) [not null]
  total_minor bigint [not null, default: 0, note: 'Nonnegative sum of line totals']
  status varchar(16) [not null, default: 'draft', note: 'draft/issued/paid/void; paid reserved for Payment Core']
  bill_to_legal_name varchar(240) [not null]
  bill_to_country_code char(2) [not null]
  bill_to_contact_name varchar(200)
  bill_to_contact_email varchar(320)
  bill_to_tax_identifier varchar(80)
  bill_to_address jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  issued_at timestamptz
  paid_at timestamptz
  voided_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Phase 3.9. Immutable after issuance; billing-profile and renewal service-period fields are historical snapshots. One current issued/paid invoice per renewal period.'
}
Table commercial.invoice_lines {
  id uuid [pk, default: `uuidv7()`]
  invoice_id uuid [not null, ref: > commercial.invoices.id]
  subscription_item_id uuid [not null, ref: > commercial.subscription_items.id]
  plan_price_id uuid [not null, ref: > commercial.plan_prices.id]
  plan_code varchar(120) [not null]
  plan_version integer [not null]
  plan_name varchar(200) [not null]
  billing_period varchar(24) [not null, note: 'month/year']
  description varchar(400) [not null]
  quantity integer [not null]
  unit_amount_minor bigint [not null]
  total_minor bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Phase 3.5. Immutable plan/version/price/quantity snapshot after invoice issuance; catalog FKs are provenance only.'
}

// Phase 3.6 provider-neutral payment core. No provider transport or secrets.
Table commercial.payment_provider_accounts {
  id uuid [pk, default: `uuidv7()`]
  provider_code varchar(120) [not null]
  external_account_id varchar(200)
  secret_ref varchar(300) [not null, note: 'Secret-manager reference only; never a credential']
  receipt_mode varchar(24) [not null, default: 'disabled', note: 'disabled/yookassa']
  receipt_vat_code smallint
  receipt_payment_subject varchar(40)
  receipt_payment_mode varchar(40)
  status varchar(16) [not null, default: 'active', note: 'active/disabled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Phase 3.8. Provider identity is immutable; fiscal settings are mutable all-or-nothing configuration; rows cannot be deleted.'
}
Table commercial.payments {
  id uuid [pk, default: `uuidv7()`]
  invoice_id uuid [not null, unique, ref: > commercial.invoices.id]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  amount_minor bigint [not null]
  currency char(3) [not null]
  status varchar(16) [not null, default: 'pending', note: 'pending/succeeded/cancelled']
  created_at timestamptz [not null, default: `now()`]
  succeeded_at timestamptz
  cancelled_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Phase 3.6. One immutable financial obligation per invoice; money and account must exactly match the invoice.'
}
Table commercial.payment_attempts {
  id uuid [pk, default: `uuidv7()`]
  payment_id uuid [not null, ref: > commercial.payments.id]
  provider_account_id uuid [not null, ref: > commercial.payment_provider_accounts.id]
  method_type varchar(80) [not null]
  provider_request_key varchar(200) [not null, note: 'Provider-side idempotency key; hidden from customer read model']
  provider_payment_id varchar(200)
  status varchar(16) [not null, default: 'pending', note: 'pending/succeeded/failed/cancelled']
  failure_code varchar(120)
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  indexes {
    (provider_account_id, provider_request_key) [unique]
    (provider_account_id, provider_payment_id) [unique, note: 'Partial when provider_payment_id is not null']
  }
  Note: 'Phase 3.6. Historical retry; only one pending attempt per payment, provider reference binds once, terminal rows are immutable.'
}

// Phase 3.7 YooKassa webhook inbox. Raw webhook payloads and provider secrets are never stored.
Table commercial.payment_provider_events {
  id uuid [pk, default: `uuidv7()`]
  provider_account_id uuid [not null, ref: > commercial.payment_provider_accounts.id]
  event_key varchar(400) [not null]
  event_type varchar(160) [not null]
  provider_object_id varchar(200) [not null]
  payload_sha256 bytea [not null, note: 'Exactly 32 bytes']
  status varchar(16) [not null, default: 'received', note: 'received/processed/ignored/failed']
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  last_error_code varchar(120)
  indexes {
    (provider_account_id, event_key) [unique]
    (status, received_at)
  }
  Note: 'Phase 3.7. Deterministic webhook deduplication and diagnostics hash; terminal processed/ignored events are immutable.'
}

// Phase 3.9 provider-neutral partial/full refunds with immutable fiscal allocations.
Table commercial.refunds {
  id uuid [pk, default: `uuidv7()`]
  payment_id uuid [not null, ref: > commercial.payments.id]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  provider_account_id uuid [not null, ref: > commercial.payment_provider_accounts.id]
  amount_minor bigint [not null]
  currency char(3) [not null]
  status varchar(16) [not null, default: 'pending', note: 'pending/succeeded/canceled']
  client_request_key varchar(200) [not null, note: 'Public idempotency; never returned']
  request_sha256 bytea [not null]
  provider_request_key varchar(200) [not null, note: 'Provider idempotency; never returned']
  provider_refund_id varchar(200)
  created_at timestamptz [not null, default: `now()`]
  last_attempted_at timestamptz
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  last_error_code varchar(120)
  indexes {
    (payment_id, client_request_key) [unique]
    (provider_account_id, provider_request_key) [unique]
    (provider_account_id, provider_refund_id) [unique, note: 'Partial when provider_refund_id is not null']
  }
  Note: 'Phase 3.9. Payment row locking serializes refund reservations; pending plus succeeded cannot exceed the succeeded payment.'
}
Table commercial.refund_items {
  id uuid [pk, default: `uuidv7()`]
  refund_id uuid [not null, ref: > commercial.refunds.id]
  invoice_line_id uuid [not null, ref: > commercial.invoice_lines.id]
  description varchar(400) [not null]
  quantity integer [not null]
  unit_amount_minor bigint [not null]
  total_minor bigint [not null]
  currency char(3) [not null]
  vat_code smallint [not null]
  payment_subject varchar(40) [not null]
  payment_mode varchar(40) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (refund_id, invoice_line_id) [unique] }
  Note: 'Phase 3.9. Immutable allocation and refund-receipt snapshot; cumulative amount cannot exceed the invoice line total.'
}

// Phase 3.8/3.9 immutable local fiscal obligations for payments and refunds.
Table commercial.receipts {
  id uuid [pk, default: `uuidv7()`]
  payment_id uuid [not null, ref: > commercial.payments.id]
  invoice_id uuid [not null, ref: > commercial.invoices.id]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  payment_attempt_id uuid [ref: > commercial.payment_attempts.id, note: 'Required for payment receipt; null for refund receipt']
  refund_id uuid [ref: > commercial.refunds.id, note: 'Required for refund receipt; null for payment receipt']
  provider_account_id uuid [not null, ref: > commercial.payment_provider_accounts.id]
  receipt_type varchar(24) [not null, default: 'payment']
  status varchar(16) [not null, default: 'pending', note: 'pending/succeeded/canceled']
  provider_request_key varchar(200) [not null]
  external_receipt_id varchar(200)
  amount_minor bigint [not null]
  currency char(3) [not null]
  customer_email varchar(320) [not null, note: 'Private invoice snapshot; excluded from public API/events']
  customer_name varchar(200)
  vat_code smallint [not null]
  payment_subject varchar(40) [not null]
  payment_mode varchar(40) [not null]
  created_at timestamptz [not null, default: `now()`]
  last_attempted_at timestamptz
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  last_error_code varchar(120)
  indexes {
    (payment_id) [unique, note: 'Partial for payment receipts']
    (refund_id) [unique, note: 'Partial for refund receipts']
    (provider_account_id, provider_request_key) [unique]
    (provider_account_id, external_receipt_id) [unique, note: 'Partial when external_receipt_id is not null']
    (created_at, id) [note: 'Partial for pending reconciliation']
  }
  Note: 'Phase 3.9. Immutable payment/refund receipt obligation; provider ID binds once and only pending-to-terminal transitions are allowed.'
}
Table commercial.receipt_items {
  id uuid [pk, default: `uuidv7()`]
  receipt_id uuid [not null, ref: > commercial.receipts.id]
  invoice_line_id uuid [not null, ref: > commercial.invoice_lines.id]
  description varchar(400) [not null]
  quantity integer [not null]
  unit_amount_minor bigint [not null]
  total_minor bigint [not null]
  currency char(3) [not null]
  vat_code smallint [not null]
  payment_subject varchar(40) [not null]
  payment_mode varchar(40) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (receipt_id, invoice_line_id) [unique]
    (receipt_id, created_at, id)
  }
  Note: 'Phase 3.9. Immutable invoice-line snapshot: all invoice lines for payment, allocated refund items for refund.'
}

// Saved account-scoped payment methods are implemented; automatic recurring execution,
// dunning, plan switching and usage-based billing remain deferred.
// Phase 4.1 Pass B5 privacy boundary (migration 021).
Table commercial.privacy_holds {
  id uuid [pk]
  control_user_id uuid [not null, ref: > commercial.control_users.id]
  reason_code varchar(80) [not null]
  opened_at timestamptz [not null]
  released_at timestamptz
}
Table commercial.privacy_lifecycle_runs {
  id uuid [pk]
  category varchar(80) [not null]
  dry_run boolean [not null]
  selected_count integer [not null]
  deleted_count integer [not null]
  executed_at timestamptz [not null]
}
Table commercial.privacy_erasure_cases {
  id uuid [pk]
  control_user_id uuid [not null, ref: > commercial.control_users.id]
  status varchar(32) [not null]
  reason_code varchar(80) [not null]
  financial_evidence_count integer [not null]
  created_at timestamptz [not null]
  completed_at timestamptz
}
Table commercial.privacy_export_events {
  id uuid [pk]
  control_user_id uuid [not null, ref: > commercial.control_users.id]
  actor_id uuid [not null, ref: > commercial.control_users.id]
  schema_version smallint [not null]
  item_count integer [not null]
  exported_at timestamptz [not null]
}

Table commercial.payment_methods {
  id uuid [pk]
  commercial_account_id uuid [not null, ref: > commercial.commercial_accounts.id]
  provider_account_id uuid [not null, ref: > commercial.payment_provider_accounts.id]
  method_type varchar(40) [not null, note: 'card/sbp/bank_transfer/...']
  provider_token varchar(300)
  status varchar(24) [not null]
  Note: 'Implemented account-scoped saved method metadata. No PAN/CVV; SBP is a method capability.'
}

Table commercial.service_credentials {
  id uuid [pk, not null, default: `uuidv7()`]
  deployment_id uuid [not null, ref: > commercial.deployments.id]
  credential_id uuid [not null, unique, default: `uuidv4()`]
  secret_hash bytea [not null, note: 'SHA-256 only, 32 bytes']
  status varchar(16) [not null, default: 'active', note: 'active / rotated / revoked']
  scopes text[] [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  last_used_at timestamptz
  rotated_at timestamptz
  revoked_at timestamptz
}

Table commercial.deployment_entitlement_documents {
  id uuid [pk, not null, default: `uuidv7()`]
  deployment_id uuid [not null, ref: > commercial.deployments.id]
  installation_id uuid [not null]
  document_version integer [not null, note: 'Exactly 1']
  sequence bigint [not null, note: 'Positive and increasing per deployment']
  canonical_document bytea [not null, note: 'Exact canonical signed JSON bytes']
  document_sha256 bytea [not null, note: '32-byte SHA-256 of canonical_document']
  signature bytea [not null, note: '64-byte Ed25519 detached signature']
  signing_key_id varchar(160) [not null, ref: > commercial.signing_keys.key_id]
  source_fingerprint bytea [not null, note: '32-byte SHA-256 of effective source state']
  issued_at timestamptz [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (deployment_id, sequence) [unique]
  }
  Note: 'Immutable after insert. A new row and entitlement.issued v1 outbox event share one transaction.'
}
