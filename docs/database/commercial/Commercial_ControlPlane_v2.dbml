  updated_at "timestamp with time zone" [not null, default: `now()`]
  receipt_mode "character varying(24)" [not null, default: `'disabled'::character varying`]
  receipt_vat_code smallint [null]
  receipt_payment_subject "character varying(40)" [null]
  receipt_payment_mode "character varying(40)" [null]
  Note: 'payment_provider_accounts_code_check: CHECK (provider_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\npayment_provider_accounts_created_at_not_null: NOT NULL created_at\npayment_provider_accounts_external_id_check: CHECK (external_account_id IS NULL OR btrim(external_account_id::text) <> \'\'::text AND external_account_id::text !~ \'[[:cntrl:]]\'::text)\npayment_provider_accounts_id_not_null: NOT NULL id\npayment_provider_accounts_provider_code_not_null: NOT NULL provider_code\npayment_provider_accounts_receipt_check: CHECK (receipt_mode::text = \'disabled\'::text AND receipt_vat_code IS NULL AND receipt_payment_subject IS NULL AND receipt_payment_mode IS NULL OR receipt_mode::text = \'yookassa\'::text AND receipt_vat_code IS NOT NULL AND receipt_vat_code >= 1 AND receipt_vat_code <= 12 AND receipt_payment_subject::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text AND receipt_payment_mode::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\npayment_provider_accounts_receipt_mode_not_null: NOT NULL receipt_mode\npayment_provider_accounts_secret_ref_check: CHECK (btrim(secret_ref::text) <> \'\'::text AND secret_ref::text !~ \'[[:cntrl:]]\'::text)\npayment_provider_accounts_secret_ref_not_null: NOT NULL secret_ref\npayment_provider_accounts_status_check: CHECK (status::text = ANY (ARRAY[\'active\'::character varying, \'disabled\'::character varying]::text[]))\npayment_provider_accounts_status_not_null: NOT NULL status\npayment_provider_accounts_updated_at_not_null: NOT NULL updated_at\nCREATE TRIGGER payment_provider_account_guard BEFORE DELETE OR UPDATE ON commercial.payment_provider_accounts FOR EACH ROW EXECUTE FUNCTION commercial.protect_payment_provider_account()'
}

Table commercial.payment_provider_events {
