    token_hash [name: 'control_user_password_resets_token_hash_key', type: btree, unique]
  }
  Note: 'control_password_reset_expiry_check: CHECK (expires_at > created_at)\ncontrol_password_reset_hash_check: CHECK (octet_length(token_hash) = 32)\ncontrol_password_reset_terminal_check: CHECK (consumed_at IS NULL OR invalidated_at IS NULL)\ncontrol_user_password_resets_control_user_id_fkey: FOREIGN KEY (control_user_id) REFERENCES commercial.control_users(id) ON DELETE RESTRICT\ncontrol_user_password_resets_control_user_id_not_null: NOT NULL control_user_id\ncontrol_user_password_resets_created_at_not_null: NOT NULL created_at\ncontrol_user_password_resets_expires_at_not_null: NOT NULL expires_at\ncontrol_user_password_resets_id_not_null: NOT NULL id\ncontrol_user_password_resets_token_hash_key: UNIQUE (token_hash)\ncontrol_user_password_resets_token_hash_not_null: NOT NULL token_hash\nCREATE INDEX control_password_reset_expiry_idx ON commercial.control_user_password_resets USING btree (expires_at) WHERE ((consumed_at IS NULL) AND (invalidated_at IS NULL))\nCREATE UNIQUE INDEX control_password_reset_one_active_idx ON commercial.control_user_password_resets USING btree (control_user_id) WHERE ((consumed_at IS NULL) AND (invalidated_at IS NULL))\nCREATE UNIQUE INDEX control_user_password_resets_token_hash_key ON commercial.control_user_password_resets USING btree (token_hash)'
}

