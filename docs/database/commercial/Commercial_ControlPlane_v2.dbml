Table commercial.outbox_events {
  id bigint [pk, not null, note: 'PostgreSQL identity: a']
  event_id uuid [not null, default: `uuidv7()`]
  event_type "character varying(180)" [not null]
  aggregate_type "character varying(120)" [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  status "character varying(24)" [not null, default: `'pending'::character varying`]
  attempts integer [not null, default: `0`]
  available_at "timestamp with time zone" [not null, default: `now()`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  published_at "timestamp with time zone" [null]
  schema_version smallint [not null, default: `1`]
  locked_at "timestamp with time zone" [null]
  lock_token uuid [null]
  last_error "character varying(160)" [null]
  indexes {
    event_id [name: 'outbox_events_event_id_key', type: btree, unique]
  }
  Note: 'outbox_aggregate_check: CHECK (aggregate_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\noutbox_attempts_check: CHECK (attempts >= 0)\noutbox_event_type_check: CHECK (event_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\noutbox_events_aggregate_id_not_null: NOT NULL aggregate_id\noutbox_events_aggregate_type_not_null: NOT NULL aggregate_type\noutbox_events_attempts_not_null: NOT NULL attempts\noutbox_events_available_at_not_null: NOT NULL available_at\noutbox_events_created_at_not_null: NOT NULL created_at\noutbox_events_event_id_key: UNIQUE (event_id)\noutbox_events_event_id_not_null: NOT NULL event_id\noutbox_events_event_type_not_null: NOT NULL event_type\noutbox_events_id_not_null: NOT NULL id\noutbox_events_payload_not_null: NOT NULL payload\noutbox_events_schema_version_not_null: NOT NULL schema_version\noutbox_events_status_not_null: NOT NULL status\noutbox_lease_check: CHECK ((status::text = \'processing\'::text) = (locked_at IS NOT NULL AND lock_token IS NOT NULL))\noutbox_payload_check: CHECK (jsonb_typeof(payload) = \'object\'::text)\noutbox_published_check: CHECK ((status::text = \'published\'::text) = (published_at IS NOT NULL))\noutbox_schema_version_check: CHECK (schema_version > 0)\noutbox_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'processing\'::character varying, \'published\'::character varying, \'failed\'::character varying, \'dead\'::character varying]::text[]))\nCREATE INDEX outbox_available_idx ON commercial.outbox_events USING btree (available_at, id) WHERE ((status)::text = ANY ((ARRAY[\'pending\'::character varying, \'failed\'::character varying])::text[]))\nCREATE UNIQUE INDEX outbox_events_event_id_key ON commercial.outbox_events USING btree (event_id)\nCREATE INDEX outbox_expired_lease_idx ON commercial.outbox_events USING btree (locked_at, id) WHERE ((status)::text = \'processing\'::text)\nCREATE TRIGGER outbox_published_guard BEFORE DELETE OR UPDATE ON commercial.outbox_events FOR EACH ROW EXECUTE FUNCTION commercial.guard_published_outbox()'
}

