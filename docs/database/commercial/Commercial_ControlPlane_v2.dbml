  Note: 'payment_provider_events_error_check: CHECK (status::text = \'failed\'::text AND last_error_code::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text OR status::text <> \'failed\'::text AND last_error_code IS NULL)\npayment_provider_events_event_key_not_null: NOT NULL event_key\npayment_provider_events_event_type_not_null: NOT NULL event_type\npayment_provider_events_hash_check: CHECK (octet_length(payload_sha256) = 32)\npayment_provider_events_id_not_null: NOT NULL id\npayment_provider_events_key_check: CHECK (btrim(event_key::text) <> \'\'::text AND event_key::text !~ \'[[:cntrl:]]\'::text)\npayment_provider_events_object_check: CHECK (btrim(provider_object_id::text) <> \'\'::text AND provider_object_id::text !~ \'[[:cntrl:]]\'::text)\npayment_provider_events_payload_sha256_not_null: NOT NULL payload_sha256\npayment_provider_events_provider_account_id_event_key_key: UNIQUE (provider_account_id, event_key)\npayment_provider_events_provider_account_id_fkey: FOREIGN KEY (provider_account_id) REFERENCES commercial.payment_provider_accounts(id) ON DELETE RESTRICT\npayment_provider_events_provider_account_id_not_null: NOT NULL provider_account_id\npayment_provider_events_provider_object_id_not_null: NOT NULL provider_object_id\npayment_provider_events_received_at_not_null: NOT NULL received_at\npayment_provider_events_status_check: CHECK (status::text = ANY (ARRAY[\'received\'::character varying, \'processed\'::character varying, \'ignored\'::character varying, \'failed\'::character varying]::text[]))\npayment_provider_events_status_not_null: NOT NULL status\npayment_provider_events_timestamps_check: CHECK ((status::text = ANY (ARRAY[\'received\'::character varying, \'failed\'::character varying]::text[])) AND processed_at IS NULL OR (status::text = ANY (ARRAY[\'processed\'::character varying, \'ignored\'::character varying]::text[])) AND processed_at IS NOT NULL)\npayment_provider_events_type_check: CHECK (event_type::text ~ \'^[a-z0-9]+([._-][a-z0-9]+)*$\'::text)\nCREATE UNIQUE INDEX payment_provider_events_provider_account_id_event_key_key ON commercial.payment_provider_events USING btree (provider_account_id, event_key)\nCREATE INDEX payment_provider_events_status_received_idx ON commercial.payment_provider_events USING btree (status, received_at)\nCREATE TRIGGER payment_provider_event_guard BEFORE DELETE OR UPDATE ON commercial.payment_provider_events FOR EACH ROW EXECUTE FUNCTION commercial.protect_payment_provider_event()'
}

Table commercial.payments {
  id uuid [pk, not null, default: `uuidv7()`]
