Table commercial.control_user_totp_factors {
  id uuid [pk, not null, default: `uuidv7()`]
  control_user_id uuid [not null]
  secret_ciphertext bytea [not null]
  key_version "character varying(32)" [not null]
  status "character varying(16)" [not null, default: `'pending'::character varying`]
  last_accepted_counter bigint [not null, default: `'-1'::integer`]
  expires_at "timestamp with time zone" [null]
  confirmed_at "timestamp with time zone" [null]
  revoked_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  Note: 'control_totp_factor_pending_expiry_check: CHECK (status::text = \'pending\'::text AND expires_at IS NOT NULL AND confirmed_at IS NULL AND revoked_at IS NULL OR status::text = \'active\'::text AND expires_at IS NULL AND confirmed_at IS NOT NULL AND revoked_at IS NULL OR status::text = \'revoked\'::text AND revoked_at IS NOT NULL)\ncontrol_totp_factor_secret_check: CHECK (octet_length(secret_ciphertext) > 24)\ncontrol_totp_factor_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'active\'::character varying, \'revoked\'::character varying]::text[]))\ncontrol_user_totp_factors_control_user_id_fkey: FOREIGN KEY (control_user_id) REFERENCES commercial.control_users(id) ON DELETE RESTRICT\ncontrol_user_totp_factors_control_user_id_not_null: NOT NULL control_user_id\ncontrol_user_totp_factors_created_at_not_null: NOT NULL created_at\ncontrol_user_totp_factors_id_not_null: NOT NULL id\ncontrol_user_totp_factors_key_version_not_null: NOT NULL key_version\ncontrol_user_totp_factors_last_accepted_counter_not_null: NOT NULL last_accepted_counter\ncontrol_user_totp_factors_secret_ciphertext_not_null: NOT NULL secret_ciphertext\ncontrol_user_totp_factors_status_not_null: NOT NULL status\nCREATE UNIQUE INDEX control_totp_one_active_idx ON commercial.control_user_totp_factors USING btree (control_user_id) WHERE ((status)::text = \'active\'::text)\nCREATE UNIQUE INDEX control_totp_one_pending_idx ON commercial.control_user_totp_factors USING btree (control_user_id) WHERE ((status)::text = \'pending\'::text)\nCREATE INDEX control_totp_pending_expiry_idx ON commercial.control_user_totp_factors USING btree (expires_at) WHERE ((status)::text = \'pending\'::text)'
}

Table commercial.control_users {
  id uuid [pk, not null, default: `uuidv7()`]
  email "character varying(320)" [not null]
  status "character varying(24)" [not null, default: `'pending_verification'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  archived_at "timestamp with time zone" [null]
  email_normalized "character varying(320)" [not null]
  password_hash "character varying(255)" [not null]
  email_verified_at "timestamp with time zone" [null]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  last_login_at "timestamp with time zone" [null]
  password_changed_at "timestamp with time zone" [null]
  indexes {
    email_normalized [name: 'control_users_email_normalized_key', type: btree, unique]
  }
  Note: 'control_users_created_at_not_null: NOT NULL created_at\ncontrol_users_email_check: CHECK (email::text = btrim(email::text) AND length(email::text) >= 3 AND length(email::text) <= 320 AND email::text !~ \'[[:cntrl:]]\'::text)\ncontrol_users_email_normalized_check: CHECK (email_normalized::text = lower(btrim(email_normalized::text)) AND length(email_normalized::text) >= 3 AND length(email_normalized::text) <= 320 AND email_normalized::text = lower(email::text) AND email_normalized::text !~ \'[[:cntrl:]]\'::text AND POSITION((\'@\'::text) IN (email_normalized)) > 1)\ncontrol_users_email_normalized_key: UNIQUE (email_normalized)\ncontrol_users_email_normalized_not_null: NOT NULL email_normalized\ncontrol_users_email_not_null: NOT NULL email\ncontrol_users_id_not_null: NOT NULL id\ncontrol_users_password_hash_not_null: NOT NULL password_hash\ncontrol_users_status_check: CHECK (status::text = ANY (ARRAY[\'pending_verification\'::character varying, \'active\'::character varying, \'suspended\'::character varying, \'disabled\'::character varying]::text[]))\ncontrol_users_status_not_null: NOT NULL status\ncontrol_users_updated_at_not_null: NOT NULL updated_at\ncontrol_users_verification_check: CHECK (status::text = \'pending_verification\'::text AND email_verified_at IS NULL OR (status::text = ANY (ARRAY[\'active\'::character varying, \'suspended\'::character varying]::text[])) AND email_verified_at IS NOT NULL OR status::text = \'disabled\'::text)\nCREATE UNIQUE INDEX control_users_email_normalized_key ON commercial.control_users USING btree (email_normalized)\nCREATE TRIGGER control_user_transition BEFORE UPDATE ON commercial.control_users FOR EACH ROW EXECUTE FUNCTION commercial.enforce_control_user_transition()'
}

Table commercial.deployment_domains {
  id uuid [pk, not null, default: `uuidv7()`]
  deployment_id uuid [not null]
  kind "character varying(16)" [not null]
  hostname "character varying(253)" [not null]
  status "character varying(24)" [not null, default: `'pending'::character varying`]
  ownership_verified_at "timestamp with time zone" [null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  disabled_at "timestamp with time zone" [null]
  indexes {
    hostname [name: 'deployment_domains_hostname_key', type: btree, unique]
  }
  Note: 'deployment_domains_created_at_not_null: NOT NULL created_at\ndeployment_domains_deployment_id_fkey: FOREIGN KEY (deployment_id) REFERENCES commercial.deployments(id) ON DELETE RESTRICT\ndeployment_domains_deployment_id_not_null: NOT NULL deployment_id\ndeployment_domains_hostname_key: UNIQUE (hostname)\ndeployment_domains_hostname_not_null: NOT NULL hostname\ndeployment_domains_id_not_null: NOT NULL id\ndeployment_domains_kind_not_null: NOT NULL kind\ndeployment_domains_status_not_null: NOT NULL status\ndomain_custom_verification_check: CHECK (kind::text = \'system\'::text OR (status::text <> ALL (ARRAY[\'verified\'::character varying, \'active\'::character varying]::text[])) OR ownership_verified_at IS NOT NULL)\ndomain_hostname_check: CHECK (hostname::text = lower(hostname::text) AND hostname::text ~ \'^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$\'::text AND hostname::text !~ \'(^|\\.)[a-z0-9-]{64,}(\\.|$)\'::text AND hostname::text !~ \'(^|\\.)(localhost|local|internal|invalid|test)(\\.|$)\'::text)\ndomain_kind_check: CHECK (kind::text = ANY (ARRAY[\'system\'::character varying, \'custom\'::character varying]::text[]))\ndomain_status_check: CHECK (status::text = ANY (ARRAY[\'pending\'::character varying, \'verified\'::character varying, \'active\'::character varying, \'disabled\'::character varying]::text[]))\nCREATE UNIQUE INDEX deployment_domains_hostname_key ON commercial.deployment_domains USING btree (hostname)\nCREATE UNIQUE INDEX deployment_system_domain_uidx ON commercial.deployment_domains USING btree (deployment_id) WHERE ((kind)::text = \'system\'::text)\nCREATE TRIGGER system_domain_guard BEFORE INSERT OR DELETE OR UPDATE ON commercial.deployment_domains FOR EACH ROW EXECUTE FUNCTION commercial.protect_system_domain()'
}

Table commercial.deployment_entitlement_documents {
  id uuid [pk, not null, default: `uuidv7()`]
  deployment_id uuid [not null]
  installation_id uuid [not null]
  document_version integer [not null]
  sequence bigint [not null]
  canonical_document bytea [not null]
  document_sha256 bytea [not null]
