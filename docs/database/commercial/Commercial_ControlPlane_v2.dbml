  provider_object_id "character varying(200)" [not null]
  payload_sha256 bytea [not null]
  status "character varying(16)" [not null, default: `'received'::character varying`]
  received_at "timestamp with time zone" [not null, default: `now()`]
  processed_at "timestamp with time zone" [null]
  last_error_code "character varying(120)" [null]
