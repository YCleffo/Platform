# Local secrets / environment
.env
.env.*
!.env.example
**/override.env

# IDE
.idea/
.vscode/
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json

# PHP / Composer
**/vendor/
**/runtime/
!docs/database/runtime/
!docs/database/runtime/**
.phpunit.cache/
.phpunit.result.cache

# Codeception diagnostics can contain passwords and raw one-time/auth tokens.
**/tests/_output/*
!**/tests/_output/.gitkeep

# Node / frontend
**/node_modules/
**/__pycache__/
**/dist/
**/.vite/

# .NET
**/bin/
!apps/control-plane/bin/
!apps/control-plane/bin/console
**/obj/
apps/control-plane/var/

# Logs / dumps
*.log
*.dump
*.sql.gz
*.mmdb
backups/
runtime/provisioning-secrets/
deployment/privacy/*.json
deployment/entitlements/signing/*
!deployment/entitlements/signing/.gitkeep

# OS
.DS_Store
Thumbs.db
Desktop.ini
.kilo

# Local archives
*.zip

# Disposable browser verification output
apps/frontend/screenshots/
infra/observability/secrets/
