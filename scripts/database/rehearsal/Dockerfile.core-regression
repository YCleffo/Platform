# Both base images are built by the local rehearsal/test workflow.
FROM platform-cross-plane-test:latest AS test-dependencies
FROM platform-upgrade-core:local
USER root
COPY --from=test-dependencies /backend/vendor /app/vendor
COPY --from=test-dependencies /backend/composer.lock /tmp/core-dependency-lock.json
# The driver builds a Git-visible allowlisted context, never the raw workspace.
COPY --chown=www-data:www-data app/ /app/
COPY contracts/ /contracts/
RUN cmp /app/composer.lock /tmp/core-dependency-lock.json \
    && mkdir -p /app/runtime /app/tests/_output \
    && chown -R www-data:www-data /app/runtime /app/tests/_output
ENV APP_ENV=test APP_DEBUG=false TEST_ISOLATED_RUNTIME=1
WORKDIR /app
USER www-data
