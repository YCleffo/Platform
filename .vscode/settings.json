{
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "prettier.prettierPath": "./apps/frontend/node_modules/prettier",
  "vitest.configSearchPatternInclude": "apps/frontend/vitest.config.ts",
  "yaml.customTags": [
    "!override sequence:array",
    "!override mapping:object",
    "!reset sequence:array",
    "!reset mapping:object"
  ],
  "git.ignoreLimitWarning": true,
  "python-envs.defaultEnvManager": "ms-python.python:system"
}