# Production mode config
# https://frankenphp.dev/docs/config
# https://caddyserver.com/docs/caddyfile
{
	skip_install_trust
	metrics

	frankenphp {
	}
}

{$SERVER_NAME::80} {
	handle /ws* {
		reverse_proxy {$REALTIME_UPSTREAM:backend-realtime:8084}
	}
	handle {
		encode zstd br gzip
		php_server {
			try_files {path} index.php
			root /app/public
		}
	}
}

:2019 {
	metrics
}
