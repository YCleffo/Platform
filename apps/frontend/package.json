{
  "name": "platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.9",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.12"
  }
}
