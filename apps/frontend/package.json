{
  "name": "platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.vue\"",
    "format:check": "prettier --check \"src/**/*.vue\"",
    "test": "vitest run",
    "test:core-auth-guard": "node --test scripts/core-e2e-guard.test.mjs",
    "test:security-dependencies": "node --test scripts/security-dependencies.test.mjs",
    "test:e2e:core-auth": "node scripts/e2e-core-auth.mjs",
    "test:e2e:core-security": "node scripts/e2e-core-security.mjs",
    "test:e2e:core-profile": "node scripts/e2e-core-profile.mjs",
    "test:e2e:core-credentials": "node scripts/e2e-core-credentials.mjs",
    "test:e2e:core-privacy": "node scripts/e2e-core-privacy.mjs",
    "test:e2e:core-privacy-operator": "node scripts/e2e-core-privacy-operator.mjs",
    "test:e2e:billing": "node scripts/e2e-billing-recovery.mjs",
    "test:e2e:paid-billing": "node scripts/e2e-paid-billing.mjs",
    "test:e2e:periodic-billing": "node scripts/e2e-periodic-billing.mjs",
    "test:e2e:operators": "node scripts/e2e-commercial-operators.mjs",
    "verify:mobile-components": "node scripts/verify-mobile-components.mjs",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "preview": "vite preview",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "check:styles": "node scripts/check-styles.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:controls": "node scripts/verify-controls.mjs",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:billing": "node scripts/verify-billing.mjs",
    "verify:core-security": "node scripts/verify-core-security.mjs",
    "verify:core-profile": "node scripts/verify-core-profile.mjs",
    "verify:core-credentials": "node scripts/verify-core-credentials.mjs",
    "verify:core-privacy": "node scripts/verify-core-privacy.mjs",
    "verify:core-privacy-operator": "node scripts/verify-core-privacy-operator.mjs",
    "test:load": "node scripts/load-commercial.mjs",
    "verify:core-configuration": "node scripts/verify-core-configuration.mjs",
    "test:e2e:core-configuration": "node scripts/e2e-core-configuration.mjs",
    "verify:typography": "node scripts/verify-typography.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "test:workbench-contracts": "node --test scripts/workbench-contracts.test.mjs",
    "test:e2e:education": "node scripts/e2e-education.mjs"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "glob@>=9.0.0 <=14.0.1": "14.0.2"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.9",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^24.0.14",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.12"
  }
}
