<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="var/cache/phpunit-cross-plane"
         failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="APP_DEBUG" value="0"/>
        <env name="CONTROL_YOOKASSA_RETURN_URL" value="https://platform.example/payments/return"/>
    </php>
    <testsuites>
        <testsuite name="CrossPlane"><directory>tests</directory></testsuite>
    </testsuites>
    <groups>
        <include><group>cross-plane</group></include>
    </groups>
</phpunit>
