{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/contracts/events/entitlement.issued.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["entitlement_document_id", "installation_id", "document_sha256"],
  "properties": {
    "entitlement_document_id": {"type": "string", "format": "uuid"},
    "installation_id": {"type": "string", "format": "uuid"},
    "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
