{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/contracts/events/envelope.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "aggregate", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
    "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"enum": ["yii-core", "commercial-control-plane"]},
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "format": "uuid"}
      }
    },
    "correlation_id": {"type": ["string", "null"], "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "payload": {"type": "object"}
  }
}
