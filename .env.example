# ================================================================
# PLATFORM — local development environment
# Copy this file to .env. The first-start.ps1 script does it for you.
# ================================================================

# PostgreSQL 18
POSTGRES_DB=platform
POSTGRES_USER=platform_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis 8
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_DATABASE=0
REDIS_RATE_LIMIT_PREFIX=platform:auth

# Backend
BACKEND_PORT=8080

# Local email (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
MAIL_FROM_ADDRESS=no-reply@platform.local
MAIL_FROM_NAME=Platform
APP_DEFAULT_LOCALE=ru-RU
APP_DEFAULT_TIMEZONE=UTC

# Comma-separated IP/CIDR list. Forwarded headers are ignored when empty.
TRUSTED_PROXIES=

# Optional HMAC key for a non-authenticating device risk signal.
DEVICE_FINGERPRINT_KEY=
SESSION_TOUCH_INTERVAL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
AUTH_ACTIVATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_RECOVERY_TTL_SECONDS=1800
AUTH_TOTP_SETUP_TTL_SECONDS=600
AUTH_RECENT_AUTH_SECONDS=600
# Base64-encoded 32-byte key. Required in production when TOTP is used.
AUTH_TOTP_ENCRYPTION_KEY=
# Provider credentials remain outside PostgreSQL and application settings.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
AUTH_TELEGRAM_CLIENT_ID=
AUTH_TELEGRAM_CLIENT_SECRET=
AUTH_TELEGRAM_REDIRECT_URI=
# Optional HMAC key used to pseudonymize identifiers in Audit/rate-limit keys.
AUTH_IDENTIFIER_HMAC_KEY=
AUTH_PUBLIC_BASE_URL=http://localhost:5173
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_LOGIN_COMBINED_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_PASSWORD_RESET_LIMIT=5
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600
AUTH_ACTIVATION_RESEND_LIMIT=3
AUTH_ACTIVATION_RESEND_WINDOW_SECONDS=3600
AUTH_EXTERNAL_START_IP_LIMIT=20
AUTH_EXTERNAL_CALLBACK_LIMIT=10
AUTH_MFA_VERIFY_CHALLENGE_LIMIT=5
AUTH_MFA_VERIFY_IP_LIMIT=20
AUTH_TOTP_SETUP_CONFIRM_LIMIT=5
AUTH_MFA_RECOVERY_IDENTIFIER_LIMIT=5
AUTH_MFA_RECOVERY_IP_LIMIT=10
AUTH_MFA_RECOVERY_CONFIRM_LIMIT=5
AUTH_PROVIDER_LINK_LIMIT=10
AUTH_RECOVERY_CODE_LIMIT=5
AUTH_SECURITY_WINDOW_SECONDS=900

# Optional local MaxMind GeoLite2 City .mmdb path. No external lookup is used.
GEOIP_DATABASE_PATH=
SECURITY_AUDIT_RETENTION_DAYS=365
MAIL_MESSAGE_ID_DOMAIN=platform.local
MAIL_OUTBOX_LEASE_SECONDS=60
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_RETRY_BASE_SECONDS=30
MAIL_OUTBOX_RETRY_MAX_SECONDS=3600

# Time zone used by containers where applicable.
TZ=UTC
