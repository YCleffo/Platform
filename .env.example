# ================================================================
# PLATFORM — local development environment
# scripts/init-env.ps1 merges this template into .env and generates local secrets.
# ================================================================

# PostgreSQL 18
POSTGRES_DB=platform
POSTGRES_USER=platform_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Separate Symfony Commercial Control Plane (fill locally; never commit real values)
CONTROL_POSTGRES_DB=platform_commercial
CONTROL_POSTGRES_USER=platform_control
CONTROL_POSTGRES_PASSWORD=
CONTROL_POSTGRES_PORT=5434
CONTROL_APP_ENV=prod
CONTROL_APP_SECRET=
CONTROL_TOKEN_SECRET=
CONTROL_PRIVACY_RETENTION_DAYS={}
CONTROL_PRIVACY_PROCESSING_ROLES={}
CONTROL_PRIVACY_RESIDENCY={}
CONTROL_PRIVACY_PROVIDER_DECISIONS={}
CONTROL_PRIVACY_SECURITY_REFERENCES={}
CONTROL_PRIVACY_ERASURE_POLICY_APPROVED=false
# -1 means no approved period; 0 means approved event-triggered erasure.
CONTROL_PRIVACY_IDENTITY_RETENTION_DAYS=-1
CONTROL_PRIVACY_BILLING_CONTACT_RETENTION_DAYS=-1
CONTROL_MAILER_DSN=smtp://mailpit:1025
CONTROL_MAIL_FROM=no-reply@platform.local
CONTROL_VERIFICATION_URL=http://localhost:5173/verify-email
CONTROL_MESSAGE_ID_DOMAIN=platform.local
CONTROL_PORT=8090
PLATFORM_BASE_DOMAIN=platform.example
CONTROL_VERIFICATION_TTL_SECONDS=86400
CONTROL_ACCESS_TOKEN_TTL_SECONDS=900
CONTROL_SESSION_TTL_SECONDS=2592000
YOOKASSA_SECRET_KEY=
CONTROL_YOOKASSA_RETURN_URL=https://platform.example/payments/return
CONTROL_RENEWAL_LEAD_DAYS=7
CONTROL_RENEWAL_SETTLEMENT_GRACE_SECONDS=900
CONTROL_TEST_DB=platform_commercial_test
CONTROL_TEST_USER=platform_control_test
CONTROL_TEST_PASSWORD=

# Redis 8
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_DATABASE=0
REDIS_RATE_LIMIT_PREFIX=platform:auth

# Backend
BACKEND_PORT=8080

# Local email (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
MAIL_FROM_ADDRESS=no-reply@platform.local
MAIL_FROM_NAME=Platform
APP_DEFAULT_LOCALE=ru-RU
APP_DEFAULT_TIMEZONE=UTC

# Comma-separated IP/CIDR list. Forwarded headers are ignored when empty.
TRUSTED_PROXIES=

# Optional HMAC key for a non-authenticating device risk signal.
DEVICE_FINGERPRINT_KEY=
SESSION_TOUCH_INTERVAL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
AUTH_ACTIVATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_RECOVERY_TTL_SECONDS=1800
AUTH_TOTP_SETUP_TTL_SECONDS=600
AUTH_TOTP_ISSUER=Platform
AUTH_CHALLENGE_RETENTION_DAYS=30
AUTH_RECOVERY_CODE_RETENTION_DAYS=30
AUTH_CLEANUP_BATCH_SIZE=500
AUTH_RECENT_AUTH_SECONDS=600
# Base64-encoded 32-byte key. Required in production when TOTP is used.
AUTH_TOTP_ENCRYPTION_KEY=
# Provider credentials remain outside PostgreSQL and application settings.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
AUTH_TELEGRAM_CLIENT_ID=
AUTH_TELEGRAM_CLIENT_SECRET=
AUTH_TELEGRAM_REDIRECT_URI=
# Optional HMAC key used to pseudonymize identifiers in Audit/rate-limit keys and derive privacy-preserving WebAuthn user handles.
# Note: Rotating this key changes user handles derived for new credentials; keep consistent within a deployment.
AUTH_IDENTIFIER_HMAC_KEY=
AUTH_PUBLIC_BASE_URL=http://localhost:5173
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_LOGIN_COMBINED_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_PASSWORD_RESET_LIMIT=5
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600
AUTH_ACTIVATION_RESEND_LIMIT=3
AUTH_ACTIVATION_RESEND_WINDOW_SECONDS=3600
AUTH_EXTERNAL_START_IP_LIMIT=20
AUTH_EXTERNAL_CALLBACK_LIMIT=10
AUTH_MFA_VERIFY_CHALLENGE_LIMIT=5
AUTH_MFA_VERIFY_IP_LIMIT=20
AUTH_TOTP_SETUP_CONFIRM_LIMIT=5
AUTH_MFA_RECOVERY_IDENTIFIER_LIMIT=5
AUTH_MFA_RECOVERY_IP_LIMIT=10
AUTH_MFA_RECOVERY_CONFIRM_LIMIT=5
AUTH_MFA_RECOVERY_EXTERNAL_START_IP_LIMIT=10
AUTH_MFA_RECOVERY_EXTERNAL_TRANSACTION_LIMIT=3
AUTH_MFA_RECOVERY_EXTERNAL_CALLBACK_LIMIT=5
AUTH_PROVIDER_LINK_LIMIT=10
AUTH_RECOVERY_CODE_LIMIT=5
AUTH_SECURITY_WINDOW_SECONDS=900

# WebAuthn / Passkeys (Level 3)
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_NAME=Platform
# Comma-separated list of allowed origins. In production, HTTPS origins are strictly required.
AUTH_WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:8080
AUTH_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
AUTH_PASSKEY_AUTH_START_LIMIT=20
AUTH_PASSKEY_AUTH_COMPLETE_LIMIT=10
AUTH_PASSKEY_REGISTER_COMPLETE_LIMIT=10

# Optional local MaxMind GeoLite2 City .mmdb path. No external lookup is used.
GEOIP_DATABASE_PATH=
SECURITY_AUDIT_RETENTION_DAYS=365
# Core privacy policy: empty means retain or technical readiness FAIL.
PRIVACY_OUTBOX_RETENTION_DAYS=
PRIVACY_INBOX_RETENTION_DAYS=
PRIVACY_DSAR_RETENTION_DAYS=
PRIVACY_BLOCK_RETENTION_DAYS=
PRIVACY_HOLD_RETENTION_DAYS=
PRIVACY_DECISION_RETENTION_DAYS=
PRIVACY_SESSION_RETENTION_DAYS=
PRIVACY_PRIMARY_DB_COUNTRY=
PRIVACY_BACKUP_COUNTRY=
PRIVACY_OBJECT_STORAGE_COUNTRY=
PRIVACY_LOG_STORAGE_COUNTRY=
PRIVACY_CACHE_COUNTRY=
PRIVACY_RESIDENCY_VERIFIED_AT=
PRIVACY_RESIDENCY_VERIFICATION_REFERENCE=
PRIVACY_THREAT_MODEL_REFERENCE=
PRIVACY_HARM_ASSESSMENT_REFERENCE=
PRIVACY_ISPDN_PROTECTION_LEVEL=
PRIVACY_RESPONSIBLE_PERSON_REFERENCE=
PRIVACY_SECURITY_APPROVAL_REFERENCE=
MAIL_MESSAGE_ID_DOMAIN=platform.local
MAIL_OUTBOX_LEASE_SECONDS=60
MAIL_OUTBOX_MAX_ATTEMPTS=5
MAIL_OUTBOX_RETRY_BASE_SECONDS=30
MAIL_OUTBOX_RETRY_MAX_SECONDS=3600

# Time zone used by containers where applicable.
TZ=UTC

# Background jobs. Destructive privacy jobs require explicit enablement and policy.
CORE_SCHEDULER_ENABLED=true
CORE_AUTH_CLEANUP_ENABLED=true
CORE_AUTH_CLEANUP_INTERVAL_SECONDS=3600
CORE_AUTH_CLEANUP_BATCH_LIMIT=500
CORE_PRIVACY_RETENTION_ENABLED=true
CORE_PRIVACY_RETENTION_INTERVAL_SECONDS=3600
CORE_PRIVACY_RETENTION_BATCH_LIMIT=100
CORE_PRIVACY_ERASURE_ENABLED=false
CORE_PRIVACY_ERASURE_INTERVAL_SECONDS=300
CORE_PRIVACY_ERASURE_BATCH_LIMIT=10
CORE_PRIVACY_ERASURE_ITEM_LIMIT=25
PRIVACY_AUTOMATION_ACCOUNT_ID=
CORE_PRIVACY_CLEANUP_ENABLED=false
CORE_PRIVACY_CLEANUP_INTERVAL_SECONDS=3600
CORE_PRIVACY_CLEANUP_BATCH_LIMIT=100
CORE_ENTITLEMENT_SYNC_ENABLED=true
CORE_ENTITLEMENT_SYNC_INTERVAL_SECONDS=300
CONTROL_SCHEDULER_ENABLED=true
CONTROL_RENEWALS_ENABLED=true
CONTROL_RENEWALS_INTERVAL_SECONDS=300
CONTROL_SUBSCRIPTIONS_ENABLED=true
CONTROL_SUBSCRIPTIONS_INTERVAL_SECONDS=300
CONTROL_EXPIRATION_ENABLED=true
CONTROL_EXPIRATION_INTERVAL_SECONDS=300
CONTROL_SUBSCRIPTION_BATCH_LIMIT=100
CONTROL_PAYMENT_RECONCILIATION_ENABLED=true
CONTROL_PAYMENT_RECONCILIATION_INTERVAL_SECONDS=120
CONTROL_REFUND_RECONCILIATION_ENABLED=true
CONTROL_REFUND_RECONCILIATION_INTERVAL_SECONDS=120
CONTROL_RECEIPT_RECONCILIATION_ENABLED=true
CONTROL_RECEIPT_RECONCILIATION_INTERVAL_SECONDS=120
CONTROL_RECONCILIATION_BATCH_LIMIT=100
CONTROL_PRIVACY_CLEANUP_ENABLED=false
CONTROL_PRIVACY_CLEANUP_INTERVAL_SECONDS=3600
CONTROL_PRIVACY_CLEANUP_BATCH_LIMIT=100

# Runtime activation and deployment credential lifecycle.
PLATFORM_INSTALLATION_ID=
PLATFORM_DEPLOYMENT_MODE=
APPLICATION_VERSION=
PLATFORM_RELEASE_ID=
PLATFORM_RELEASE_CHANNEL=
CONTROL_PLANE_URL=
CONTROL_PLANE_DEPLOYMENT_CREDENTIAL_REF=env:CONTROL_PLANE_DEPLOYMENT_CREDENTIAL
CONTROL_PLANE_DEPLOYMENT_CREDENTIAL=
CONTROL_DEPLOYMENT_CREDENTIAL_TTL_DAYS=30

# Local process heartbeat freshness (heartbeat cadence is 10 seconds or less).
CORE_SCHEDULER_HEALTH_TIMEOUT_SECONDS=120
CORE_EMAIL_WORKER_HEALTH_TIMEOUT_SECONDS=120
CONTROL_SCHEDULER_HEALTH_TIMEOUT_SECONDS=120
CONTROL_OUTBOX_WORKER_HEALTH_TIMEOUT_SECONDS=120
CORE_EMAIL_WORKER_ENABLED=true
CONTROL_OUTBOX_WORKER_ENABLED=true

# Dedicated Core + Control PostgreSQL backup worker (opt in).
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_SUCCESSFUL_SETS=3
BACKUP_HEALTH_TIMEOUT_SECONDS=172800

# Compose/runtime defaults also belong to the environment contract.
BACKEND_APP_ENV=dev
BACKEND_APP_DEBUG=true
BACKEND_TEST_PORT=8081
POSTGRES_TEST_DB=platform_test
POSTGRES_TEST_PORT=5433
REDIS_TEST_PORT=6380
CONTROL_ENTITLEMENT_SECRET_FILES={}
CONTROL_PRIVACY_OPERATOR_NOTIFICATION={}
RUNTIME_ENTITLEMENT_TRUSTED_KEYS={}
